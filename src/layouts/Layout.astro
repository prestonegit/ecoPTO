---
import { ViewTransitions } from 'astro:transitions';
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const globalSettings = await getEntry('settings', 'global');
import GetInvolvedModal from '../components/GetInvolvedModal.astro';
import PetitionFloatingDock from '../components/PetitionFloatingDock.astro';
import '../styles/global.css';
import '../styles/animations.css';

const { title } = Astro.props;
const themeClass = globalSettings.data.theme; // Force rebuild
---
<!doctype html>
<html lang="en" class={themeClass}>
<head>
	<meta charset="UTF-8" />
	<meta name="description" content="Hopewell Valley PTO Website" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
	<title>{title} | {globalSettings.data.site_name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">

	<ViewTransitions />

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', sans-serif;
            --font-serif: 'Playfair Display', serif;
        }

        .theme-district-maroon {
            --primary: #8C1D40;
            --secondary: #C89D4B;
            --accent: #002366;
            --text-primary: #333333;
            --text-secondary: #555555;
            --bg-primary: #FFFFFF;
            --bg-secondary: #F5F5F5;
        }

        .theme-summer {
            --primary: #FFD700;
            --secondary: #40E0D0;
            --accent: #FF7F50;
            --text-primary: #002D40;
            --text-secondary: #5B7A87;
            --bg-primary: #FAF8F0;
            --bg-secondary: #E0F7FA;
        }

                .theme-fall {
            --primary: #D2691E;
            --secondary: #8B4513;
            --accent: #DAA520;
            --text-primary: #4A4A4A;
            --text-secondary: #7A7A7A;
            --bg-primary: #FFF8E1;
            --bg-secondary: #EFEBE9;
        }

        .theme-winter-spring {
            --primary: #4682B4;
            --secondary: #90EE90;
            --accent: #D3D3D3;
            --text-primary: #363636;
            --text-secondary: #666666;
            --bg-primary: #F5F5F5;
            --bg-secondary: #E6F0F3;
        }

        .theme-ecopto {
            --primary: #B05B3B; /* Terracotta Brown */
            --secondary: #FFC099; /* Soft Peach */
            --accent: #FF5050; /* Soft Red */
            --text-primary: #333333; /* Dark Charcoal */
            --text-secondary: #555555; /* Default from theme-district-maroon */
            --bg-primary: #FFFFFF; /* Off-White */
            --bg-secondary: #F5F5F5; /* Default from theme-district-maroon */
        }

        /* High-contrast text rules: ensure secondary text never renders as low-contrast peach (#FFC099) on light backgrounds */
        .theme-ecopto .text-secondary {
            color: #8C3B1A;
        }

        .theme-ecopto a.text-secondary:hover,
        .theme-ecopto .hover\:text-secondary:hover {
            color: #6E2B0F;
        }

        .theme-ecopto .bg-primary .text-secondary,
        .theme-ecopto [class*="bg-primary"] .text-secondary {
            color: #FFFFFF;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: var(--font-sans);
        }

        h1, h2, blockquote {
            font-family: var(--font-serif);
        }

        h3, h4, h5, h6 {
            font-family: var(--font-sans);
        }

        h1, h2, h3, h4, h5, h6 {
            color: var(--primary);
        }

        a {
            color: var(--primary);
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        input[type="checkbox"] {
          accent-color: var(--primary);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">
	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-md focus:shadow-lg focus:ring-2 focus:ring-primary">
		Skip to main content
	</a>
	<div data-netlify-identity-menu hidden></div>
	<Header />
	<main id="main-content" tabindex="-1" class="flex-grow">
		<slot />
	</main>
	<Footer />
	<GetInvolvedModal />
	<PetitionFloatingDock />

	<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
	<script is:inline>
		window.netlifyIdentity.on("init", user => {
			// Handle invite tokens
			const match = window.location.hash.match(/invite_token=([^&]+)/);
			if (match) {
				window.netlifyIdentity.open('signup', { token: match[1] });
			}

			if (!user) {
				window.netlifyIdentity.on("login", () => {
					document.location.href = "/admin/";
				});
			}
		});
	</script>
	<script is:inline>
		document.addEventListener('astro:page-load', () => {
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

			document.querySelectorAll('.animate-on-scroll').forEach((el) => {
				observer.observe(el);
			});
		});
	</script>
</body>
</html>