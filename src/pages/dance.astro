---
// Standalone, motion-heavy landing page for the ecoPTO Dance Nite (Fri 10/23/2026).
// Deliberately skips the site Layout: no header/footer, its own palette and fonts.
const TICKETS = 'https://www.zeffy.com/en-US/ticketing/autumn-dance-party';
const PAGE_URL = 'https://ecopto.org/dance';
const OG_IMAGE = 'https://ecopto.org/assets/images/dance-nite-og.jpg';
const MAPS = 'https://www.google.com/maps/search/?api=1&query=Hopewell+Train+Station%2C+Hopewell%2C+NJ';
const GCAL =
  'https://calendar.google.com/calendar/render?action=TEMPLATE' +
  '&text=' + encodeURIComponent('ecoPTO Dance Nite') +
  '&dates=20261023T230000Z/20261024T020000Z' +
  '&location=' + encodeURIComponent('Hopewell Train Station, Hopewell, NJ') +
  '&details=' + encodeURIComponent(`Doors 7pm, DJ Gabe 8pm. Adults 21+. Tickets: ${TICKETS}`);

const marquee = ['FRI 10/23', 'DOORS 7PM', 'DJ GABE 8PM', 'HOPEWELL TRAIN STATION', 'ADULTS 21+', '$20', 'SNACKS & SIPS', 'PUZZLE LOUNGE'];
const star = 'M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DANCE NITE · Fri 10/23 · ecoPTO</title>
  <meta name="description" content="ecoPTO Dance Nite with HV's own DJ Gabe. Fri 10/23 at Hopewell Train Station. Doors 7pm, DJ 8pm. Adults 21+. $20, tickets limited." />
  <link rel="canonical" href={PAGE_URL} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={PAGE_URL} />
  <meta property="og:title" content="DANCE NITE · Fri 10/23 · Hopewell Train Station" />
  <meta property="og:description" content="With HV's own DJ Gabe. Doors 7, DJ 8. Adults 21+. $20 — tickets limited, call yer friends." />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="DANCE NITE with HV's own DJ Gabe. Fri 10/23, Hopewell Train Station, doors 7, DJ 8, 21+, $20." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#ff5f6d" />
  <link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Archivo+Black&family=Permanent+Marker&family=Rubik+Mono+One&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <!-- cursor star (fine pointers only) -->
  <svg class="cursor-star" viewBox="0 0 100 100" aria-hidden="true"><path d={star} /></svg>

  <main>
    <!-- ───────────── 1. THE DROP ───────────── -->
    <section class="hero" aria-label="Dance Nite">
      <div class="bands" aria-hidden="true">
        <div class="band b-coral" data-speed="-0.15"></div>
        <div class="band b-teal" data-speed="0.1"></div>
        <div class="band b-violet" data-speed="-0.25"></div>
        <div class="band b-pink" data-speed="0.2"></div>
        <div class="band b-yellow" data-speed="-0.1"></div>
        <div class="band b-pale" data-speed="0.3"></div>
        <div class="band b-lime" data-speed="-0.2"></div>
      </div>

      <div class="trash" aria-hidden="true">
        <svg class="bit" style="--x:8%;--y:18%" viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="#ff5f6d" stroke="#111" stroke-width="3"/><circle cx="20" cy="20" r="9" fill="none" stroke="#111" stroke-width="2" stroke-dasharray="3 3"/></svg>
        <svg class="bit" style="--x:86%;--y:12%" viewBox="0 0 60 20"><path d="M2 10h40l14-8" fill="none" stroke="#3fe0b0" stroke-width="6" stroke-linecap="round"/><path d="M2 10h40l14-8" fill="none" stroke="#111" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round"/></svg>
        <svg class="bit" style="--x:78%;--y:72%" viewBox="0 0 50 30"><path d="M3 20c8-18 14 12 22-4s14 10 22-6" fill="none" stroke="#f5be4b" stroke-width="6" stroke-linecap="round"/></svg>
        <svg class="bit" style="--x:14%;--y:78%" viewBox="0 0 40 40"><path d="M5 34 20 4l15 30z" fill="#b7e35a" stroke="#111" stroke-width="3" stroke-linejoin="round"/></svg>
        <svg class="bit" style="--x:52%;--y:88%" viewBox="0 0 40 40"><rect x="6" y="6" width="28" height="28" rx="4" fill="#6e6af4" stroke="#111" stroke-width="3" transform="rotate(18 20 20)"/></svg>
        <svg class="bit" style="--x:92%;--y:44%" viewBox="0 0 40 40"><circle cx="20" cy="20" r="14" fill="#f35fc0" stroke="#111" stroke-width="3"/><path d="M13 20h14M20 13v14" stroke="#111" stroke-width="3"/></svg>
      </div>

      <svg class="spark spark-a" viewBox="0 0 100 100" aria-hidden="true"><path d={star} /></svg>
      <svg class="spark spark-b" viewBox="0 0 100 100" aria-hidden="true"><path d={star} /></svg>
      <svg class="spark spark-c" viewBox="0 0 100 100" aria-hidden="true"><path d={star} /></svg>

      <div class="hero-inner intro-hide">
        <p class="tag"><span>HVRSD</span> ecoPTO</p>
        <h1 class="title beat">
          <span class="word">DANCE</span>
          <span class="word">NITE</span>
        </h1>
        <p class="script">with HV's own DJ Gabe!</p>
        <ul class="chips">
          <li class="chip c-black">FRI 10/23</li>
          <li class="chip c-pale">doors 7 · DJ 8</li>
          <li class="chip c-yellow">adults 21+</li>
        </ul>
      </div>

      <a class="scroll-cue" href="#when">scroll it <span>↓</span></a>
    </section>

    <!-- ───────────── marquee ───────────── -->
    <div class="marquees" aria-hidden="true">
      <div class="marquee m-black"><div class="m-track">
        {[0, 1].map(() => <span class="m-set">{marquee.map((t) => <span>{t}<svg viewBox="0 0 100 100"><path d={star} /></svg></span>)}</span>)}
      </div></div>
      <div class="marquee m-lime"><div class="m-track">
        {[0, 1].map(() => <span class="m-set">{[...marquee].reverse().map((t) => <span>{t}<svg viewBox="0 0 100 100"><path d={star} /></svg></span>)}</span>)}
      </div></div>
    </div>

    <!-- ───────────── 2. WHEN + WHERE (horizontal) ───────────── -->
    <section id="when" class="when" aria-label="When and where">
      <div class="h-track">
        <article class="panel p-violet">
          <div class="panel-inner">
            <p class="kicker">when</p>
            <p class="fri">FRI</p>
            <svg class="date-svg" viewBox="0 0 620 230" role="img" aria-label="10/23">
              <text x="10" y="195">10/23</text>
            </svg>
            <p class="small">Friday, October 23, 2026</p>
          </div>
        </article>

        <article class="panel p-pale">
          <div class="panel-inner clock-wrap">
            <svg class="clock" viewBox="0 0 200 200" aria-hidden="true">
              <circle cx="100" cy="100" r="92" fill="#fff" stroke="#111" stroke-width="8"/>
              {Array.from({ length: 12 }, (_, i) => (
                <line x1="100" y1="16" x2="100" y2={i % 3 === 0 ? 34 : 26} stroke="#111" stroke-width={i % 3 === 0 ? 7 : 4} stroke-linecap="round" transform={`rotate(${i * 30} 100 100)`} />
              ))}
              <line class="hand-h" x1="100" y1="100" x2="100" y2="52" stroke="#111" stroke-width="10" stroke-linecap="round"/>
              <line class="hand-m" x1="100" y1="100" x2="100" y2="30" stroke="#ff5f6d" stroke-width="6" stroke-linecap="round"/>
              <circle cx="100" cy="100" r="8" fill="#111"/>
            </svg>
            <ol class="times">
              <li data-t="0"><b>7PM</b> doors open</li>
              <li data-t="1"><b>8PM</b> DJ Gabe drops in</li>
              <li data-t="2"><b>10PM</b> last dance</li>
            </ol>
          </div>
        </article>

        <article class="panel p-teal">
          <div class="panel-inner">
            <p class="kicker">where</p>
            <div class="sign"><span>HOPEWELL</span><small>train station</small></div>
            <div class="rail" aria-hidden="true">
              <svg class="train" viewBox="0 0 420 110">
                <g stroke="#111" stroke-width="5" stroke-linejoin="round">
                  <rect x="4" y="14" width="120" height="72" rx="12" fill="#ff5f6d"/>
                  <rect x="18" y="28" width="34" height="26" rx="4" fill="#fbeff4"/>
                  <rect x="64" y="28" width="46" height="26" rx="4" fill="#fbeff4"/>
                  <rect x="140" y="14" width="130" height="72" rx="8" fill="#f5be4b"/>
                  <rect x="154" y="28" width="30" height="26" rx="4" fill="#fbeff4"/>
                  <rect x="192" y="28" width="30" height="26" rx="4" fill="#fbeff4"/>
                  <rect x="230" y="28" width="30" height="26" rx="4" fill="#fbeff4"/>
                  <rect x="286" y="14" width="130" height="72" rx="8" fill="#6e6af4"/>
                  <rect x="300" y="28" width="30" height="26" rx="4" fill="#fbeff4"/>
                  <rect x="338" y="28" width="30" height="26" rx="4" fill="#fbeff4"/>
                  <rect x="376" y="28" width="30" height="26" rx="4" fill="#fbeff4"/>
                  <g fill="#111"><circle class="wheel" cx="34" cy="92" r="12"/><circle class="wheel" cx="94" cy="92" r="12"/><circle class="wheel" cx="172" cy="92" r="12"/><circle class="wheel" cx="238" cy="92" r="12"/><circle class="wheel" cx="318" cy="92" r="12"/><circle class="wheel" cx="384" cy="92" r="12"/></g>
                </g>
              </svg>
            </div>
            <a class="btn btn-black" href={MAPS} target="_blank" rel="noopener">get directions ↗</a>
          </div>
        </article>

        <article class="panel p-yellow">
          <div class="panel-inner">
            <div class="stamp">ADULTS<br/>21+</div>
            <p class="small">a grown-up night out.<br/>book the sitter now.</p>
            <div class="btn-row">
              <a class="btn btn-black" href={GCAL} target="_blank" rel="noopener">+ google cal</a>
              <a class="btn btn-outline" href="/assets/dance-nite.ics" download>+ apple / outlook</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ───────────── 3. DJ GABE ───────────── -->
    <section class="dj" aria-label="DJ Gabe">
      <div class="dj-inner">
        <div class="dj-copy">
          <p class="kicker">on the decks</p>
          <h2 class="dj-name">DJ<br/>GABE</h2>
          <p class="script dj-script">HV's very own.</p>
          <p class="small">spinning from 8pm. grab the record to scratch it, fling it to warp the beat.</p>
          <button class="btn btn-big beat-toggle" type="button" aria-pressed="false">
            <span class="bt-icon" aria-hidden="true">▶</span><span class="bt-label">drop the beat</span>
          </button>
          <p class="fine">plays a little beat made right in your browser. sound on!</p>
        </div>

        <div class="deck" aria-hidden="true">
          <svg class="turntable" viewBox="0 0 400 340">
            <rect x="6" y="6" width="388" height="328" rx="26" fill="#111"/>
            <rect x="18" y="18" width="364" height="304" rx="18" fill="#f35fc0" stroke="#111" stroke-width="4"/>
            <g class="record">
              <circle cx="170" cy="170" r="140" fill="#111"/>
              {[128, 116, 104, 92, 80, 68].map((r) => <circle cx="170" cy="170" r={r} fill="none" stroke="#2a2a2a" stroke-width="3"/>)}
              <path d="M170 34a136 136 0 0 1 118 68" fill="none" stroke="#555" stroke-width="6" stroke-linecap="round" opacity=".6"/>
              <circle cx="170" cy="170" r="50" fill="#b7e35a"/>
              <path d="M170 120a50 50 0 0 1 50 50h-50z" fill="#f5be4b"/>
              <text x="170" y="164" text-anchor="middle" class="rec-t1">DJ GABE</text>
              <text x="170" y="186" text-anchor="middle" class="rec-t2">HV · 10/23</text>
              <circle cx="170" cy="170" r="6" fill="#111"/>
            </g>
            <g class="arm">
              <circle cx="340" cy="60" r="20" fill="#fbeff4" stroke="#111" stroke-width="4"/>
              <path d="M340 60 L330 210 L296 250" fill="none" stroke="#fbeff4" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M340 60 L330 210 L296 250" fill="none" stroke="#111" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="280" y="240" width="30" height="22" rx="4" fill="#3fe0b0" stroke="#111" stroke-width="4" transform="rotate(-40 295 251)"/>
            </g>
            <g class="knobs">
              <circle cx="356" cy="290" r="12" fill="#f5be4b" stroke="#111" stroke-width="4"/>
              <circle cx="320" cy="290" r="12" fill="#3fe0b0" stroke="#111" stroke-width="4"/>
            </g>
          </svg>
          <div class="eq">{Array.from({ length: 14 }, () => <span></span>)}</div>
        </div>
      </div>
    </section>

    <!-- ───────────── 4. TRASHION ───────────── -->
    <section class="trashion" aria-label="Trashion">
      <div class="tr-inner">
        <div class="tr-copy">
          <p class="kicker">award alert</p>
          <h2 class="tr-title">“TRASH-<span>ION”</span></h2>
          <p class="tr-line">yesterday's trash <span class="arrow">→</span> tonight's look.</p>
          <p class="small">awards for the best upcycled outfits &amp; accessories. start saving yer bottle caps.</p>
        </div>

        <svg class="model" viewBox="0 0 300 540" role="img" aria-label="An outfit made from bottle caps, straws, cans and chip bags">
          <g stroke="#111" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
            <!-- legs: straws -->
            <g class="piece"><path d="M128 368 L120 488" stroke="#3fe0b0" stroke-width="16"/><path d="M128 368 L120 488" stroke-dasharray="6 8"/></g>
            <g class="piece"><path d="M172 368 L182 488" stroke="#f35fc0" stroke-width="16"/><path d="M172 368 L182 488" stroke-dasharray="6 8"/></g>
            <!-- shoes: lids -->
            <g class="piece"><path d="M92 500 q28 -26 44 -8 l0 14 h-44z" fill="#f5be4b"/></g>
            <g class="piece"><path d="M168 506 v-14 q16 -18 44 8 v6z" fill="#6e6af4"/></g>
            <!-- arms: bendy straws -->
            <g class="piece"><path d="M104 196 L66 262 L84 330" fill="none" stroke="#b7e35a" stroke-width="14"/><path d="M104 196 L66 262 L84 330" fill="none" stroke-dasharray="4 7"/></g>
            <g class="piece"><path d="M196 196 L240 150 L262 88" fill="none" stroke="#f5be4b" stroke-width="14"/><path d="M196 196 L240 150 L262 88" fill="none" stroke-dasharray="4 7"/></g>
            <!-- hands: caps -->
            <g class="piece"><circle cx="86" cy="338" r="13" fill="#ff5f6d"/></g>
            <g class="piece"><circle cx="264" cy="78" r="13" fill="#3fe0b0"/></g>
            <!-- torso: crushed can -->
            <g class="piece"><path d="M104 176 L196 176 L204 208 L188 238 L198 270 L102 270 L112 238 L96 208 Z" fill="#6e6af4"/><path d="M118 196 h64 M114 250 h72" stroke="#fbeff4" stroke-width="5"/><ellipse cx="150" cy="222" rx="14" ry="9" fill="#fbeff4"/></g>
            <!-- belt: bottle caps -->
            <g class="piece">{[108, 128, 148, 168, 188].map((x, i) => <circle cx={x + 2} cy="278" r="10" fill={['#ff5f6d', '#f5be4b', '#3fe0b0', '#f35fc0', '#b7e35a'][i]}/>)}</g>
            <!-- skirt: chip bags -->
            <g class="piece"><path d="M102 290 L150 290 L126 380 L72 372 Z" fill="#f35fc0"/><path d="M92 330 l30 4 M86 352 l28 4" stroke-dasharray="3 5"/></g>
            <g class="piece"><path d="M150 290 L198 290 L228 372 L174 380 Z" fill="#f5be4b"/><path d="M180 330 l30 -4 M186 352 l28 -4" stroke-dasharray="3 5"/></g>
            <g class="piece"><path d="M126 290 L174 290 L170 386 L130 386 Z" fill="#3fe0b0"/></g>
            <!-- neck + necklace of pull tabs -->
            <g class="piece"><path d="M150 132 L150 176" stroke="#fbeff4" stroke-width="16"/></g>
            <g class="piece">{[118, 134, 150, 166, 182].map((x, i) => <rect x={x - 6} y={170 + Math.abs(i - 2) * -5 + 8} width="12" height="16" rx="6" fill="#fbeff4"/>)}</g>
            <!-- head: big bottle cap -->
            <g class="piece"><circle cx="150" cy="96" r="42" fill="#ff5f6d"/><circle cx="150" cy="96" r="42" fill="none" stroke-dasharray="4 6" stroke-width="7"/><circle cx="136" cy="92" r="4" fill="#111"/><circle cx="164" cy="92" r="4" fill="#111"/><path d="M136 112 q14 12 28 0" fill="none"/></g>
            <!-- hair: squiggle ribbons -->
            <g class="piece"><path d="M112 70 q-18 -30 6 -44 q10 20 26 -6 q12 22 28 -2 q14 18 30 4 q18 22 -8 44" fill="none" stroke="#b7e35a" stroke-width="10"/></g>
            <!-- shades: six-pack ring -->
            <g class="piece"><rect x="120" y="82" width="26" height="18" rx="9" fill="#111"/><rect x="154" y="82" width="26" height="18" rx="9" fill="#111"/><path d="M146 90 h8"/></g>
          </g>
          <g class="sparkles" fill="#111">
            <path transform="translate(20 40) scale(.4)" d={star}/>
            <path transform="translate(236 230) scale(.3)" d={star}/>
            <path transform="translate(30 420) scale(.34)" d={star}/>
          </g>
        </svg>
      </div>
      <div class="runway" aria-hidden="true"></div>
    </section>

    <!-- ───────────── 5. PUZZLE LOUNGE ───────────── -->
    <section class="lounge" aria-label="Chat and chill puzzle lounge">
      <div class="lounge-inner">
        <p class="kicker">not a dancer? no problem.</p>
        <h2 class="lounge-title">the chat &amp; chill<br/>puzzle lounge</h2>
        <p class="small">pull up a chair, find the edge pieces, meet yer neighbors.</p>

        <button class="chill-toggle" type="button" aria-pressed="false">
          <span class="ct-track"><span class="ct-knob"></span></span>
          <span class="ct-label">chill mode</span>
        </button>

        <div class="table">
          <div class="board" aria-label="Puzzle board: drag the pieces into place">
            {Array.from({ length: 6 }, (_, i) => (
              <div class="pz" data-i={i} style={`--c:${i % 3};--r:${Math.floor(i / 3)}`} role="img" aria-label={`puzzle piece ${i + 1}`}>
                <div class="pz-art" aria-hidden="true">
                  <div class="pa-band pa1"></div><div class="pa-band pa2"></div><div class="pa-band pa3"></div><div class="pa-band pa4"></div>
                  <span class="pa-text">CHAT &amp;<br/>CHILL</span>
                  <svg class="pa-star" viewBox="0 0 100 100"><path d={star}/></svg>
                </div>
              </div>
            ))}
            <div class="solved" aria-live="polite">
              <p>solved! ✦</p>
              <a class="btn btn-black" href="#tix">you'd fit right in → tickets</a>
            </div>
          </div>
        </div>
        <button class="btn btn-outline shuffle" type="button">shuffle the pieces</button>
      </div>
    </section>

    <!-- ───────────── 6. TICKETS ───────────── -->
    <section id="tix" class="tix" aria-label="Tickets">
      <div class="tix-bands" aria-hidden="true">
        <div class="tb tb-coral"></div><div class="tb tb-violet"></div><div class="tb tb-lime"></div>
      </div>

      <div class="tix-inner">
        <p class="price" aria-label="Twenty dollars"><span class="price-inner">$20</span></p>
        <p class="limited">tickets limited.<br/><em>call yer friends now.</em></p>

        <div class="btn-row center">
          <a class="btn btn-big magnetic" href={TICKETS} target="_blank" rel="noopener"><span>GET TICKETS</span></a>
          <button class="btn btn-outline share" type="button">share the nite ↗</button>
        </div>

        <div class="awards">
          <h2>awards for remarkable…</h2>
          <ul>
            <li class="sticker s-pink">blast-from-the-past outfits</li>
            <li class="sticker s-teal">snazziest overalls</li>
            <li class="sticker s-lime">“trashion” wear</li>
          </ul>
          <p class="aside">plus snacks &amp; sips, and a chat-and-chill puzzle lounge.</p>
        </div>

        <p class="help">want to help? give yer time, or donate goods for the pantry: <a href="mailto:ecoPTOhvrsd@gmail.com">ecoPTOhvrsd@gmail.com</a></p>
      </div>
    </section>

    <footer class="foot">
      <a href="/">← HVRSD ecoPTO</a>
      <span>Hopewell Valley · 10.23.26</span>
    </footer>
  </main>

  <div class="toast" role="status" aria-live="polite"></div>
</body>
</html>

<style is:global>
  :root {
    --coral: #ff5f6d;
    --teal: #3fe0b0;
    --violet: #6e6af4;
    --pink: #f35fc0;
    --yellow: #f5be4b;
    --lime: #b7e35a;
    --pale: #fbeff4;
    --ink: #111;
    --display: 'Rubik Mono One', 'Archivo Black', sans-serif;
    --heavy: 'Archivo Black', 'Archivo', sans-serif;
    --hand: 'Permanent Marker', cursive;
    --body: 'Archivo', system-ui, sans-serif;
  }
  html { background: var(--coral); overflow-x: clip; }
  body { margin: 0; background: var(--coral); color: var(--ink); font-family: var(--body); overflow-x: clip; -webkit-font-smoothing: antialiased; }
  ::selection { background: var(--ink); color: var(--lime); }
  a { color: inherit; }
  html.js .intro-hide { visibility: hidden; }
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }

  /* ── cursor ── */
  .cursor-star { position: fixed; left: 0; top: 0; width: 28px; height: 28px; pointer-events: none; z-index: 100; fill: var(--ink); opacity: 0; translate: -50% -50%; }
  @media (pointer: fine) { .cursor-star { opacity: 1; } }
  .burst { position: fixed; width: 22px; height: 22px; pointer-events: none; z-index: 99; translate: -50% -50%; }

  /* ── hero ── */
  .hero { position: relative; min-height: 100svh; overflow: hidden; display: grid; place-items: center; padding: 16px 16px 96px; box-sizing: border-box; }
  .bands { position: absolute; inset: -10% -30%; }
  .band { position: absolute; left: 0; right: 0; height: 17%; rotate: -5deg; }
  .b-coral { top: 0; background: var(--coral); }
  .b-teal { top: 16%; background: var(--teal); height: 26%; }
  .b-violet { top: 40%; background: var(--violet); }
  .b-pink { top: 55%; background: var(--pink); rotate: -3deg; }
  .b-yellow { top: 68%; background: var(--yellow); rotate: -7deg; height: 12%; }
