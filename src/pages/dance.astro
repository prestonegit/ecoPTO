<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import { Draggable } from 'gsap/Draggable';
  import { InertiaPlugin } from 'gsap/InertiaPlugin';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger, SplitText, Draggable, InertiaPlugin);

  const COLORS = ['#ff5f6d', '#3fe0b0', '#6e6af4', '#f35fc0', '#f5be4b', '#b7e35a', '#111'];
  const BEAT = 0.5; // 120 BPM
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const $$ = (s: string) => gsap.utils.toArray<HTMLElement>(s);
  const STAR = $('.cursor-star path').getAttribute('d');
  const motionOK = () => matchMedia('(prefers-reduced-motion: no-preference)').matches;

  // ── toast + share (work regardless of motion prefs) ──
  const toast = $('.toast');
  let toastTimer = 0;
  const say = (msg: string) => {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('show'), 2400);
  };
  $('.share').addEventListener('click', async () => {
    const data = { title: 'DANCE NITE · Fri 10/23', text: "ecoPTO Dance Nite w/ DJ Gabe. Hopewell Train Station, doors 7. Tickets limited!", url: location.origin + '/dance' };
    if (navigator.share) {
      try { await navigator.share(data); } catch { /* dismissed */ }
    } else {
      try { await navigator.clipboard.writeText(data.url); say('link copied — go tell yer friends'); }
      catch { say(data.url); }
    }
  });

  const starBurst = (x: number, y: number, n = 9, spread = 150) => {
    if (!motionOK()) return;
    for (let i = 0; i < n; i++) {
      const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      s.setAttribute('viewBox', '0 0 100 100');
      s.classList.add('burst');
      s.innerHTML = `<path d="${STAR}" fill="${gsap.utils.random(COLORS)}" stroke="#111" stroke-width="4"/>`;
      document.body.appendChild(s);
      const a = (i / n) * Math.PI * 2 + Math.random() * 0.4;
      const d = gsap.utils.random(spread * 0.4, spread);
      gsap.fromTo(s, { x, y, scale: 0.2, rotate: 0 }, {
        x: x + Math.cos(a) * d, y: y + Math.sin(a) * d, scale: gsap.utils.random(0.8, 1.6), rotate: gsap.utils.random(-270, 270),
        opacity: 0, duration: gsap.utils.random(0.7, 1.1), ease: 'power3.out', onComplete: () => s.remove(),
      });
    }
  };

  // ── the beat: an 8-bar loop synthesized with WebAudio (no audio files) ──
  // It's rendered once into a buffer, then played by a tiny "deck" worklet whose speed can be anything,
  // including backwards — so grabbing the record scrubs the actual music, like vinyl.
  const beat = (() => {
    const STEP = 60 / 120 / 4; // 16th note at 120 BPM
    const LOOP = 16 * 8; // steps
    const LOOP_SEC = LOOP * STEP;
    const TAIL = 1.5; // seconds of ring-out folded back onto the start so the loop is seamless
    const ROOTS = [55, 43.65, 65.41, 49, 55, 43.65, 65.41, 41.2]; // Am F C G | Am F C E
    const CHORDS = [
      [220, 261.63, 329.63], [174.61, 220, 261.63], [196, 261.63, 329.63], [196, 246.94, 293.66],
      [220, 261.63, 329.63], [174.61, 220, 261.63], [196, 261.63, 329.63], [164.81, 207.65, 246.94],
    ];
    const GROOVE = [1, 0, 0, 2, 0, 0, 1, 0, 1, 0, 0, 1.5, 0, 0, 2, 0]; // bass: multiples of the bar's root
    const WALK = [1, 0, 1, 0, 2, 0, 1, 0, 1.5, 0, 1.5, 0, 2, 0, 2, 1.5]; // busier bass going into bars 4 and 8

    // bars 1-4 groove, bars 5-8 add chord stabs + 16th hats, bar 8 ends in a snare roll
    const render = async (sampleRate: number) => {
      const c = new OfflineAudioContext(1, Math.ceil((LOOP_SEC + TAIL) * sampleRate), sampleRate);
      const bus = c.createGain();
      bus.gain.value = 0.9;
      bus.connect(c.destination);
      const noise = c.createBuffer(1, sampleRate, sampleRate);
      const nd = noise.getChannelData(0);
      for (let i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1;
      const env = (t: number, peak: number, decay: number) => {
        const g = c.createGain();
        g.gain.setValueAtTime(peak, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + decay);
        g.connect(bus);
        return g;
      };
      const kick = (t: number) => {
        const o = c.createOscillator();
        o.frequency.setValueAtTime(150, t);
        o.frequency.exponentialRampToValueAtTime(42, t + 0.12);
        o.connect(env(t, 1, 0.35));
        o.start(t); o.stop(t + 0.4);
      };
      const hiss = (t: number, type: BiquadFilterType, freq: number, peak: number, decay: number) => {
        const src = c.createBufferSource();
        src.buffer = noise;
        const f = c.createBiquadFilter();
        f.type = type; f.frequency.value = freq;
        src.connect(f).connect(env(t, peak, decay));
        src.start(t, Math.random() * 0.5); src.stop(t + decay + 0.05);
      };
      const bass = (t: number, hz: number) => {
        const o = c.createOscillator();
        o.type = 'sawtooth';
        o.frequency.value = hz;
        const f = c.createBiquadFilter();
        f.type = 'lowpass'; f.frequency.value = 500;
        o.connect(f).connect(env(t, 0.28, 0.22));
        o.start(t); o.stop(t + 0.25);
      };
      const stab = (t: number, notes: number[]) => {
        const f = c.createBiquadFilter();
        f.type = 'lowpass'; f.frequency.value = 2200;
        f.connect(env(t, 0.09, 0.2));
        notes.forEach((hz) => {
          const o = c.createOscillator();
          o.type = 'square';
          o.frequency.value = hz;
          o.connect(f);
          o.start(t); o.stop(t + 0.22);
        });
      };
      for (let n = 0; n < LOOP; n++) {
        const t = n * STEP;
        const bar = Math.floor(n / 16), s = n % 16, b = bar % 4, second = bar >= 4;
        const fill = bar === 7 && s >= 8;
        if (s % 4 === 0 && !(fill && s >= 12)) kick(t);
        if (n === 0) hiss(t, 'highpass', 5000, 0.3, 1.4); // crash on the downbeat
        if (fill) hiss(t, 'bandpass', 1500 + (s - 8) * 150, 0.2 + (s - 8) * 0.06, 0.1);
        else if (s % 8 === 4 || (b === 3 && s >= 14)) hiss(t, 'bandpass', 1500, 0.55, 0.14);
        if (s % 2 === 1) hiss(t, 'highpass', 7000, s % 4 === 3 ? 0.14 : 0.08, s % 4 === 3 ? 0.12 : 0.04);
        if (second && s % 2 === 0 && s % 4 !== 0) hiss(t, 'highpass', 8000, 0.05, 0.03);
        if (second && s % 4 === 2) stab(t, CHORDS[bar]);
        const m = (b === 3 ? WALK : GROOVE)[s];
        if (m) bass(t, ROOTS[bar] * m);
      }
      const raw = (await c.startRendering()).getChannelData(0);
      const len = Math.round(LOOP_SEC * sampleRate);
      const loop = raw.slice(0, len);
      for (let i = len; i < raw.length; i++) loop[i - len] += raw[i];
      return loop;
    };

    // plays the loop at any speed (negative = backwards), with linear interpolation and per-sample smoothing
    const DECK = `class Deck extends AudioWorkletProcessor {
      constructor() {
        super(); this.buf = null; this.pos = 0; this.rate = 0; this.target = 0; this.n = 0;
        this.port.onmessage = (e) => { const d = e.data;
          if (d.buf) this.buf = d.buf; if ('rate' in d) this.target = d.rate; if ('seek' in d) this.pos = d.seek; };
      }
      process(_, outputs) {
        const out = outputs[0][0], b = this.buf;
        if (!b) return true;
        const L = b.length;
        for (let i = 0; i < out.length; i++) {
          this.rate += (this.target - this.rate) * 0.002;
          this.pos += this.rate;
          if (this.pos >= L) this.pos -= L; else if (this.pos < 0) this.pos += L;
          const i0 = this.pos | 0, f = this.pos - i0, a = b[i0], c = b[(i0 + 1) % L];
          out[i] = a + (c - a) * f;
        }
        if ((this.n += out.length) >= 1024) { this.n = 0; this.port.postMessage(this.pos); }
        return true;
      }
    }
    registerProcessor('deck', Deck);`;

    let ctx: AudioContext | null = null;
    let deck: AudioWorkletNode, filter: BiquadFilterNode, ready: Promise<void> | null = null;
    let base = 1, hand = 1, motor = { v: 0 }, lastStep = -1, stopTimer = 0;
    const listeners: ((step: number) => void)[] = [];
    const send = () => deck?.port.postMessage({ rate: motor.v * hand * base });

    const init = () => {
      ctx = new AudioContext();
      const c = ctx;
      filter = c.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 18000;
      const out = c.createGain();
      out.gain.value = 0.5;
      filter.connect(out).connect(c.destination);
      ready = (async () => {
        const url = URL.createObjectURL(new Blob([DECK], { type: 'text/javascript' }));
        const [loop] = await Promise.all([render(c.sampleRate), c.audioWorklet.addModule(url)]);
        deck = new AudioWorkletNode(c, 'deck', { outputChannelCount: [1] });
        deck.connect(filter);
        deck.port.postMessage({ buf: loop, seek: 0 });
        const perStep = STEP * c.sampleRate;
        deck.port.onmessage = (e) => {
          const s = Math.floor((e.data as number) / perStep) % LOOP;
          if (s === lastStep || !api.playing) return;
          lastStep = s;
          listeners.forEach((fn) => fn(s % 16));
        };
      })();
    };

    const api = {
      playing: false,
      onStep(fn: (step: number) => void) { listeners.push(fn); },
      async start() {
        if (!ctx) init();
        clearTimeout(stopTimer);
        this.playing = true;
        await ctx!.resume();
        await ready;
        // motor spins the platter up to speed
        gsap.to(motor, { v: 1, duration: 0.35, ease: 'power2.out', overwrite: true, onUpdate: send });
      },
      stop() {
        this.playing = false;
        // ...and winds it down, pitch sinking like a turntable losing power
        gsap.to(motor, { v: 0, duration: 0.9, ease: 'power2.in', overwrite: true, onUpdate: send });
        stopTimer = window.setTimeout(() => { if (!api.playing) ctx?.suspend(); }, 1100);
      },
      // hand on the record: 1 = normal, 0 = held still, negative = pulled backwards
      setRate(r: number) { hand = r; send(); },
      setChill(on: boolean) {
        base = on ? 0.72 : 1; // slowed-down, pitched-down lo-fi version of the same record
        send();
        if (ctx) filter.frequency.setTargetAtTime(on ? 900 : 18000, ctx.currentTime, 0.3);
      },
    };
    return api;
  })();

  const beatBtn = $('.beat-toggle');
  beatBtn.addEventListener('click', () => {
    const on = !beat.playing;
    on ? beat.start() : beat.stop();
    beatBtn.setAttribute('aria-pressed', String(on));
    $('.bt-icon').textContent = on ? '■' : '▶';
    $('.bt-label').textContent = on ? 'stop the beat' : 'drop the beat';
    document.dispatchEvent(new CustomEvent('beat', { detail: on }));
  });

  // ── puzzle lounge (works with or without motion) ──
  const pieces = $$('.pz');
  const board = $('.board');
  const solved = $('.solved');
  const placed = new Set<HTMLElement>();
  const scatter = (animate: boolean) => {
    const w = board.clientWidth, h = board.clientHeight;
    const pw = w / 3, ph = h / 2;
    // deal the loose pieces into shuffled slots in the tray below the board
    const slots = gsap.utils.shuffle([0, 1, 2, 3, 4, 5]);
    pieces.forEach((p, n) => {
      if (placed.has(p)) return;
      const i = Number(p.dataset.i), homeX = (i % 3) * pw, homeY = Math.floor(i / 3) * ph;
      const slot = slots[n], jitter = pw * 0.08;
      const vars = {
        x: (slot % 3) * pw + gsap.utils.random(-jitter, jitter) - homeX,
        y: h + 30 + Math.floor(slot / 3) * ph * 1.08 + gsap.utils.random(-jitter, jitter) - homeY,
        rotate: gsap.utils.random(-12, 12),
      };
      animate ? gsap.to(p, { ...vars, duration: 0.8, ease: 'back.out(1.6)', stagger: 0.03 }) : gsap.set(p, vars);
    });
  };
  const place = (p: HTMLElement) => {
    placed.add(p);
    p.classList.add('placed');
    p.removeAttribute('tabindex');
    p.style.zIndex = '1';
    Draggable.get(p)?.disable();
    gsap.to(p, { x: 0, y: 0, rotate: 0, duration: motionOK() ? 0.35 : 0, ease: 'back.out(2)' });
    if (placed.size === pieces.length) {
      solved.classList.add('show');
      board.parentElement!.classList.add('done');
      setTimeout(() => ScrollTrigger.refresh(), 700);
      gsap.to(solved, { opacity: 1, duration: 0.4, delay: 0.3 });
      const r = board.getBoundingClientRect();
      starBurst(r.left + r.width / 2, r.top + r.height / 2, 16, 260);
      if (motionOK()) gsap.fromTo(board, { rotate: -3, scale: 1.04 }, { rotate: 0, scale: 1, duration: 1, ease: 'elastic.out(1, 0.3)' });
    }
  };
  Draggable.create(pieces, {
    type: 'x,y', zIndexBoost: true,
    onPress() { gsap.to(this.target, { rotate: 0, scale: 1.06, duration: 0.2 }); },
    onRelease() {
      const p = this.target as HTMLElement;
      gsap.to(p, { scale: 1, duration: 0.2 });
      if (Math.hypot(this.x, this.y) < board.clientWidth / 3 * 0.35) place(p);
    },
  });
  pieces.forEach((p) => {
    p.tabIndex = 0;
    p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); place(p); } });
  });
  $('.shuffle').addEventListener('click', () => {
    placed.clear();
    pieces.forEach((p) => { p.classList.remove('placed'); p.tabIndex = 0; Draggable.get(p)?.enable(); });
    gsap.to(solved, { opacity: 0, duration: 0.2 });
    solved.classList.remove('show');
    board.parentElement!.classList.remove('done');
    setTimeout(() => ScrollTrigger.refresh(), 700);
    scatter(motionOK());
  });
  scatter(false);
  let rw = innerWidth;
  window.addEventListener('resize', () => { if (innerWidth !== rw) { rw = innerWidth; scatter(false); } });

  // ── chill mode ──
  let lenis: Lenis | null = null;
  const chillBtn = $('.chill-toggle');
  chillBtn.addEventListener('click', () => {
    const on = document.documentElement.classList.toggle('chill');
    chillBtn.setAttribute('aria-pressed', String(on));
    document.querySelector('meta[name="theme-color"]')!.setAttribute('content', on ? '#ffc4c9' : '#ff5f6d');
    beat.setChill(on);
    if (motionOK()) gsap.to(gsap.globalTimeline, { timeScale: on ? 0.4 : 1, duration: 1.2, ease: 'power2.out' });
    if (lenis) lenis.options.lerp = on ? 0.05 : 0.11;
    say(on ? 'chill mode on. everything slows down. breathe.' : 'chill mode off. back to the party!');
  });

  const mm = gsap.matchMedia();

  mm.add(
    { motion: '(prefers-reduced-motion: no-preference)', reduce: '(prefers-reduced-motion: reduce)', fine: '(pointer: fine)' },
    (ctx) => {
      const { motion, fine } = ctx.conditions as Record<string, boolean>;
      gsap.set('.intro-hide', { visibility: 'visible' });
      if (!motion) return;

      // smooth scroll
      lenis = new Lenis({ lerp: 0.11 });
      lenis.on('scroll', ScrollTrigger.update);
      const raf = (t: number) => lenis!.raf(t * 1000);
      gsap.ticker.add(raf);
      gsap.ticker.lagSmoothing(0);
      const jump = (e: Event) => {
        const a = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
        if (!a) return;
        e.preventDefault();
        lenis!.scrollTo(a.getAttribute('href')!);
      };
      document.addEventListener('click', jump);

      // ── 1. the drop ──
      const split = SplitText.create('.title .word', { type: 'chars', charsClass: 'char' });
      const idle: gsap.core.Tween[] = []; // loops that pause while the real beat plays
      const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });
      intro
        .from('.band', { xPercent: (i) => (i % 2 ? 110 : -110), duration: 1, stagger: 0.07 })
        .from('.tag', { scale: 0, rotate: -40, duration: 0.7, ease: 'back.out(3)' }, 0.45)
        // letters stamp in where they sit, so no in-between frame has them flying over the tag
        .from(split.chars, {
          scale: 0, yPercent: -20, rotate: () => gsap.utils.random(-20, 20),
          duration: 0.6, ease: 'back.out(1.6)', stagger: 0.07, transformOrigin: '50% 80%',
        }, 0.5)
        .fromTo('.hero .script', { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: 0.9, ease: 'power2.inOut' }, 1.3)
        .from('.chip', { y: 60, scale: 0.3, opacity: 0, stagger: 0.08, duration: 0.6, ease: 'back.out(2.5)' }, 1.6)
        .from('.spark', { scale: 0, rotate: -180, stagger: 0.1, duration: 0.8, ease: 'back.out(2)' }, 1.2)
        .from('.trash .bit', { scale: 0, rotate: () => gsap.utils.random(-180, 180), stagger: 0.05, duration: 0.6, ease: 'back.out(2)' }, 1.4)
        .from('.scroll-cue', { y: 80, duration: 0.6 }, 2);

      // 120 BPM idle pulse (swapped for real hits when the beat is on)
      intro.add(() => {
        idle.push(gsap.to('.beat', { scale: 1.035, duration: BEAT / 2, repeat: -1, yoyo: true, ease: 'power1.inOut' }));
        idle.push(gsap.to('.chip', { y: -6, duration: BEAT / 2, repeat: -1, yoyo: true, ease: 'power2.out', stagger: { each: BEAT / 4 } }) as gsap.core.Tween);
        if (beat.playing) idle.forEach((t) => t.pause());
      });
      gsap.to('.spark', { rotate: '+=360', duration: 8, repeat: -1, ease: 'none', stagger: 1 });
      idle.push(gsap.to('.spark', { scale: 1.2, duration: BEAT / 2, repeat: -1, yoyo: true, ease: 'power2.inOut', delay: 2 }));
      gsap.to('.scroll-cue span', { y: 5, duration: BEAT / 2, repeat: -1, yoyo: true, ease: 'power1.inOut' });
      $$('.trash .bit').forEach((el) => {
        gsap.to(el, { y: gsap.utils.random(-24, 24), x: gsap.utils.random(-14, 14), rotate: gsap.utils.random(-30, 30), duration: gsap.utils.random(2.5, 4.5), repeat: -1, yoyo: true, ease: 'sine.inOut' });
      });

      // letters wiggle when touched
      // (only once the intro is done — overwriting mid-intro would freeze a letter half-drawn)
      let introDone = false;
      intro.add(() => { introDone = true; });
      split.chars.forEach((c) => {
        const wiggle = () => introDone && gsap.fromTo(c, { y: -30, rotate: gsap.utils.random(-25, 25), color: gsap.utils.random(COLORS.slice(0, 6)) },
          { y: 0, rotate: 0, color: '#111', duration: 1, ease: 'elastic.out(1, 0.35)', overwrite: 'auto' });
        c.addEventListener('pointerenter', wiggle);
        c.addEventListener('pointerdown', wiggle);
      });

      // hero parallax out
      $$('.band').forEach((b) => {
        gsap.fromTo(b, { xPercent: 0 }, { xPercent: Number(b.dataset.speed) * 60, ease: 'none', immediateRender: false, scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true } });
      });
      gsap.to('.hero-inner', { yPercent: 30, scale: 0.9, rotate: -3, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true } });

      // ── marquees + record react to scroll velocity ──
      const marq = $$('.m-track').map((t, i) =>
        gsap.fromTo(t, { xPercent: i ? -50 : 0 }, { xPercent: i ? 0 : -50, duration: 22, ease: 'none', repeat: -1 }));
      const record = document.querySelector('.record') as SVGGElement;
      let spin: gsap.core.Tween;
      const makeSpin = () => { spin?.kill(); spin = gsap.to(record, { rotation: '+=360', svgOrigin: '170 170', duration: 1.8, repeat: -1, ease: 'none' }); };
      makeSpin();
      let dir = 1, scratching = false;
      ScrollTrigger.create({
        onUpdate(self) {
          if (self.direction !== dir) dir = self.direction;
          const boost = 1 + Math.min(Math.abs(self.getVelocity()) / 250, 8);
          const spinners = scratching ? marq : [...marq, spin];
          spinners.forEach((m) => { gsap.killTweensOf(m, 'timeScale'); m.timeScale(dir * boost); gsap.to(m, { timeScale: dir, duration: 1.2, ease: 'power2.out' }); });
        },
      });

      // ── 2. horizontal when/where ──
      const track = $('.h-track');
      const dist = () => track.scrollWidth - window.innerWidth;
      const h = gsap.to(track, {
        x: () => -dist(), ease: 'none',
        scrollTrigger: { trigger: '.when', pin: true, scrub: 0.8, end: () => '+=' + dist(), invalidateOnRefresh: true, anticipatePin: 1 },
      });

      // 10/23 draws itself
      const text = $('.date-svg text') as unknown as SVGTextElement;
      gsap.set(text, { strokeDasharray: 1400, strokeDashoffset: 1400, fillOpacity: 0 });
      gsap.timeline({ scrollTrigger: { trigger: '.p-violet', start: 'top 70%', end: 'bottom top', toggleActions: 'play none none reverse' } })
        .to(text, { strokeDashoffset: 0, duration: 1.6, ease: 'power2.inOut' })
        .to(text, { fillOpacity: 1, duration: 0.4 }, '-=0.3');
      gsap.from('.p-violet .fri', { xPercent: -80, rotate: -20, opacity: 0, duration: 0.9, ease: 'back.out(2)', scrollTrigger: { trigger: '.p-violet', start: 'top 70%', toggleActions: 'play none none reverse' } });

      // clock: 7pm → 10pm as you scroll through
      const times = $$('.times li');
      gsap.timeline({ scrollTrigger: { trigger: '.p-pale', containerAnimation: h, start: 'left 60%', end: 'right 40%', scrub: true,
        onUpdate(self) { const hr = 7 + self.progress * 3; times.forEach((li, i) => li.classList.toggle('on', hr >= [7, 8, 9.9][i])); } } })
        .fromTo('.hand-h', { rotate: 210 }, { rotate: 300, svgOrigin: '100 100', ease: 'none' }, 0)
        .fromTo('.hand-m', { rotate: 0 }, { rotate: 1080, svgOrigin: '100 100', ease: 'none' }, 0);

      // train pulls into the station
      gsap.fromTo('.train', { x: () => -$('.train').getBoundingClientRect().width - 40 }, {
        x: () => window.innerWidth + 40, ease: 'none', invalidateOnRefresh: true,
        scrollTrigger: { trigger: '.p-teal', containerAnimation: h, start: 'left right', end: 'right left', scrub: true },
      });
      gsap.to('.train', { y: -3, duration: 0.12, repeat: -1, yoyo: true, ease: 'none' });
      gsap.to('.sign', { rotate: 3, scale: 1.05, ease: 'none', scrollTrigger: { trigger: '.sign', containerAnimation: h, start: 'left right', end: 'center center', scrub: true } });

      // 21+ stamp slams down
      gsap.from('.stamp', { scale: 3, rotate: 25, opacity: 0, ease: 'power4.in', duration: 0.5,
        scrollTrigger: { trigger: '.p-yellow', containerAnimation: h, start: 'left 30%', toggleActions: 'play none none reverse',
          onEnter: () => gsap.fromTo('.p-yellow', { x: -12 }, { x: 0, duration: 0.5, ease: 'elastic.out(1.2, 0.2)', delay: 0.5 }) } });

      gsap.from('.p-yellow .small, .p-yellow .btn-row', { y: 30, opacity: 0, stagger: 0.1, duration: 0.5, ease: 'back.out(2)', delay: 0.45,
        scrollTrigger: { trigger: '.p-yellow', containerAnimation: h, start: 'left 30%', toggleActions: 'play none none reverse' } });

      // ── 3. DJ ──
      gsap.from('.dj-name', { xPercent: -60, rotate: -25, opacity: 0, duration: 1, ease: 'back.out(1.8)', scrollTrigger: { trigger: '.dj', start: 'top 70%' } });
      gsap.from('.turntable', { xPercent: 60, rotate: 30, opacity: 0, duration: 1.1, ease: 'expo.out', scrollTrigger: { trigger: '.dj', start: 'top 70%' } });
      gsap.fromTo('.dj .dj-script', { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: 0.9, ease: 'power2.inOut', scrollTrigger: { trigger: '.dj', start: 'top 60%' } });
      const bars = $$('.eq span');
      const eqIdle = gsap.to(bars, { scaleY: () => gsap.utils.random(0.1, 0.5), duration: BEAT / 2, ease: 'power1.inOut', repeat: -1, repeatRefresh: true, stagger: { each: 0.04, from: 'center' } });

      // grab the record to scratch it, fling it to warp the beat: the deck plays at exactly the platter's speed
      const NORMAL_DPS = 360 / 1.8; // degrees/sec at normal speed
      const warp = { v: 1 };
      let lastRot = 0, lastT = 0, rate = 1, hinted = false;
      const follow = (d: Draggable) => {
        const now = performance.now(), dt = Math.max(now - lastT, 8);
        const inst = ((d.rotation - lastRot) / dt) * 1000 / NORMAL_DPS;
        rate += (inst - rate) * 0.5;
        lastRot = d.rotation; lastT = now;
        beat.setRate(rate);
      };
      // a hand resting on the record without moving it stops the sound, like real vinyl
      const holdCheck = () => { if (performance.now() - lastT > 50 && rate !== 0) { rate = 0; beat.setRate(0); } };
      const settle = () => {
        gsap.ticker.remove(holdCheck);
        scratching = false;
        makeSpin();
        warp.v = rate;
        gsap.to(warp, { v: 1, duration: 0.9, ease: 'power2.out', overwrite: true, onUpdate: () => beat.setRate(warp.v) });
      };
      Draggable.create(record, {
        type: 'rotation', inertia: true,
        onPress() {
          scratching = true; spin.pause(); gsap.killTweensOf(warp);
          lastRot = this.rotation; lastT = performance.now(); rate = 0; beat.setRate(0);
          gsap.ticker.add(holdCheck);
          if (!beat.playing && !hinted) { hinted = true; say('drop the beat first, then scratch!'); }
        },
        onDrag() { follow(this); },
        onThrowUpdate() { follow(this); },
        onRelease() { gsap.ticker.remove(holdCheck); if (!this.isThrowing) settle(); },
        onThrowComplete: settle,
      });

      // the beat drives hits across the page
      const onBeat = (on: boolean) => {
        idle.forEach((t) => (on ? t.pause() : t.resume()));
        on ? eqIdle.pause() : eqIdle.resume();
        gsap.to('.arm', { rotation: on ? 12 : 0, svgOrigin: '340 60', duration: 0.8, ease: 'power2.inOut' });
        if (!on) gsap.to(['.beat', '.spark'], { scale: 1, duration: 0.3 });
      };
      const beatListener = (e: Event) => onBeat((e as CustomEvent).detail);
      document.addEventListener('beat', beatListener);
      beat.onStep((s) => {
        if (!beat.playing) return;
        bars.forEach((b) => gsap.to(b, { scaleY: s % 4 === 0 ? gsap.utils.random(0.6, 1) : gsap.utils.random(0.15, 0.6), duration: 0.12, ease: 'power2.out' }));
        if (s % 4) return;
        gsap.fromTo('.beat', { scale: 1.07 }, { scale: 1, duration: 0.4, ease: 'power3.out', overwrite: 'auto' });
        gsap.fromTo('.spark', { scale: 1.35 }, { scale: 1, duration: 0.4, ease: 'power3.out', overwrite: 'auto' });
        gsap.fromTo('.btn-big', { scale: 1.08 }, { scale: 1, duration: 0.35, ease: 'power3.out', overwrite: 'auto' });
        gsap.fromTo('.turntable', { scale: 1.025 }, { scale: 1, duration: 0.3, ease: 'power2.out' });
        if (s === 0) gsap.fromTo('.band', { skewY: 1.5 }, { skewY: 0, duration: 0.5, ease: 'power3.out' });
      });

      // ── 4. trashion: yesterday's trash assembles into tonight's look ──
      const pcs = $$('.model .piece');
      gsap.set(pcs, { transformOrigin: '50% 50%' });
      const tr = gsap.timeline({ scrollTrigger: { trigger: '.trashion', pin: true, start: 'top top', end: '+=120%', scrub: 1 } });
      tr.from(pcs, {
        x: () => gsap.utils.random(-0.55, 0.55) * innerWidth, y: () => gsap.utils.random(-0.4, 0.4) * innerHeight,
        rotate: () => gsap.utils.random(-540, 540), scale: () => gsap.utils.random(0.5, 1.5),
        ease: 'power3.out', stagger: { each: 0.06, from: 'random' }, duration: 1,
      });
      // the copy and runway arrive as the section scrolls in, so there's never an empty green screen
      gsap.timeline({ scrollTrigger: { trigger: '.trashion', start: 'top 75%', toggleActions: 'play none none reverse' } })
        .from('.tr-title', { yPercent: 80, rotate: -20, opacity: 0, duration: 0.6, ease: 'back.out(2)' })
        .from('.tr-line', { clipPath: 'inset(0 100% 0 0)', duration: 0.5 }, 0.3)
        .from('.trashion .small, .trashion .kicker', { y: 40, opacity: 0, duration: 0.4 }, 0.4)
        .from('.runway', { xPercent: -100, duration: 0.7, ease: 'power2.out' }, 0.2)
        .from('.model .sparkles path', { scale: 0, transformOrigin: '50% 50%', stagger: 0.1, duration: 0.3, ease: 'back.out(3)' }, 0.6);
      // once dressed, she vogues on the beat
      gsap.to('.model', { rotate: 3, y: -8, duration: BEAT, repeat: -1, yoyo: true, ease: 'sine.inOut', transformOrigin: '50% 100%' });
      gsap.to('.tr-line .arrow', { x: 10, duration: BEAT / 2, repeat: -1, yoyo: true, ease: 'power2.inOut' });
      gsap.to('.runway', { backgroundPositionX: '-240px', duration: 3, repeat: -1, ease: 'none' });

      // ── 5. lounge ──
      gsap.from('.lounge-title', { y: 60, opacity: 0, duration: 0.9, ease: 'back.out(1.6)', scrollTrigger: { trigger: '.lounge', start: 'top 70%' } });
      gsap.from('.pz:not(.placed)', { scale: 0, rotate: () => gsap.utils.random(-90, 90), stagger: 0.07, duration: 0.7, ease: 'back.out(2)', scrollTrigger: { trigger: '.table', start: 'top 80%' } });

      // ── 6. tickets ──
      gsap.from('.price-inner', { scale: 0.2, rotate: -60, opacity: 0, duration: 1.2, ease: 'elastic.out(1, 0.4)', scrollTrigger: { trigger: '.tix', start: 'top 70%' } });
      gsap.to('.price-inner', { rotate: 4, duration: BEAT * 2, repeat: -1, yoyo: true, ease: 'sine.inOut' });
      gsap.from('.limited', { y: 60, opacity: 0, duration: 0.8, ease: 'back.out(2)', scrollTrigger: { trigger: '.limited', start: 'top 85%' } });
      gsap.from('.tb', { xPercent: (i) => (i % 2 ? 100 : -100), duration: 1.2, stagger: 0.15, ease: 'expo.out', scrollTrigger: { trigger: '.tix', start: 'top 80%' } });
      gsap.from('.sticker', { y: 120, rotate: () => gsap.utils.random(-50, 50), opacity: 0, stagger: 0.12, duration: 0.9, ease: 'back.out(2)', scrollTrigger: { trigger: '.awards', start: 'top 80%' } });
      idle.push(gsap.to('.btn-big', { scale: 1.05, duration: BEAT / 2, repeat: -1, yoyo: true, ease: 'power1.inOut' }));

      // stickers can be dragged around and bounce back
      Draggable.create('.sticker', {
        type: 'x,y', zIndexBoost: true,
        onPress() { gsap.to(this.target, { scale: 1.1, duration: 0.2 }); },
        onRelease() { gsap.to(this.target, { x: 0, y: 0, scale: 1, duration: 1, ease: 'elastic.out(1, 0.4)' }); },
      });

      if (fine) {
        // cursor star
        const cur = $('.cursor-star');
        const cx = gsap.quickTo(cur, 'x', { duration: 0.35, ease: 'power3' });
        const cy = gsap.quickTo(cur, 'y', { duration: 0.35, ease: 'power3' });
        gsap.to(cur, { rotate: 360, duration: 4, repeat: -1, ease: 'none' });
        window.addEventListener('pointermove', (e) => { cx(e.clientX); cy(e.clientY); });

        // $20 tilts toward the cursor
        const price = $('.price-inner');
        const rx = gsap.quickTo(price, 'rotationX', { duration: 0.6 });
        const ry = gsap.quickTo(price, 'rotationY', { duration: 0.6 });
        $('.tix').addEventListener('pointermove', (e) => {
          ry((e.clientX / innerWidth - 0.5) * 40);
          rx(-(e.clientY / innerHeight - 0.5) * 30);
        });

        // magnetic buttons
        $$('.magnetic').forEach((btn) => {
          const mx = gsap.quickTo(btn, 'x', { duration: 0.4, ease: 'power3' });
          const my = gsap.quickTo(btn, 'y', { duration: 0.4, ease: 'power3' });
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            mx((e.clientX - r.left - r.width / 2) * 0.35);
            my((e.clientY - r.top - r.height / 2) * 0.35);
          });
          btn.addEventListener('pointerleave', () => { mx(0); my(0); });
        });
      }

      // click/tap anywhere: star burst
      const burst = (e: PointerEvent) => {
        if ((e.target as HTMLElement).closest('a, button, .sticker, .pz, .record')) return;
        starBurst(e.clientX, e.clientY);
      };
      window.addEventListener('pointerdown', burst);

      return () => {
        gsap.ticker.remove(raf);
        lenis?.destroy();
        lenis = null;
        document.removeEventListener('click', jump);
        document.removeEventListener('beat', beatListener);
        window.removeEventListener('pointerdown', burst);
        split.revert();
      };
    },
  );
</script>
