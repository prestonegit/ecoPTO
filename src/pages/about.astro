---
import Layout from '../layouts/Layout.astro';

const [aboutPage] = await Astro.glob('../content/pages/about-us.mdx');

const { title, image1, image2 } = aboutPage.frontmatter;
---
<Layout title={title}>
  <article class="prose lg:prose-xl mx-auto">
    <h1>{title}</h1>

    {image1 && <img src={image1} alt="About us image 1" class="w-full h-auto rounded-lg my-8"/>}

    <aboutPage.Content />

    {image2 && <img src={image2} alt="About us image 2" class="w-full h-auto rounded-lg my-8"/>}
    
  </article>
</Layout>