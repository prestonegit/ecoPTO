---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Fetch the about-us content entry
const aboutPage = await getEntry('pages', 'about-us');

// Get the title from the frontmatter and the raw body text
const { title, image1, image2 } = aboutPage.data;
const renderedContent = await render(aboutPage);
---
<Layout title={title}>
  <article class="prose lg:prose-xl mx-auto">
    <h1>{title}</h1>

    {image1 && <img src={image1} alt="About us image 1" class="w-full h-auto rounded-lg my-8"/>}

    {renderedContent.Content && <renderedContent.Content />}

    {image2 && <img src={image2} alt="About us image 2" class="w-full h-auto rounded-lg my-8"/>}
    
  </article>
</Layout>