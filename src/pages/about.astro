---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { marked } from 'marked';

const allAboutUsEntries = await getCollection('aboutUs');
const aboutContent = allAboutUsEntries.find(entry => entry.slug === 'about-us');

console.log("All About Us Entries:", allAboutUsEntries);
console.log("About Content:", aboutContent);

if (!aboutContent) {
  console.error("About Us content entry not found!");
}

// Temporarily remove content rendering to isolate the data fetching issue
---
<Layout title="About Us Debug">
  <h1>About Us Debug Page</h1>
  <p>Check Netlify build logs for "All About Us Entries:" and "About Content:"</p>
  {aboutContent ? (
    <div>
      <h2>{aboutContent.data.title}</h2>
      <div set:html={aboutContent.data.history_content}></div>
    </div>
  ) : (
    <p>About content not found or collection is empty.</p>
  )}
</Layout>