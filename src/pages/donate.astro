---
import Layout from '../layouts/Layout.astro';
import DonateButton from '../components/DonateButton.astro';
---
<Layout title="Donate | Hopewell Valley ecoPTO">
  <div class="container mx-auto px-6 py-16 md:py-24 max-w-4xl">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Support Our Mission</h1>
      <p class="text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto">
        Your contributions help us fund teacher grants, educational events, and community sustainability initiatives. 
      </p>
    </div>

    <div class="bg-[var(--bg-secondary)] rounded-2xl p-8 md:p-12 border border-gray-100 flex flex-col items-center text-center shadow-sm">
      <h2 class="text-2xl font-bold mb-4">Make a Donation</h2>
      <p class="mb-8 text-[var(--text-primary)] max-w-lg">
        Every little bit helps! Use the button below to complete a secure donation through PayPal. You can use your PayPal account or a major credit card.
      </p>
      
      <DonateButton />
      
      <div class="mt-10 text-sm text-[var(--text-secondary)] border-t border-gray-200 pt-6 px-4">
        <p><strong>Tax Deductibility Notice:</strong> We are a registered 501(c)(3) non-profit organization. Your donation is tax-deductible to the extent permitted by law. Please retain your PayPal receipt for your tax records.</p>
      </div>
    </div>
  </div>
</Layout>
