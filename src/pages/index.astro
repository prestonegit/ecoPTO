---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import GetInvolved from '../components/GetInvolved.astro'; 
import Contact from '../components/Contact.astro';
import { getEntry } from 'astro:content';

const homeContent = await getEntry('homepage', 'home');
const whoWeAreContent = await getEntry('pages', 'about-us');
const allLeaders = await Astro.glob('../content/leadership/*.mdx');

// Sort leaders by the 'order' field, if available, otherwise by name
allLeaders.sort((a, b) => {
  if (a.frontmatter.order && b.frontmatter.order) {
    return a.frontmatter.order - b.frontmatter.order;
  } else {
    return a.frontmatter.name.localeCompare(b.frontmatter.name);
  }
});
---
<Layout title="Home | Hopewell Valley ecoPTO">
  <Hero content={homeContent.data} />
  <Mission content={homeContent.data} />
  
  <UpcomingEvents content={homeContent.data} />

  {/* Who We Are Section */}
  <section class="py-8 bg-bg-secondary">
    <div class="container mx-auto px-6">
      <h2 class="text-4xl font-bold text-primary mb-4">{whoWeAreContent.frontmatter.title}</h2>
      <article class="prose prose-lg text-text-secondary !mb-0 max-w-none mb-12">
        <whoWeAreContent.Content />
      </article>

      {/* Leadership Section */}
      <section class="py-8 bg-bg-secondary">
        <div class="container mx-auto px-6 text-center">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {allLeaders.map(leader => (
              <div class="bg-bg-primary p-8 rounded-xl shadow-sm text-center">
                {leader.frontmatter.image && (
                  <img
                    src={leader.frontmatter.image}
                    alt={leader.frontmatter.name}
                    class="w-24 h-24 sm:w-32 sm:h-32 rounded-full mx-auto mb-6 object-cover border-2 border-secondary"
                  />
                )}
                <h3 class="text-2xl font-bold text-primary">{leader.frontmatter.name}</h3>
                <p class="text-lg text-text-secondary mb-4">{leader.frontmatter.title}</p>
                {leader.frontmatter.bio && (
                  <div class="prose mx-auto text-text-primary">
                    <leader.Content />
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
  </section>

  <Contact content={homeContent.data} />
</Layout>