---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import GetInvolved from '../components/GetInvolved.astro'; 
import Contact from '../components/Contact.astro';
import { getEntry, getCollection } from 'astro:content';

const homeContent = await getEntry('homepage', 'home');


---
<Layout title="Home | Hopewell Valley ecoPTO">
  <Hero content={homeContent.data} />

  <div class="bg-bg-primary py-16 md:py-20 border-b border-secondary/10 overflow-hidden relative">
    <div class="container mx-auto px-6 text-center animate-on-scroll">
      <p class="text-2xl md:text-3xl lg:text-4xl font-medium text-primary max-w-4xl mx-auto leading-relaxed">
        We envision our youth boldly reshaping the culture and physical landscape of Hopewell Valley, New Jersey, and the planet — for the betterment of all living things.
      </p>
      <div class="mt-10 md:mt-12 flex justify-center">
        <button id="join-us-hero-btn" class="get-involved-trigger btn-standard btn-secondary-color px-8 py-3.5 shadow-md font-semibold text-lg" data-target-tab="form-join">
          {homeContent.data.hero_button_text}
        </button>
      </div>
    </div>
  </div>

  <UpcomingEvents content={homeContent.data} />
  <Mission content={homeContent.data} />



  <Contact content={homeContent.data} />
</Layout>