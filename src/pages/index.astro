---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import GetInvolved from '../components/GetInvolved.astro'; 
import Contact from '../components/Contact.astro';
import { getEntry, getCollection } from 'astro:content';

const homeContent = await getEntry('homepage', 'home');

const allLeadersUnordered = await getCollection('leadership');
const allLeaders = allLeadersUnordered.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---
<Layout title="Home | Hopewell Valley ecoPTO">
  <Hero content={homeContent.data} />
  <Mission content={homeContent.data} />
  
  <UpcomingEvents content={homeContent.data} />

  {/* Who We Are Section */}
  <section class="py-16 bg-bg-primary">
    <div class="container mx-auto px-6">
      <h2 class="text-4xl font-bold text-primary mb-6">{homeContent.data.who_we_are_title}</h2>
      <article class="prose prose-lg text-text-secondary !mb-0 max-w-none mb-12">
        <div set:html={homeContent.data.who_we_are_text}></div>
      </article>

      {/* Leadership Section */}
      <section class="pt-12">
        <div class="container mx-auto px-6 text-center">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {allLeaders.map(leader => (
              <div class="bg-bg-primary p-8 rounded-xl shadow-sm text-center">
                {leader.data.image && (
                  <img
                    src={leader.data.image}
                    alt={leader.data.name}
                    class="w-24 h-24 sm:w-32 sm:h-32 rounded-full mx-auto mb-6 object-cover border-2 border-secondary"
                  />
                )}
                <h3 class="text-2xl font-bold text-primary">{leader.data.name}</h3>
                <p class="text-lg text-text-secondary mb-4">{leader.data.title}</p>
              </div>
            ))}
          </div>
          <a href="/about" class="btn-standard btn-primary-color mt-16">
            Learn about our journey
          </a>
        </div>
      </section>
    </div>
  </section>

  <Contact content={homeContent.data} />
</Layout>