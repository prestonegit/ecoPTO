    }

    // 2. Update Keyboard Chiclet Buttons & LEDs
    for (let i = 0; i < 4; i++) {
      const face = document.getElementById(`deck-face-${i}`);
      const highlight = document.getElementById(`deck-hi-${i}`);
      const led = document.getElementById(`deck-led-${i}`);
      const time = document.getElementById(`deck-time-${i}`);
      const label = document.getElementById(`deck-label-${i}`);
      const keyGroup = document.getElementById(`key-${i}`);

      if (i === currentStep) {
        if (face) {
          face.setAttribute('fill', 'url(#oledActiveGrad)');
          face.setAttribute('stroke', '#60A5FA');
          face.setAttribute('stroke-width', '1.4');
        }
        if (highlight) {
          highlight.setAttribute('stroke', '#93C5FD');
          highlight.setAttribute('opacity', '0.95');
        }
        if (led) {
          led.setAttribute('fill', '#38BDF8');
          led.setAttribute('filter', 'url(#oledLedGlow)');
        }
        if (time) time.setAttribute('fill', '#FFFFFF');
        if (label) label.setAttribute('fill', '#93C5FD');
        if (keyGroup) keyGroup.setAttribute('aria-current', 'step');
      } else {
