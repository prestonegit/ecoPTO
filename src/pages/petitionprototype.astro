  function triggerShutLid() {
    isAnalogMode = true;
    const lid = document.getElementById('chromebook-lid');
    const base = document.getElementById('laptop-base');
    const laptopViewport = document.getElementById('laptop-viewport');
    const analogStage = document.getElementById('analog-stage');

    if (lid) lid.classList.add('is-shut');
    
    setTimeout(() => {
      if (laptopViewport) laptopViewport.style.display = 'none';
      if (lid) lid.style.display = 'none';
      if (base) base.style.display = 'none';
      if (analogStage) {
        analogStage.classList.remove('is-hidden');
        analogStage.style.display = 'block';
      }
      updateDynamicScaling();
      renderMobileCard();

      const section = document.getElementById('chromebook-interactive');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }, 400);
  }

  function triggerReopenLid() {
    isAnalogMode = false;
    const lid = document.getElementById('chromebook-lid');
    const base = document.getElementById('laptop-base');
    const laptopViewport = document.getElementById('laptop-viewport');
    const analogStage = document.getElementById('analog-stage');

    if (analogStage) analogStage.classList.add('is-hidden');
    setTimeout(() => {
      if (analogStage) analogStage.style.display = 'none';
      if (laptopViewport) laptopViewport.style.display = 'flex';
      if (lid) lid.style.display = 'block';
      if (base) base.style.display = 'block';
      setTimeout(() => {
        if (lid) lid.classList.remove('is-shut');
      }, 50);
      updateDynamicScaling();
      renderMobileCard();

      const section = document.getElementById('chromebook-interactive');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }, 300);
  }

  function updateDynamicScaling() {
    const container = document.getElementById('interactive-scaler-container');
    const stage = document.getElementById('interactive-scaler-stage');
    const headingEl = document.getElementById('interactive-heading');
    const laptopViewport = document.getElementById('laptop-viewport');
    const analogStage = document.getElementById('analog-stage');
    if (!container || !stage) return;

    const isAnalog = analogStage && !analogStage.classList.contains('is-hidden') && analogStage.style.display !== 'none';
    const activeEl = isAnalog ? analogStage : laptopViewport;
    if (!activeEl) return;

    const winW = window.innerWidth;
    const winH = window.innerHeight;

    // On narrow mobile devices (< 640px), let natural mobile document flow take over
    if (winW < 640) {
      stage.style.transform = '';
      stage.style.width = '100%';
      stage.style.maxWidth = '';
      container.style.height = 'auto';
      return;
    }

    // Base design dimensions
    const baseWidth = isAnalog ? 780 : 860;
    stage.style.width = baseWidth + 'px';
    stage.style.maxWidth = 'none';

    // Standardized reference unscaled layout height for rock-solid stability across checkpoints
    const headingH = headingEl ? headingEl.offsetHeight : 0;
    const activeH = isAnalog ? 750 : 695;
    const naturalHeight = headingH + activeH;

    // Available space calculations:
    const parentW = container.parentElement ? container.parentElement.clientWidth : winW;
    const availableWidth = Math.max(320, Math.min(winW - 32, parentW - 8));

    // Reserving vertical space for sticky navigation (65px), section top padding (16px), and bottom safety buffer (16px)
    const availableHeight = Math.max(420, winH - 96);

    // Proportional scale factor
    const scaleW = availableWidth / baseWidth;
    const scaleH = availableHeight / naturalHeight;
    let scale = Math.min(scaleW, scaleH, 1.0);

    // Minimum scale safety floor
    scale = Math.max(0.48, Math.round(scale * 1000) / 1000);

    stage.style.transform = `scale(${scale})`;
    stage.style.transformOrigin = 'top center';
    container.style.height = Math.round(naturalHeight * scale) + 'px';
  }

  // Expose methods to window for inline onclick attributes
  window.selectTime = selectTime;
  window.goToPrevStep = goToPrevStep;
  window.goToNextStep = goToNextStep;
  window.triggerShutLid = triggerShutLid;
  window.triggerReopenLid = triggerReopenLid;
  window.toggleMobileMode = toggleMobileMode;
  window.updateDynamicScaling = updateDynamicScaling;

  function initChromebookInteractive() {
    const container = document.getElementById('interactive-scaler-container');
    if (!container) return;

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('step')) {
      const s = parseInt(urlParams.get('step'), 10);
      if (!isNaN(s) && s >= 0 && s < dayScenarios.length) {
        currentStep = s;
      }
    }
    if (urlParams.get('shut') === '1') {
      isAnalogMode = true;
      const lid = document.getElementById('chromebook-lid');
      const base = document.getElementById('laptop-base');
      const laptopViewport = document.getElementById('laptop-viewport');
      const analogStage = document.getElementById('analog-stage');
      if (laptopViewport) laptopViewport.style.display = 'none';
      if (lid) lid.style.display = 'none';
      if (base) base.style.display = 'none';
      if (analogStage) {
        analogStage.classList.remove('is-hidden');
        analogStage.style.display = 'block';
      }
    }
    selectTime(currentStep);
    renderMobileCard();
    updateDynamicScaling();

    if (urlParams.has('focus')) {
      const el = document.getElementById(urlParams.get('focus'));
      if (el) {
        const targetTop = Math.max(0, el.offsetTop - 70);
        document.documentElement.scrollTop = targetTop;
        document.body.scrollTop = targetTop;
      }
    }
  }

  // Bind to resize and orientationchange
  window.addEventListener('resize', updateDynamicScaling);
  window.addEventListener('orientationchange', updateDynamicScaling);

  // Astro page transitions & initial load support
  document.addEventListener('astro:page-load', initChromebookInteractive);
  if (document.readyState !== 'loading') {
    initChromebookInteractive();
  } else {
    document.addEventListener('DOMContentLoaded', initChromebookInteractive);
  }
</script>
