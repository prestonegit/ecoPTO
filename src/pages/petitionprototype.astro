---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Parent Petition (Hardware Simulator Prototype) | ecoPTO">
  <!-- Prototype Switcher Banner -->
  <div class="bg-amber-100 border-b border-amber-300 py-2 px-4 text-center text-xs sm:text-sm font-medium text-amber-900 flex items-center justify-center gap-2">
    <span>Hardware SVG Simulator Prototype</span>
    <span class="text-amber-500">&middot;</span>
    <a href="/petition" class="font-bold underline hover:text-amber-950">View New Photographic Version &rarr;</a>
  </div>

  <!-- ========================================== -->
  <!-- Big & Bold Hero Section                    -->
  <!-- ========================================== -->
  <section class="bg-[#FAF7F2] border-b border-[#E5D6C7] py-16 sm:py-24">
    <div class="container mx-auto px-6 max-w-4xl text-center sm:text-left">

      <h1 class="font-serif font-bold text-primary tracking-tight text-5xl sm:text-6xl md:text-7xl mb-6 leading-[1.08]">
        Screens down.<br class="hidden sm:block" />Pencils up.
      </h1>

      <p class="text-xl sm:text-2xl text-text-primary font-normal leading-relaxed max-w-4xl mb-8">
        We applaud Superintendent Treece&rsquo;s vision to curb classroom device use. Now, let&rsquo;s back that vision with five actionable, common-sense district milestones.
      </p>

      <!-- CTA Row -->
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
        <a 
          href="https://docs.google.com/forms/d/e/1FAIpQLSesXReJQFHeyrAkUoZwhCmavNcOXENg-jN5mx21ZaFbsf_O2A/viewform" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-action bg-primary hover:bg-[#8A3E22] text-white text-base sm:text-lg w-full sm:w-auto text-center shadow-md flex items-center justify-center gap-2"
        >
          <span>Sign the Petition on Google Forms</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <a 
          href="#chromebook-interactive" 
          class="px-6 py-3 text-text-secondary hover:text-primary font-bold text-sm sm:text-base transition-colors flex items-center gap-1.5 min-h-[48px]"
        >
          <span>See How Screens Impact Our Kids &darr;</span>
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="mt-8 pt-6 border-t border-[#E5D6C7]/70 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-text-secondary">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span>Takes under 60 seconds</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span>IEP &amp; 504 Accommodations Protected</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span>Organized by HVRSD Parents</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ======================================================== -->
  <!-- ⚡ THE CHROMEBOOK SCREEN SIMULATOR & ANALOG REALITY      -->
  <!-- ======================================================== -->
  <section id="chromebook-interactive" class="scroll-mt-16 pt-3 sm:pt-4 pb-12 sm:pb-16">
    <div class="container mx-auto px-6 max-w-4xl">

      <!-- Dynamic Interactive Scaler Container -->
      <div id="interactive-scaler-container" class="w-full relative overflow-visible transition-[height] duration-150 ease-out mx-auto">
        
        <!-- Scaler Stage: Scales via CSS transform: scale(s) from top center -->
        <div id="interactive-scaler-stage" class="relative mx-auto origin-top flex-shrink-0 transition-transform duration-150 ease-out">

          <!-- Section Heading (Scales harmoniously with the interactive experience) -->
          <div id="interactive-heading" class="text-center max-w-2xl mx-auto mb-3.5 sm:mb-4 select-none">
            <h2 class="font-serif font-bold text-primary tracking-tight text-2xl sm:text-3xl md:text-4xl mb-1.5 sm:mb-2">
              A Day in the Life of an HVRSD Student
            </h2>
            <p class="text-sm sm:text-base md:text-lg text-text-secondary leading-relaxed">
              See how routine school screen time saturates each part of our children&rsquo;s day &mdash; then <span class="hidden sm:inline">close the laptop</span><span class="sm:hidden">tap Screens Down</span> to experience the focused analog balance.
            </p>
          </div>

          <!-- ============================================ -->
          <!-- STATE 1: THE OPEN CHROMEBOOK (Hardware SVG)  -->
          <!-- ============================================ -->
          <div id="laptop-viewport" class="laptop-chassis w-full max-w-[860px] mx-auto hidden sm:flex flex-col items-center">

            <!-- LAPTOP DISPLAY LID (Chassis Grey Frame: 88% width to seamlessly match SVG hinge) -->
            <figure id="chromebook-lid" class="laptop-lid-3d w-[88%] bg-[#5E6573] rounded-t-2xl sm:rounded-t-3xl pt-2 sm:pt-2.5 px-2 sm:px-3 pb-0 shadow-2xl relative m-0 border border-[#484F5C] border-b-0">
              
              <!-- Clean Webcam Dot on Grey Bezel -->
              <div class="flex items-center justify-center pb-2 pt-0.5 select-none">
                <span class="w-2 h-2 rounded-full bg-[#1C2026] border border-[#3A414D]"></span>
              </div>

              <!-- CHROMEBOOK SCREEN DISPLAY (Dark Display Window) -->
              <div class="bg-[#141820] rounded-lg overflow-hidden text-white relative shadow-inner">
                
                <!-- Browser Tab Strip -->
                <div class="bg-[#1E232D] px-3 pt-2 pb-0 border-b border-[#2C3342] flex items-center justify-between gap-2 select-none overflow-x-auto">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <!-- Active Tab -->
                    <div class="bg-[#141820] px-3 py-1.5 text-xs font-medium text-white flex items-center gap-2 rounded-t-md border-t-2 border-slate-400 max-w-[210px] truncate flex-shrink-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-white/80 flex-shrink-0"></span>
                      <span id="tab-active-title" class="truncate font-sans text-xs">Google Classroom · English Lit</span>
                      <span class="text-gray-400 hover:text-white ml-1 text-xs cursor-pointer">&times;</span>
                    </div>
                    <!-- Background Tab 1 -->
                    <div class="px-2.5 py-1.5 text-xs font-medium text-gray-400 hidden sm:flex items-center gap-1.5 opacity-80 max-w-[170px] truncate flex-shrink-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-gray-500 flex-shrink-0"></span>
                      <span id="tab-bg-title-1" class="truncate font-sans text-[11px]">CoolMath Games (Run 3)</span>
                    </div>
                    <!-- Background Tab 2 -->
                    <div class="px-2.5 py-1.5 text-xs font-medium text-gray-400 hidden md:flex items-center gap-1.5 opacity-70 max-w-[170px] truncate flex-shrink-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-gray-500 flex-shrink-0"></span>
                      <span id="tab-bg-title-2" class="truncate font-sans text-[11px]">Ed Podcast · Lo-Fi Study</span>
                    </div>
                    <!-- Plus Tabs Count -->
                    <div id="tab-count-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-bold text-gray-400 bg-[#222834] border border-[#323B4A] flex-shrink-0">
                      + 11 tabs
                    </div>
                  </div>
                </div>

                <!-- Main Screen Viewport Content (Fixed consistent height so chassis never changes shape) -->
                <div class="p-5 sm:p-7 md:p-8 h-[435px] flex flex-col justify-between bg-gradient-to-b from-[#141820] to-[#0D1017] overflow-hidden">
                  
                  <!-- Top Row: Title on Left, Notification Toast on Right -->
                  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 flex-shrink-0">
                    <h3 id="screen-title" class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-snug max-w-xl">
                      Chronic Tab-Switching &amp; Cognitive Fatigue
                    </h3>
                    <!-- Right: Distraction Toast (Amber notification callout) -->
                    <aside id="screen-toast" class="w-full md:w-auto md:max-w-xs bg-[#1F2533]/95 border border-[#3E4A61] rounded-xl p-3 sm:p-3.5 shadow-xl select-none flex-shrink-0 min-h-[64px] flex flex-col justify-center">
                      <div class="flex items-center justify-between gap-2 mb-1">
                        <div class="flex items-center gap-1.5 min-w-0">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse flex-shrink-0"></span>
                          <span id="toast-source" class="text-[11px] font-bold text-amber-400 uppercase tracking-wider truncate">Educational Games</span>
                        </div>
                        <span id="toast-time" class="text-[10px] text-gray-400 font-mono flex-shrink-0">now</span>
                      </div>
                      <p id="toast-msg" class="text-xs sm:text-sm text-gray-200 leading-snug m-0">
                        Daily math puzzle unlocked in background tab.
                      </p>
                    </aside>
                  </div>

                  <!-- Middle Section: Narrative Paragraph -->
                  <div class="my-auto py-2">
                    <p id="screen-desc" class="text-base sm:text-lg md:text-xl text-gray-200 leading-relaxed font-normal w-full max-w-2xl">
                      Students open school-issued screens for basic reading. Multi-tab browsing, passive notification checking, and digital eye strain fragment deep comprehension.
                    </p>
                  </div>
                  
                  <!-- Bottom Section: Problem Callout Box + Progression Buttons -->
                  <div class="flex flex-col gap-4 sm:gap-5 flex-shrink-0 mt-3 sm:mt-4">
                    <div class="w-full flex items-center text-sm sm:text-base font-medium text-rose-100 bg-[#231215]/95 border border-[#7A2424]/75 px-5 py-3 rounded-xl shadow-md">
                      <span id="screen-problem">Screen time unmeasured; physical reading displaced.</span>
                    </div>

                    <!-- Contextual Progression Buttons Below Red Box -->
                    <div class="flex items-center justify-between gap-3 pt-2 sm:pt-3">
                      <button 
                        type="button" 
                        id="screen-nav-prev" 
                        onclick="goToPrevStep()"
                        class="text-xs sm:text-sm font-semibold text-gray-300 hover:text-white bg-[#1C222E]/90 hover:bg-[#2A3446] border border-white/20 hover:border-white/40 px-4 sm:px-4.5 py-2 sm:py-2.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95"
                        aria-label="Previous checkpoint"
                      >
                        <span aria-hidden="true">&larr;</span>
                        <span id="screen-nav-prev-label">Morning focus</span>
                      </button>

                      <button 
                        type="button" 
                        id="screen-nav-next" 
                        onclick="goToNextStep()"
                        class="text-xs sm:text-sm font-bold text-white bg-primary hover:bg-[#8A3E22] border border-[#FFC099]/40 px-5 sm:px-6 py-2 sm:py-2.5 rounded-lg transition-all shadow-md hover:shadow-lg flex items-center gap-1.5 cursor-pointer ml-auto active:scale-95"
                        aria-label="Next checkpoint"
                      >
                        <span id="screen-nav-next-label">Next class &rarr;</span>
                      </button>
                    </div>
                  </div>

                </div>

              </div>

              <!-- Clean Bezel Bottom in Grey -->
              <div class="h-3 sm:h-3.5 bg-[#5E6573] border-t border-[#484F5C]"></div>

            </figure>

            <!-- LAPTOP PHYSICAL KEYBOARD BASE & TRACKPAD (Grey Chassis) -->
            <div id="laptop-base" class="w-full select-none -mt-[1px] relative">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 248" class="w-full h-auto block select-none filter drop-shadow-2xl" role="region" aria-label="Laptop keyboard deck">
  <defs>
    <linearGradient id="deckGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#757D8B"/>
      <stop offset="20%" stop-color="#666E7C"/>
      <stop offset="70%" stop-color="#545B67"/>
      <stop offset="100%" stop-color="#454B55"/>
    </linearGradient>
    <linearGradient id="hingeGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#2D323B"/>
      <stop offset="35%" stop-color="#58606E"/>
      <stop offset="65%" stop-color="#3E4550"/>
      <stop offset="100%" stop-color="#252931"/>
    </linearGradient>
    <linearGradient id="trayGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#2D323B"/>
      <stop offset="50%" stop-color="#363C47"/>
      <stop offset="100%" stop-color="#3E4552"/>
    </linearGradient>
    <linearGradient id="keyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#252932"/>
      <stop offset="100%" stop-color="#181B22"/>
    </linearGradient>
    <linearGradient id="trackGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#8C94A2"/>
      <stop offset="100%" stop-color="#777F8D"/>
    </linearGradient>
    <linearGradient id="navKeyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#3A4354"/>
      <stop offset="100%" stop-color="#222834"/>
    </linearGradient>
    <filter id="keyGlow" x="-10%" y="-15%" width="120%" height="130%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.7"/>
    </filter>
    <filter id="keyTextShadow">
      <feDropShadow dx="0" dy="1.5" stdDeviation="1" flood-color="#000000" flood-opacity="0.85"/>
    </filter>
    <linearGradient id="oledActiveGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1E3A8A"/>
      <stop offset="100%" stop-color="#0F172A"/>
    </linearGradient>
    <filter id="oledLedGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#38BDF8" flood-opacity="0.9"/>
    </filter>
    <filter id="wellDepth">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- Hinge Segment with Chamfer -->
  <rect x="60" y="0" width="880" height="10" rx="3" fill="url(#hingeGrad)" stroke="#4A5260" stroke-width="0.5"/>
  <line x1="60" y1="9.5" x2="940" y2="9.5" stroke="#1F232B" stroke-width="1"/>

  <!-- Main Chassis Deck: Crisp Tapered Aluminum Unibody -->
  <path d="M 60 9 L 940 9 L 1000 220 Q 994 232 972 232 L 28 232 Q 6 232 0 220 Z" fill="url(#deckGrad)" />
  <!-- Bottom Chamfer & Shadow Lip -->
  <path d="M 0 220 L 28 232 L 972 232 L 1000 220 L 994 240 Q 982 248 954 248 L 46 248 Q 18 248 6 240 Z" fill="#2E333C"/>
  <line x1="28" y1="232" x2="972" y2="232" stroke="#8A92A0" stroke-width="0.8" opacity="0.6"/>
  <!-- Front Edge Center Thumb Scoop -->
  <rect x="440" y="230" width="120" height="4" rx="2" fill="#3D444F" stroke="#252A32" stroke-width="0.5"/>

  <!-- Recessed Keyboard Well Tray (Dark Beveled Basin - Exclusively framing the 4 custom navigation keys) -->
  <path d="M 88 22 L 912 22 Q 918 22 920 28 L 924 122 Q 926 126 918 126 L 82 126 Q 74 126 76 122 L 80 28 Q 82 22 88 22 Z" fill="url(#trayGrad)" stroke="#22262E" stroke-width="1.2" filter="url(#wellDepth)"/>

  <!-- 4 CUSTOM NAVIGATION BUTTONS (OLED Checkpoints) -->
  <!-- Key 0: 8:00 AM -->
  <g class="deck-svg-key" id="key-0" onclick="selectTime(0)" role="button" tabindex="0" aria-label="8:00 AM Morning Focus Checkpoint" aria-current="step">
    <rect id="deck-face-0" x="94.5" y="31.2" width="193.0" height="83.5" rx="5.0" fill="url(#oledActiveGrad)" stroke="#60A5FA" stroke-width="1.4"/>
    <rect id="deck-hi-0" x="96.5" y="33.2" width="189.0" height="2.0" rx="1.0" fill="none" stroke="#93C5FD" stroke-width="1" opacity="0.95"/>
    <circle id="deck-led-0" cx="118.5" cy="58.0" r="4.5" fill="#38BDF8" filter="url(#oledLedGlow)"/>
    <text id="deck-time-0" x="134.5" y="62.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="800" font-size="20.5" fill="#FFFFFF" letter-spacing="0.02em" filter="url(#keyTextShadow)">8:00 AM</text>
    <text id="deck-label-0" x="118.5" y="93.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="600" font-size="12.0" fill="#93C5FD" letter-spacing="0.04em">Morning Focus</text>
  </g>

  <!-- Key 1: 1:15 PM -->
  <g class="deck-svg-key" id="key-1" onclick="selectTime(1)" role="button" tabindex="0" aria-label="1:15 PM Afternoon Inquiry Checkpoint">
    <rect id="deck-face-1" x="300.5" y="31.2" width="193.0" height="83.5" rx="5.0" fill="url(#keyGrad)" stroke="#383F4D" stroke-width="0.5"/>
    <rect id="deck-hi-1" x="302.5" y="33.2" width="189.0" height="2.0" rx="1.0" fill="none" stroke="#4A5364" stroke-width="1" opacity="0.5"/>
    <circle id="deck-led-1" cx="324.5" cy="58.0" r="4.5" fill="#4B5563"/>
    <text id="deck-time-1" x="340.5" y="62.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="700" font-size="20.5" fill="#CBD5E1" letter-spacing="0.02em" filter="url(#keyTextShadow)">1:15 PM</text>
    <text id="deck-label-1" x="324.5" y="93.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="600" font-size="12.0" fill="#64748B" letter-spacing="0.04em">Afternoon Inquiry</text>
  </g>

  <!-- Key 2: 6:00 PM -->
  <g class="deck-svg-key" id="key-2" onclick="selectTime(2)" role="button" tabindex="0" aria-label="6:00 PM Dinner & Homework Checkpoint">
    <rect id="deck-face-2" x="506.5" y="31.2" width="193.0" height="83.5" rx="5.0" fill="url(#keyGrad)" stroke="#383F4D" stroke-width="0.5"/>
    <rect id="deck-hi-2" x="508.5" y="33.2" width="189.0" height="2.0" rx="1.0" fill="none" stroke="#4A5364" stroke-width="1" opacity="0.5"/>
    <circle id="deck-led-2" cx="530.5" cy="58.0" r="4.5" fill="#4B5563"/>
    <text id="deck-time-2" x="546.5" y="62.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="700" font-size="20.5" fill="#CBD5E1" letter-spacing="0.02em" filter="url(#keyTextShadow)">6:00 PM</text>
    <text id="deck-label-2" x="530.5" y="93.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="600" font-size="12.0" fill="#64748B" letter-spacing="0.04em">Dinner &amp; Homework</text>
  </g>

  <!-- Key 3: 8:30 PM -->
  <g class="deck-svg-key" id="key-3" onclick="selectTime(3)" role="button" tabindex="0" aria-label="8:30 PM Bedtime & Sleep Checkpoint">
    <rect id="deck-face-3" x="712.5" y="31.2" width="193.0" height="83.5" rx="5.0" fill="url(#keyGrad)" stroke="#383F4D" stroke-width="0.5"/>
    <rect id="deck-hi-3" x="714.5" y="33.2" width="189.0" height="2.0" rx="1.0" fill="none" stroke="#4A5364" stroke-width="1" opacity="0.5"/>
    <circle id="deck-led-3" cx="736.5" cy="58.0" r="4.5" fill="#4B5563"/>
    <text id="deck-time-3" x="752.5" y="62.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="700" font-size="20.5" fill="#CBD5E1" letter-spacing="0.02em" filter="url(#keyTextShadow)">8:30 PM</text>
    <text id="deck-label-3" x="736.5" y="93.5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="600" font-size="12.0" fill="#64748B" letter-spacing="0.04em">Bedtime &amp; Sleep</text>
  </g>

  <!-- TRACKPAD AREA: THE 'SCREENS DOWN' PHYSICAL LID TRIGGER -->
  <g id="trackpad-well">
    <!-- Recessed trackpad boundary well -->
    <path d="M 378 140 L 622 140 Q 626 140 627 144 L 632 216 Q 633 220 627 220 L 373 220 Q 367 220 368 216 L 373 144 Q 374 140 378 140 Z" fill="url(#trackGrad)" stroke="#586170" stroke-width="0.8"/>
    
    <!-- Interactive Trackpad Button Surface: "Screens Down" -->
    <g id="trackpad-close-btn" onclick="triggerShutLid()" role="button" tabindex="0" aria-label="Close laptop lid and switch to analog reality mode">
      <path d="M 380 142 L 620 142 Q 624 142 625 146 L 630 214 Q 631 218 625 218 L 375 218 Q 369 218 370 214 L 375 146 Q 376 142 380 142 Z" fill="#2A303C" stroke="#434B5A" stroke-width="0.8"/>
      <!-- Subtle top inner highlight -->
      <line x1="384" y1="144" x2="616" y2="144" stroke="#687385" stroke-width="0.8" opacity="0.6"/>
      <!-- Trackpad Label: Screens Down with Down Arrow -->
      <text x="492" y="186" text-anchor="middle" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-weight="700" font-size="16" fill="#F1F5F9" letter-spacing="0.03em">Screens Down</text>
      <path d="M 552 180 L 557 185 L 562 180" stroke="#F1F5F9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </g>
  </g>
</svg>
            </div>

          </div>

          <!-- ============================================== -->
          <!-- STATE 2: THE SCREEN-REDUCED ANALOG ALTERNATIVE -->
          <!-- ============================================== -->
          <article id="analog-stage" class="analog-stage is-hidden hidden sm:block bg-[#FAF7F2] rounded-3xl overflow-hidden border-2 border-[#E5D6C7] shadow-xl w-full max-w-[780px] mx-auto">

            <!-- Full-Bleed 16:9 Photographic Window -->
            <div class="relative w-full aspect-video sm:aspect-[16/9] overflow-hidden bg-stone-900 select-none">
              <img 
                id="analog-photo" 
                src="/images/analog-morning-book.jpg" 
                alt="Screen-free analog moment" 
                class="w-full h-full object-cover block transition-all duration-500 hover:scale-105"
                loading="eager"
              />
              <!-- Subtle gradient overlay for readability & mood -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/30 pointer-events-none"></div>

              <!-- Embedded Time Navigation HUD -->
              <div class="absolute bottom-3 inset-x-2.5 sm:bottom-5 sm:inset-x-5 flex items-center justify-between gap-1.5 sm:gap-2 pointer-events-none z-10">
                
                <!-- Left: Previous Time Checkpoint Button -->
                <button 
                  type="button" 
                  id="analog-prev-wrapper"
                  onclick="goToPrevStep()" 
