  }
  .btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(176, 91, 59, 0.3);
  }
  .btn-action:active {
    transform: translateY(0);
  }

  /* 3D Chromebook Lid Hinge Animation */
  .chromebook-stage {
    perspective: 1400px;
  }
  .laptop-lid-3d {
    transform-origin: bottom center;
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s ease;
  }
  .laptop-lid-3d.is-shut {
    transform: rotateX(82deg) translateY(10px) scale(0.96);
    opacity: 0;
    pointer-events: none;
  }

  .analog-stage {
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .analog-stage.is-hidden {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    pointer-events: none;
    display: none;
  }

  /* Strict separation between Desktop Laptop/Analog and Mobile Photographic Experience */
  @media (max-width: 639px) {
    #laptop-viewport,
    #analog-stage {
      display: none !important;
    }
    #mobile-card-stage {
      display: block !important;
    }
  }
  @media (min-width: 640px) {
    #mobile-card-stage {
      display: none !important;
    }
  }

  /* SVG Physical Deck Keycaps & Trackpad */
  .deck-svg-key {
    cursor: pointer;
    outline: none;
    transition: transform 0.08s ease;
  }
  .deck-svg-key:hover rect[id^="deck-face-"] {
    filter: brightness(1.22);
  }
  .deck-svg-key:active {
    transform: translateY(1.5px);
  }
  .deck-svg-key:focus-visible rect[id^="deck-face-"] {
    stroke: #93C5FD;
    stroke-width: 2px;
  }
  #trackpad-close-btn {
    cursor: pointer;
    outline: none;
    transition: filter 0.15s ease, transform 0.08s ease;
  }
  #trackpad-close-btn:hover path {
    filter: brightness(1.12);
  }
  #trackpad-close-btn:active {
    transform: translateY(1px);
  }
  /* Dynamic Scaler Transitions */
  #interactive-scaler-container {
    transition: height 0.15s ease-out;
  }
  #interactive-scaler-stage {
    transition: transform 0.15s ease-out;
  }
