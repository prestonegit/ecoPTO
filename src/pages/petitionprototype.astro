    const currentNav = navLabels[currentStep] || navLabels[0];

    if (screenPrevBtn) {
      if (isFirst) {
        screenPrevBtn.style.visibility = 'hidden';
        screenPrevBtn.setAttribute('aria-hidden', 'true');
      } else {
        screenPrevBtn.style.visibility = 'visible';
        screenPrevBtn.removeAttribute('aria-hidden');
        if (screenPrevLabel && currentNav.prev) {
