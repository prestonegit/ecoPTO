---
import Layout from '../layouts/Layout.astro';
import { getCollection } from "astro:content";
import TimelineItem from "../components/TimelineItem.astro";



const allPages = await getCollection("pages");
const impactPage = allPages.find(page => page.slug === "impact");

if (!impactPage) {
  return Astro.redirect("/404"); // Or render a fallback message
}

const { data, Content } = impactPage;
const { title, subtitle, achievements_title, achievements } = data;
---
<Layout title={title}>
  <section class="py-24 bg-primary relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-white opacity-10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="container mx-auto px-6 relative z-10 flex flex-col items-center text-center">
      <h1 class="text-5xl md:text-6xl font-extrabold text-bg-primary mb-6 tracking-tight">{title}</h1>
      <p class="text-xl text-green-50 max-w-3xl leading-relaxed font-medium">{subtitle}</p>
    </div>
  </section>

  <section class="py-20 relative">
    <div class="container mx-auto px-6">
      
      <!-- Timeline Container -->
      <div class="relative wrap overflow-hidden p-10 h-full">
        <div class="border-l-4 border-primary absolute h-full left-1/2 transform -translate-x-1/2"></div>
        
        {achievements?.map((achievement, index) => (
          <TimelineItem achievement={achievement} index={index} />
        ))}
      </div>
    </div>
  </section>

  

  {Content && <Content />}
</Layout>