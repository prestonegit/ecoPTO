---
import Layout from '../layouts/Layout.astro';
import { getCollection } from "astro:content";
import TimelineItem from "../components/TimelineItem.astro";



const allPages = await getCollection("pages");
const impactPage = allPages.find(page => page.slug === "impact");

if (!impactPage) {
  return Astro.redirect("/404"); // Or render a fallback message
}

const { data, Content } = impactPage;
const { title, subtitle, achievements_title, achievements, image1, image2, image3, image4 } = data;
---
<Layout title={title}>
  <section class="py-20 bg-primary">
    <div class="container mx-auto px-6 text-center">
      <h1 class="text-4xl font-bold text-secondary">{title}</h1>
      <p class="mt-4 text-lg text-bg-primary max-w-3xl mx-auto">{subtitle}</p>
    </div>
  </section>

  <section class="py-20 relative">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center text-primary mb-12">{achievements_title}</h2>
      
      <!-- Timeline Container -->
      <div class="relative wrap overflow-hidden p-10 h-full">
        <div class="border-l-4 border-primary absolute h-full left-1/2 transform -translate-x-1/2"></div>
        
        {achievements?.map((achievement, index) => (
          <TimelineItem achievement={achievement} index={index} />
        ))}
      </div>
    </div>
  </section>

  

  {Content && <Content />}
</Layout>