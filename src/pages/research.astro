---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const researchEntries = await getCollection('research');
const researchPage = researchEntries.find(entry => entry.slug === 'research');

if (!researchPage) {
  return Astro.redirect('/404');
}

const { data } = researchPage;
const { title, description, peer_reviewed_research, books } = data;
---

<Layout title={title}>
  <section class="py-20 bg-primary text-center">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-secondary">{title}</h1>
      {description && <p class="mt-4 text-lg text-white max-w-3xl mx-auto">{description}</p>}
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-6">
      
      {/* Peer-Reviewed Research Section */}
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-primary mb-8 border-b-2 border-secondary pb-2 inline-block">
          Peer-Reviewed Research
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {peer_reviewed_research?.map((item) => (
            <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-secondary hover:shadow-lg transition-shadow">
              <h3 class="text-xl font-semibold text-gray-800 mb-2">{item.title}</h3>
              {item.article_title && (
                <p class="text-md text-gray-600 mb-2 italic">"{item.article_title}"</p>
              )}
              {item.comment && (
                <p class="text-sm text-gray-500 mb-4">{item.comment}</p>
              )}
              {item.link ? (
                <a 
                  href={item.link} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-primary font-bold hover:underline inline-flex items-center"
                >
                  Read Article
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <span class="text-gray-400 text-sm">Link unavailable</span>
              )}
            </div>
          ))}
          {(!peer_reviewed_research || peer_reviewed_research.length === 0) && (
             <p class="text-gray-500 italic">No research articles listed yet.</p>
          )}
        </div>
      </div>

      {/* Books Section */}
      <div>
        <h2 class="text-3xl font-bold text-primary mb-8 border-b-2 border-secondary pb-2 inline-block">
          Recommended Books
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {books?.map((book) => (
            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-primary hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-semibold text-gray-800 mb-1">{book.title}</h3>
                <p class="text-md text-gray-600 mb-2">by {book.author}</p>
                {book.comment && (
                  <p class="text-sm text-gray-500 mb-4">{book.comment}</p>
                )}
                {book.link ? (
                <a 
                    href={book.link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-secondary font-bold hover:underline inline-flex items-center"
                >
                    View Book
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
                ) : (
                <span class="text-gray-400 text-sm">Link unavailable</span>
                )}
            </div>
            ))}
             {(!books || books.length === 0) && (
             <p class="text-gray-500 italic">No books listed yet.</p>
          )}
        </div>
      </div>

    </div>
  </section>
</Layout>
