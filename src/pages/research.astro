---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const researchEntries = await getCollection('research');
const researchPage = researchEntries.find(entry => entry.slug === 'research');

if (!researchPage) {
  return Astro.redirect('/404');
}

const { data } = researchPage;
const { title, description, peer_reviewed_research, books, online_resources } = data;
---

<Layout title={title}>
  <section class="relative py-24 bg-primary overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 right-0 p-12 opacity-5 pointer-events-none">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-64 h-64 text-white">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" />
      </svg>
    </div>
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-6xl font-extrabold text-bg-primary mb-6 leading-tight">{title}</h1>
        {description && <p class="text-xl text-green-50 leading-relaxed font-medium">{description}</p>}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-6">
      
      {/* Peer-Reviewed Research Section */}
      <div class="mb-24">
        <h2 class="text-3xl font-bold text-primary mb-10 flex items-center gap-4">
          <span class="w-8 h-1 bg-primary rounded-full"></span>
          Peer-Reviewed Research
        </h2>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {peer_reviewed_research?.map((item) => (
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover-spring group relative overflow-hidden flex flex-col h-full">
              <div class="absolute top-0 inset-x-0 h-1 bg-secondary transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
              <h3 class="text-xl font-semibold text-gray-800 mb-2">{item.title}</h3>
              {item.article_title && (
                <p class="text-md text-gray-600 mb-2 italic">"{item.article_title}"</p>
              )}
              {item.comment && (
                <p class="text-sm text-gray-500 mb-4">{item.comment}</p>
              )}
              {item.link ? (
                <a 
                  href={item.link} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-primary font-bold hover:underline inline-flex items-center"
                >
                  Read Article
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <span class="text-gray-400 text-sm">Link unavailable</span>
              )}
            </div>
          ))}
          {(!peer_reviewed_research || peer_reviewed_research.length === 0) && (
             <p class="text-gray-500 italic">No research articles listed yet.</p>
          )}
        </div>
      </div>

      {/* Books Section */}
      <div class="mb-24">
        <h2 class="text-3xl font-bold text-primary mb-10 flex items-center gap-4">
          <span class="w-8 h-1 bg-primary rounded-full"></span>
          Recommended Books
        </h2>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {books?.map((book) => (
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover-spring group relative overflow-hidden flex flex-col h-full">
              <div class="absolute top-0 inset-x-0 h-1 bg-primary transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                <h3 class="text-xl font-semibold text-gray-800 mb-1">{book.title}</h3>
                <p class="text-md text-gray-600 mb-2">by {book.author}</p>
                {book.comment && (
                  <p class="text-sm text-gray-500 mb-4">{book.comment}</p>
                )}
                {book.link ? (
                <a 
                    href={book.link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-secondary font-bold hover:underline inline-flex items-center"
                >
                    View Book
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
                ) : (
                <span class="text-gray-400 text-sm">Link unavailable</span>
                )}
            </div>
            ))}
             {(!books || books.length === 0) && (
             <p class="text-gray-500 italic">No books listed yet.</p>
          )}
        </div>
      </div>

      {/* Online Resources Section */}
      <div class="mt-16">
        <h2 class="text-3xl font-bold text-primary mb-10 flex items-center gap-4">
          <span class="w-8 h-1 bg-primary rounded-full"></span>
          Online Resources
        </h2>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {online_resources?.map((resource) => (
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover-spring group relative overflow-hidden flex flex-col h-full">
              <div class="absolute top-0 inset-x-0 h-1 bg-accent transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">{resource.title}</h3>
                {resource.comment && (
                  <p class="text-sm text-gray-500 mb-4">{resource.comment}</p>
                )}
                <a 
                    href={resource.link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-primary font-bold hover:underline inline-flex items-center"
                >
                    View Link
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
            ))}
             {(!online_resources || online_resources.length === 0) && (
             <p class="text-gray-500 italic">No online resources listed yet.</p>
          )}
        </div>
      </div>

    </div>
  </section>
</Layout>
