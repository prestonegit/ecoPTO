---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const issues = (await getCollection('newsletters'))
  .filter((i) => i.data.status === 'sent')
  .sort((a, b) => new Date(b.data.sendDate) - new Date(a.data.sendDate));
---
<Layout title="Newsletter Archive">
  <section class="py-24 bg-bg-primary">
    <div class="container mx-auto px-6 max-w-3xl">
      <h1 class="text-5xl font-medium text-primary mb-4 font-serif">Newsletter Archive</h1>
      <p class="text-xl text-text-secondary mb-12">
        Catch up on what's been happening at ecoPTO. Want these in your inbox? <a href="/#contact" class="text-primary underline">Subscribe here</a>.
      </p>

      {issues.length === 0 && (
        <p class="text-text-secondary italic">No issues sent yet — check back soon!</p>
      )}

      <div class="space-y-6">
        {issues.map((i) => (
          <a href={`/newsletter/${i.slug}/`} class="block p-6 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover-spring transition-all group">
            <div class="text-sm text-text-secondary mb-2">
              {new Date(i.data.sendDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </div>
            <h2 class="text-2xl font-bold text-primary group-hover:text-green-700 transition-colors mb-2">
              {i.data.subject}
            </h2>
            {i.data.preheader && (
              <p class="text-text-secondary">{i.data.preheader}</p>
            )}
            <span class="mt-4 inline-flex items-center text-sm font-bold text-primary group-hover:text-green-700">
              Read issue <span class="ml-1 transform group-hover:translate-x-1 transition-transform">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
