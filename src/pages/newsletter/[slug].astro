---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { render } from '@react-email/render';
import sanitizeHtml from 'sanitize-html';
import React from 'react';
import Newsletter from '../../emails/Newsletter.jsx';
import { ORG } from '../../config/org.js';

// Snapshots written by scripts/push-newsletter.mjs at send time. Using them means an
// archived issue keeps showing the events and news that were actually in the email,
// instead of silently re-deriving them from whatever content exists at build time.
const snapshots = import.meta.glob('../../data/sent-newsletters/*.json', { eager: true });
const snapshotFor = (slug) =>
  Object.entries(snapshots).find(([p]) => p.endsWith(`/${slug}.json`))?.[1]?.default ?? null;

export async function getStaticPaths() {
  const issues = (await getCollection('newsletters')).filter((i) => i.data.status === 'sent');
  return issues.map((i) => ({ params: { slug: i.slug }, props: { issue: i } }));
}

const { issue } = Astro.props;
const d = issue.data;
const snapshot = snapshotFor(issue.slug);
const sentDate = new Date(snapshot?.sentAt ?? d.sendDate);
const sentDateIsExact = Boolean(snapshot?.sentAt);

// Fall back to a build-time derivation for issues sent before snapshots existed.
const fallbackEvents = async () => {
  if (!d.includeEvents) return [];
  const all = await getCollection('events');
  return all
    .filter((e) => new Date(e.data.eventDate) >= sentDate)
    .sort((a, b) => new Date(a.data.eventDate) - new Date(b.data.eventDate))
    .slice(0, 4)
    .map((e) => ({
      slug: e.slug, title: e.data.title, eventDate: e.data.eventDate,
      dateOverride: e.data.dateOverride ?? null, location: e.data.location ?? null,
      cardDescription: e.data.cardDescription ?? e.data.description ?? '',
      externalUrl: e.data.externalUrl ?? null,
    }));
};
const fallbackNews = async () => {
  if (!d.includeNews) return [];
  const all = await getCollection('news');
  return all
    .filter((n) => new Date(n.data.pubDate) <= sentDate)
    .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate))
    .slice(0, 3)
    .map((n) => ({
      slug: n.slug, title: n.data.title, author: n.data.author,
      pubDate: n.data.pubDate, description: n.data.description ?? '',
    }));
};

const events = snapshot?.events ?? (await fallbackEvents());
const news = snapshot?.news ?? (await fallbackNews());

// Render the exact same component the email used, then lift the body contents out of
// the standalone email document so it can sit inside the site chrome. One renderer,
// so the archive can never drift from what subscribers received.
const emailHtml = await render(
  React.createElement(Newsletter, {
    data: d, events, news, siteUrl: ORG.siteUrl, unsubscribeUrl: `${ORG.siteUrl}/#contact`,
  }),
);
const rawBody = emailHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i)?.[1] ?? emailHtml;

// Newsletter body copy is markdown rendered by `marked`, which passes raw HTML through
// by design. In an email that markup is inert; injected into this page with set:html it
// would execute on the ecopto.org origin. Sanitize before it reaches the DOM — a CMS
// editor should not be able to run script on the public site.
const bodyInner = sanitizeHtml(rawBody, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'table', 'thead', 'tbody', 'tr', 'td', 'th', 'style']),
  allowedAttributes: { '*': ['style', 'class', 'align', 'width', 'height', 'colspan', 'rowspan', 'role'], a: ['href', 'target', 'rel'], img: ['src', 'alt', 'width', 'height'] },
  allowedSchemes: ['http', 'https', 'mailto'],
  // style attributes are how the whole email is laid out, so they must survive;
  // sanitize-html still strips javascript: and expression() from them.
  allowVulnerableTags: false,
});
---
<Layout title={`${d.subject} — ${ORG.newsletterName}`}>
  <article class="py-16 bg-bg-primary">
    <div class="container mx-auto px-6 max-w-3xl">
      <a href="/newsletter/" class="text-sm text-primary hover:underline">&larr; All issues</a>
      <p class="text-sm text-text-secondary mt-6">
        Sent {sentDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: sentDateIsExact ? 'America/New_York' : 'UTC' })}
      </p>
    </div>
    <div class="newsletter-archive-body mt-6" set:html={bodyInner} />
  </article>
</Layout>

<style is:global>
  /* Only the <body> contents of the email are lifted onto this page, so the typography
     the email declares in its <head> has to be restated here — scoped, so the email's
     global `* { font-family }` rule can't escape and restyle the rest of the site. */
  .newsletter-archive-body {
    background: transparent;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #333333;
  }
  .newsletter-archive-body table { margin-left: auto; margin-right: auto; }
  .newsletter-archive-body img { max-width: 100%; height: auto; }
</style>
