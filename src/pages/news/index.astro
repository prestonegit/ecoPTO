---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro'; // Assuming you have a NewsCard component

const allNews = await getCollection('news');

// Sort news by publish date, newest first
allNews.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="News & Updates">
  <section class="relative py-16 sm:py-24 bg-bg-secondary text-center">
    <div class="container mx-auto px-6">
      <h1 class="text-5xl font-extrabold text-primary mb-4">Latest News & Updates</h1>
      <p class="text-text-secondary text-lg max-w-3xl mx-auto">
        Stay informed with the latest happenings, announcements, and stories from ecoPTO.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allNews.length > 0 ? (
          allNews.map(post => (
            <NewsCard news={post} />
          ))
        ) : (
          <p class="text-center text-text-secondary col-span-full">No news posts yet. Check back soon!</p>
        )}
      </div>
    </div>
  </section>
</Layout>