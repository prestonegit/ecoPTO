---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ProjectsVisualization from '../components/ProjectsVisualization.jsx';

import { marked } from 'marked';

// Goal and Description are formatted text. Render them to HTML here, at build time, rather
// than in the browser: the component used to print Goal as plain text (so bold showed as
// asterisks) and to inject Description's raw markdown as if it were HTML. The raw fields stay
// as they are, since the search box matches against them.
const projects = (await getCollection('projects')).map((p) => ({
  ...p,
  data: {
    ...p.data,
    goalHtml: p.data.goal ? marked.parse(p.data.goal) : '',
    descriptionHtml: p.data.description ? marked.parse(p.data.description) : '',
  },
}));
---

<Layout title="Projects">
  <section class="py-20 container mx-auto px-6">
  <div class="w-full">
      <h1 class="text-4xl font-bold text-center mb-12">Our Projects</h1>
      <div class="mb-8">
        <label for="search" class="sr-only">Search projects</label>
        <input type="text" id="search" placeholder="Search for projects..." class="w-full p-4 border border-gray-300 rounded-lg">
      </div>
      <div class="w-full">
        <ProjectsVisualization projects={projects} client:load />
      </div>
    </div>
  </section>
  </Layout>
