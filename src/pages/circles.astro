---
// PROTOTYPE: the ecoPTO sky, a GSAP voyage through our circles (see components/circles/voyage.js).
// Not linked from the nav, excluded from the sitemap, and marked noindex. Projects and shared
// members come from prototypeWorld.js until the projects schema can express them.
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { buildWorld } from '../components/circles/prototypeWorld.js';

const projects = (await getCollection('projects')).map((p) => ({
  ...p,
  data: {
    ...p.data,
    goalHtml: p.data.goal ? marked.parse(p.data.goal) : '',
    descriptionHtml: p.data.description ? marked.parse(p.data.description) : '',
  },
}));
const world = buildWorld(projects);
---

<Layout title="Our Circles">
  <meta name="robots" content="noindex" slot="head" />
  <section class="vy-stage" data-voyage data-world={JSON.stringify(world)}>
    <svg class="vy-svg" viewBox="-500 -500 1000 1000" preserveAspectRatio="xMidYMid meet" role="group" aria-label="The ecoPTO sky: every team is a star">
      <defs></defs>
    </svg>
    <div class="vy-flash" aria-hidden="true"></div>

    <div class="vy-hero">
      <p class="vy-eyebrow">The ecoPTO sky</p>
      <h1>Our Circles</h1>
      <p>Every team is a star circling ecoPTO. Gold threads join teams that share people. Pick a star to travel there.</p>
    </div>

    <div class="vy-hud">
      <nav class="vy-crumbs" aria-label="Where you are" hidden></nav>
      <div class="vy-search">
        <label for="vy-search" class="sr-only">Search teams, projects and people</label>
        <input id="vy-search" type="search" placeholder="Find a team, project or person…" autocomplete="off" />
        <div class="vy-results" aria-live="polite"></div>
      </div>
    </div>

    <p class="vy-hint">Click a star to travel · planets to land · Esc to head back out</p>

    <aside class="vy-panel" aria-hidden="true" aria-label="About this place">
      <button type="button" class="vy-close" aria-label="Head back out">×</button>
      <p class="vy-kicker"></p>
      <h2 class="vy-title"></h2>
      <p class="vy-count"></p>
      <div class="vy-goal"></div>
      <div class="vy-desc"></div>
      <div class="vy-section"><h3>Planets in this system</h3><div class="vy-kids"></div></div>
      <div class="vy-section"><h3>People</h3><ul class="vy-people-list"></ul></div>
      <div class="vy-keywords"></div>
    </aside>

    <div class="vy-tip" aria-hidden="true"></div>
  </section>

  <!-- The same map as plain nested lists, for screen readers and anyone without JS. -->
  <nav class="sr-only" aria-label="All circles">
    <ul>
      {world.root.children.map((c) => (
        <li>
          {c.title}: {c.people.join(', ')}
          {c.children.length > 0 && (
            <ul>{c.children.map((s) => <li>{s.title}: {s.people.join(', ')}</li>)}</ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</Layout>

<script>
  import { mountVoyage } from '../components/circles/voyage.js';

  let destroy: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-voyage]');
    if (el) destroy = mountVoyage(el, JSON.parse(el.dataset.world!));
  });
  document.addEventListener('astro:before-swap', () => {
    destroy?.();
    destroy = null;
  });
</script>

<style is:global>
  .vy-stage {
    --gold: #FFD27F;
    --cream: #EDE3D2;
    --muted: #9A85B8;
    --sand: #C9B89A;
    position: relative;
    height: calc(100svh - 4.5rem);
    min-height: 560px;
    overflow: hidden;
    color: var(--cream);
    font-family: var(--font-sans);
    background:
      radial-gradient(40% 30% at 50% 50%, rgba(196, 106, 66, 0.30) 0%, transparent 70%),
      radial-gradient(30% 34% at 6% 98%, rgba(124, 86, 170, 0.30) 0%, transparent 72%),
      radial-gradient(24% 22% at 92% 72%, rgba(92, 142, 172, 0.18) 0%, transparent 72%),
      radial-gradient(130% 95% at 50% 4%, #2E2452 0%, #241B3E 45%, #140E1E 100%);
  }
  .vy-svg { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: manipulation; }
  .vy-flash {
    --flash: #fff;
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at 50% 50%, var(--flash) 0%, color-mix(in srgb, var(--flash) 40%, transparent) 35%, transparent 75%);
  }

  /* the sky */
  .vy-orbit { fill: none; stroke: rgba(255, 226, 184, 0.10); stroke-width: 1; stroke-dasharray: 2 7; vector-effect: non-scaling-stroke; }
  .vy-spoke { stroke: rgba(255, 226, 184, 0.14); stroke-width: 1; vector-effect: non-scaling-stroke; transition: stroke 0.3s; }
  .vy-spoke.is-hot { stroke: var(--gold); }
  .vy-link { fill: none; stroke: var(--gold); stroke-width: 1.2; stroke-dasharray: 1 5; stroke-linecap: round; opacity: 0.35; vector-effect: non-scaling-stroke; transition: opacity 0.3s; }
  .vy-link.is-hot { opacity: 0.95; }
  .vy-team { cursor: pointer; outline: none; }
  .vy-team:focus-visible .vy-hit { stroke: var(--gold); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .vy-moonlet { fill: #FFE3B0; opacity: 0.8; }
  .vy-star-label, .vy-sun-label, .vy-eco-label, .vy-planet-label, .vy-beacon-label {
    font-family: var(--font-serif); fill: #EFE2CC; pointer-events: none; user-select: none;
    paint-order: stroke; stroke: rgba(20, 14, 30, 0.7); stroke-width: 3px; stroke-linejoin: round;
  }
  .vy-star-label { font-size: 14px; font-weight: 600; }
  .vy-eco-label { font-size: 22px; font-weight: 700; fill: #FFE6BE; }
  .vy-greek { fill: var(--gold); font-style: italic; }

  /* a system */
  .vy-sys-orbit { fill: none; stroke: rgba(255, 226, 184, 0.16); stroke-width: 1; stroke-dasharray: 2 6; vector-effect: non-scaling-stroke; }
  .vy-sun { cursor: pointer; outline: none; }
  .vy-sun-label { font-size: 24px; font-weight: 700; fill: #FFE6BE; }
  .vy-planet { cursor: pointer; outline: none; }
  .vy-planet:focus-visible circle:first-child { stroke-opacity: 1; }
  .vy-planet-label { font-size: 13px; font-weight: 600; }
  .vy-planet.is-focus .vy-planet-label { opacity: 0; }
  .vy-moon-label, .vy-person-label {
    font-size: 7px; fill: var(--sand); font-family: var(--font-sans); font-weight: 600; pointer-events: none;
    paint-order: stroke; stroke: rgba(20, 14, 30, 0.7); stroke-width: 2px;
  }
  .vy-moon-label { font-size: 4.5px; stroke-width: 1.5px; opacity: 0; transition: opacity 0.4s; }
  .vy-planet.is-focus .vy-moon-label { opacity: 1; }
  .vy-person-label { font-size: 8.5px; }
  .vy-comet, .vy-moon.is-linked { cursor: pointer; }
  .vy-atmo { stroke-width: 1.5; opacity: 0.35; vector-effect: non-scaling-stroke; }
  .vy-comet-tail { stroke: #FFF1D6; stroke-linecap: round; }
  .vy-beacon { cursor: pointer; outline: none; }
  .vy-beacon:hover .vy-beacon-label, .vy-beacon:focus-visible .vy-beacon-label { fill: var(--gold); }
  .vy-beacon-label { font-size: 11px; fill: var(--sand); }
  .vy-streak { stroke-width: 1.4; stroke-linecap: round; }

  /* chrome */
  .vy-stage h1, .vy-stage h2, .vy-stage h3 { color: inherit; }
  .vy-hero { position: absolute; left: 2rem; bottom: 2.5rem; width: min(22rem, calc(100% - 2rem)); pointer-events: none; }
  .vy-eyebrow { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.22em; color: #B79BE0; }
  .vy-hero h1 { margin-top: 0.3rem; font-family: var(--font-serif); font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.05; color: #FFE6BE !important; }
  .vy-hero p:last-child { margin-top: 0.6rem; color: var(--sand); font-size: 0.95rem; line-height: 1.55; }

  .vy-hud { position: absolute; top: 1rem; left: 1rem; right: 1rem; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; pointer-events: none; }
  .vy-hud > * { pointer-events: auto; }
  .vy-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 0.35rem; font-size: 0.88rem; }
  .vy-crumbs[hidden] { display: none; }
  .vy-crumbs button { color: var(--muted); padding: 0.35rem 0.85rem; border-radius: 999px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); }
  .vy-crumbs button:hover { color: var(--gold); }
  .vy-crumbs button[aria-current] { color: var(--gold); border-color: rgba(255, 210, 127, 0.35); }
  .vy-sep { color: var(--muted); }
  .vy-search { width: min(19rem, 100%); margin-left: auto; }
  .vy-search input {
    width: 100%; padding: 0.65rem 1.1rem; border-radius: 999px; font-size: 0.9rem; color: var(--cream);
    background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .vy-search input::placeholder { color: var(--muted); }
  .vy-search input:focus { outline: 2px solid rgba(255, 210, 127, 0.6); outline-offset: 1px; }
  .vy-results { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; font-size: 0.85rem; color: var(--muted); }

  .vy-chip {
    padding: 0.28rem 0.8rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; color: #FFD9A8;
    background: rgba(255, 210, 127, 0.1); border: 1px solid rgba(255, 210, 127, 0.3); transition: background 0.2s;
  }
  .vy-chip:hover { background: rgba(255, 210, 127, 0.22); }
  .vy-chip.is-small { font-size: 0.72rem; padding: 0.12rem 0.6rem; }

  .vy-hint { position: absolute; left: 0; right: 0; bottom: 0.9rem; text-align: center; font-size: 0.75rem; letter-spacing: 0.08em; color: var(--muted); pointer-events: none; }

  .vy-panel {
    position: absolute; top: 4.5rem; right: 1rem; max-height: calc(100% - 5.5rem); width: min(24rem, calc(100% - 2rem));
    overflow-y: auto; padding: 1.6rem 1.6rem 1.7rem; border-radius: 1.5rem;
    background: rgba(30, 24, 56, 0.9); backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 210, 127, 0.2); box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
  }
  .vy-close { position: absolute; top: 0.9rem; right: 0.9rem; width: 2.1rem; height: 2.1rem; border-radius: 50%; font-size: 1.3rem; line-height: 1; color: #FFD9A8; background: rgba(255, 255, 255, 0.1); }
  .vy-close:hover { background: rgba(255, 255, 255, 0.2); }
  .vy-kicker { font-size: 0.7rem; letter-spacing: 0.18em; color: #B79BE0; font-weight: 700; }
  .vy-title { font-family: var(--font-serif); font-size: 2rem; line-height: 1.1; color: var(--gold) !important; margin: 0.3rem 2rem 0.2rem 0; }
  .vy-count { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.18em; color: #B79B79; font-weight: 600; }
  .vy-goal { margin-top: 0.9rem; padding-left: 0.9rem; border-left: 2px solid rgba(255, 210, 127, 0.5); font-family: var(--font-serif); font-style: italic; font-size: 1.1rem; line-height: 1.4; color: #E7CFA9; }
  .vy-desc { margin-top: 0.9rem; font-size: 0.92rem; line-height: 1.6; color: #D9CDB8; }
  .vy-section { margin-top: 1.2rem; }
  .vy-section[hidden], .vy-goal[hidden], .vy-desc[hidden], .vy-keywords[hidden] { display: none; }
  .vy-section h3 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.18em; color: #B79B79; margin-bottom: 0.55rem; font-weight: 700; }
  .vy-kids { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .vy-people-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; padding: 0.3rem 0; font-size: 0.92rem; color: #D9CDB8; }
  .vy-person::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #FFE3B0; box-shadow: 0 0 6px 2px rgba(255, 210, 127, 0.6); margin-right: 0.6rem; vertical-align: middle; }
  .vy-also { font-size: 0.72rem; color: var(--muted); margin-left: 0.2rem; }
  .vy-keywords { margin-top: 1.2rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .vy-keywords span { font-size: 0.72rem; padding: 0.2rem 0.7rem; border-radius: 999px; color: #FFD9A8; background: rgba(255, 210, 127, 0.08); border: 1px solid rgba(255, 210, 127, 0.2); }

  .vy-tip {
    position: absolute; left: 0; top: 0; z-index: 5; pointer-events: none; display: flex; flex-direction: column; gap: 0.1rem;
    padding: 0.5rem 0.75rem; border-radius: 0.7rem; font-size: 0.78rem; color: var(--sand);
    background: rgba(30, 24, 56, 0.94); border: 1px solid rgba(255, 210, 127, 0.25); max-width: 16rem;
  }
  .vy-tip strong { font-family: var(--font-serif); font-size: 0.98rem; color: var(--gold); }
  .vy-tip em { font-style: normal; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); margin-top: 0.2rem; }
  .vy-tip-links { color: #E7CFA9; }

  @media (max-width: 899px) {
    .vy-panel { top: auto; left: 0.75rem; right: 0.75rem; bottom: 0.75rem; width: auto; max-height: 50%; }
    .vy-hero { left: 1rem; right: 1rem; bottom: 1rem; width: auto; text-align: center; }
    .vy-hero p:last-child { font-size: 0.85rem; }
    .vy-hint { display: none; }
    .vy-stage[data-scene='system'] .vy-search { display: none; }
  }
</style>
