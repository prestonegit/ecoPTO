---
// PROTOTYPE: a GSAP-driven "world of circles". Not linked from the nav, excluded from the
// sitemap, and marked noindex. Nesting and shared members come from prototypeWorld.js until
// the projects schema can express them.
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { buildWorld } from '../components/circles/prototypeWorld.js';

const projects = (await getCollection('projects')).map((p) => ({
  ...p,
  data: {
    ...p.data,
    goalHtml: p.data.goal ? marked.parse(p.data.goal) : '',
    descriptionHtml: p.data.description ? marked.parse(p.data.description) : '',
  },
}));
const world = buildWorld(projects);
---

<Layout title="Our Circles">
  <meta name="robots" content="noindex" slot="head" />
  <section class="cw-stage" data-circles-world data-world={JSON.stringify(world)}>
    <svg class="cw-svg" viewBox="-500 -500 1000 1000" preserveAspectRatio="xMidYMid meet" role="group" aria-label="Map of ecoPTO circles">
      <defs>
        <radialGradient id="cw-sun-fill" cx="40%" cy="35%" r="70%">
          <stop offset="0" stop-color="#FDBA74" />
          <stop offset="0.55" stop-color="#F97316" />
          <stop offset="1" stop-color="#EA580C" />
        </radialGradient>
      </defs>
      <g class="cw-camera"></g>
    </svg>

    <div class="cw-hero">
      <h1>Our Circles</h1>
      <p>ecoPTO is a little solar system. Every team is a planet, its projects are moons, and the people who belong to more than one circle travel between them.</p>
    </div>

    <div class="cw-hud">
      <nav class="cw-crumbs" aria-label="Where you are" hidden></nav>
      <div class="cw-search">
        <label for="cw-search" class="sr-only">Search circles and people</label>
        <input id="cw-search" type="search" placeholder="Find a team or a person…" autocomplete="off" />
        <div class="cw-results" aria-live="polite"></div>
      </div>
    </div>

    <p class="cw-hint">Click a planet to visit · Esc or click empty space to head back</p>

    <aside class="cw-panel" aria-hidden="true" aria-label="Circle details">
      <button type="button" class="cw-close" aria-label="Head back out">×</button>
      <p class="cw-kicker"></p>
      <h2 class="cw-title"></h2>
      <div class="cw-section cw-goal"></div>
      <div class="cw-section cw-desc"></div>
      <div class="cw-section"><h3>Projects</h3><div class="cw-kids"></div></div>
      <div class="cw-section"><h3>People</h3><ul class="cw-people-list"></ul></div>
      <div class="cw-section cw-keywords"></div>
    </aside>

    <div class="cw-tip" aria-hidden="true"></div>
  </section>

  <!-- The same map as plain nested lists, for screen readers and anyone without JS. -->
  <nav class="sr-only" aria-label="All circles">
    <ul>
      {world.root.children.map((c) => (
        <li>
          {c.title}: {c.people.join(', ')}
          {c.children.length > 0 && (
            <ul>{c.children.map((s) => <li>{s.title}: {s.people.join(', ')}</li>)}</ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</Layout>

<script>
  import { mountWorld } from '../components/circles/world.js';

  let destroy: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-circles-world]');
    if (el) destroy = mountWorld(el, JSON.parse(el.dataset.world!));
  });
  document.addEventListener('astro:before-swap', () => {
    destroy?.();
    destroy = null;
  });
</script>

<style is:global>
  .cw-stage {
    --ink: #3a2a22;
    --ink-soft: #7b6a60;
    --line: rgba(176, 91, 59, 0.22);
    position: relative;
    height: calc(100svh - 4.5rem);
    min-height: 560px;
    overflow: hidden;
    color: var(--ink);
    background:
      radial-gradient(circle at 50% 50%, #fff4e8 0%, #fbf6f0 45%, #f6efe7 100%);
    font-family: var(--font-sans);
  }
  .cw-svg { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: manipulation; }

  /* orbits */
  .cw-orbit, .cw-moon-orbit { fill: none; stroke: var(--line); stroke-width: 1.2; stroke-dasharray: 2 5; vector-effect: non-scaling-stroke; }
  .cw-moon-orbit { stroke: rgba(176, 91, 59, 0.16); }

  /* bodies */
  .cw-body { cursor: pointer; outline: none; }
  .cw-planet .cw-shape, .cw-moon .cw-shape { filter: drop-shadow(0 3px 5px rgba(90, 50, 30, 0.18)); }
  .cw-sun-glow { fill: #FDBA74; pointer-events: none; }
  .cw-ring { fill: none; stroke: var(--primary, #B05B3B); stroke-width: 2.5; vector-effect: non-scaling-stroke; opacity: 0; pointer-events: none; }
  .cw-body:focus-visible .cw-ring { opacity: 1 !important; }
  .cw-label { fill: #fff; font-weight: 700; pointer-events: none; user-select: none; letter-spacing: -0.01em; }
  .cw-moon-label { fill: var(--ink); font-weight: 600; pointer-events: none; user-select: none; opacity: 0; }

  /* people */
  .cw-person { cursor: pointer; }
  .cw-person circle { stroke: #fff; stroke-width: 1; vector-effect: non-scaling-stroke; transition: fill 0.3s; }
  .cw-person.is-hot circle { fill: var(--primary, #B05B3B); }
  .cw-traveller-halo { fill: rgba(244, 174, 133, 0.28); stroke: none !important; }
  .cw-name { fill: var(--ink-soft); font-weight: 600; pointer-events: none; user-select: none; opacity: 0; }
  .cw-thread { fill: none; stroke: #F4AE85; stroke-width: 1.3; stroke-dasharray: 3 4; vector-effect: non-scaling-stroke; opacity: 0.2; transition: opacity 0.3s, stroke 0.3s; pointer-events: none; }
  .cw-thread.is-hot { opacity: 1; stroke: var(--primary, #B05B3B); }

  /* chrome */
  .cw-stage h1, .cw-stage h2, .cw-stage h3 { color: inherit; }
  .cw-hero { position: absolute; left: 2rem; bottom: 2.5rem; width: min(21rem, calc(100% - 2rem)); pointer-events: none; }
  .cw-hero h1 { color: var(--primary, #B05B3B); font-family: var(--font-serif); font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; line-height: 1.05; }
  .cw-hero p { margin-top: 0.6rem; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; }

  .cw-hud { position: absolute; top: 1rem; left: 1rem; right: 1rem; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; pointer-events: none; }
  .cw-hud > * { pointer-events: auto; }
  .cw-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 0.35rem; font-size: 0.9rem; }
  .cw-crumbs[hidden] { display: none; }
  .cw-crumbs button { color: var(--ink-soft); padding: 0.35rem 0.8rem; border-radius: 999px; background: #fff; box-shadow: 0 1px 3px rgba(90, 50, 30, 0.12); transition: color 0.2s; }
  .cw-crumbs button:hover { color: var(--primary, #B05B3B); }
  .cw-crumbs button[aria-current] { color: var(--ink); font-weight: 700; }
  .cw-sep { color: var(--ink-soft); }

  .cw-search { width: min(19rem, 100%); margin-left: auto; }
  .cw-search input { width: 100%; padding: 0.65rem 1.1rem; border-radius: 999px; font-size: 0.92rem; background: #fff; border: 1px solid #eadfd6; box-shadow: 0 1px 4px rgba(90, 50, 30, 0.08); }
  .cw-search input:focus { outline: 2px solid var(--primary, #B05B3B); outline-offset: 1px; }
  .cw-results { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; font-size: 0.85rem; color: var(--ink-soft); }

  .cw-chip { --c: #B05B3B; padding: 0.3rem 0.75rem; border-radius: 999px; font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--c); transition: transform 0.15s, filter 0.15s; }
  .cw-chip:hover { transform: translateY(-1px); filter: brightness(1.08); }
  .cw-chip.is-small { font-size: 0.74rem; padding: 0.15rem 0.6rem; }

  .cw-hint { position: absolute; left: 0; right: 0; bottom: 0.9rem; text-align: center; font-size: 0.78rem; color: var(--ink-soft); pointer-events: none; }

  .cw-panel {
    --c: #B05B3B;
    position: absolute; top: 4.5rem; right: 1rem; max-height: calc(100% - 5.5rem); width: min(25rem, calc(100% - 2rem));
    overflow-y: auto; padding: 1.5rem 1.5rem 1.6rem;
    background: #fff; border-radius: 1.1rem; box-shadow: 0 12px 40px rgba(90, 50, 30, 0.14);
    border-top: 5px solid var(--c);
  }
  .cw-close { position: absolute; top: 0.8rem; right: 0.9rem; width: 2rem; height: 2rem; border-radius: 50%; font-size: 1.35rem; line-height: 1; color: var(--ink-soft); background: #f6efe9; }
  .cw-close:hover { color: var(--ink); }
  .cw-kicker { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--c); font-weight: 700; }
  .cw-title { font-family: var(--font-serif); font-size: 1.9rem; line-height: 1.15; margin: 0.25rem 2rem 0.8rem 0; }
  .cw-section { margin-top: 0.9rem; font-size: 0.93rem; line-height: 1.6; color: #5a4a41; }
  .cw-section[hidden] { display: none; }
  .cw-goal { font-size: 1.02rem; color: var(--ink); font-weight: 500; }
  .cw-section h3 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-soft); margin-bottom: 0.5rem; font-weight: 700; }
  .cw-kids { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cw-people-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; padding: 0.35rem 0; border-bottom: 1px solid #f1e8e1; }
  .cw-person-name::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #F4AE85; margin-right: 0.5rem; vertical-align: middle; }
  .cw-also { font-size: 0.74rem; color: var(--ink-soft); margin-left: 0.2rem; }
  .cw-keywords { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cw-keywords span { font-size: 0.75rem; padding: 0.15rem 0.6rem; border-radius: 999px; background: #f6efe9; color: var(--ink-soft); }

  .cw-tip { position: absolute; left: 0; top: 0; pointer-events: none; z-index: 5; padding: 0.3rem 0.7rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 600; white-space: nowrap; background: #fff; color: var(--ink); box-shadow: 0 4px 14px rgba(90, 50, 30, 0.16); }

  @media (max-width: 899px) {
    .cw-panel { top: auto; left: 0.75rem; right: 0.75rem; bottom: 0.75rem; width: auto; max-height: 52%; }
    .cw-hero { left: 1rem; right: 1rem; bottom: 1rem; width: auto; text-align: center; }
    .cw-hero p { font-size: 0.85rem; }
    .cw-hint { display: none; }
  }
</style>
