---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Parent Petition: Intentional Tech | ecoPTO">
  <!-- Prototype Switcher Banner -->
  <div class="bg-stone-100 border-b border-[#E5D6C7] py-2 px-4 text-center text-xs sm:text-sm text-text-secondary flex items-center justify-center gap-2">
    <span>Prefer testing the hardware simulation?</span>
    <span class="text-[#D4C3B2]">&middot;</span>
    <a href="/petitionprototype" class="font-semibold text-primary hover:underline">View Laptop Simulator Prototype &rarr;</a>
  </div>

  <!-- ========================================== -->
  <!-- Big & Bold Hero Section                    -->
  <!-- ========================================== -->
  <section class="bg-[#FAF7F2] border-b border-[#E5D6C7] py-16 sm:py-24">
    <div class="container mx-auto px-6 max-w-4xl text-center sm:text-left">

      <h1 class="font-serif font-bold text-primary tracking-tight text-5xl sm:text-6xl md:text-7xl mb-6 leading-[1.08]">
        Screens down.<br class="hidden sm:block" />Pencils up.
      </h1>

      <p class="text-xl sm:text-2xl text-text-primary font-normal leading-relaxed max-w-4xl mb-8">
        We applaud Superintendent Treece&rsquo;s vision to curb classroom device use. Now, let&rsquo;s back that vision with five actionable, common-sense district milestones.
      </p>

      <!-- CTA Row -->
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
        <a 
          href="https://docs.google.com/forms/d/e/1FAIpQLSesXReJQFHeyrAkUoZwhCmavNcOXENg-jN5mx21ZaFbsf_O2A/viewform" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-action bg-primary hover:bg-[#8A3E22] text-white text-base sm:text-lg w-full sm:w-auto text-center shadow-md flex items-center justify-center gap-2"
        >
          <span>Sign the Petition on Google Forms</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <a 
          href="#chromebook-interactive" 
          class="px-6 py-3 text-text-secondary hover:text-primary font-bold text-sm sm:text-base transition-colors flex items-center gap-1.5 min-h-[48px]"
        >
          <span>See How Screens Impact Our Kids &darr;</span>
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="mt-8 pt-6 border-t border-[#E5D6C7]/70 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-text-secondary">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span>Takes under 60 seconds</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span>IEP &amp; 504 Accommodations Protected</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span>Organized by HVRSD Parents</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ======================================================== -->
  <!-- ⚡ THE STUDENT REALITY EXPERIENCE: SCREEN VS ANALOG      -->
  <!-- ======================================================== -->
  <section id="chromebook-interactive" class="scroll-mt-16 pt-3 sm:pt-4 pb-12 sm:pb-16">
    <div class="container mx-auto px-4 sm:px-6 max-w-4xl">

      <!-- Section Heading -->
      <div id="interactive-heading" class="text-center max-w-2xl mx-auto mb-6 sm:mb-8 select-none">
        <h2 class="font-serif font-bold text-primary tracking-tight text-2xl sm:text-3xl md:text-4xl mb-2 sm:mb-2.5">
          A Day in the Life of an HVRSD Student
        </h2>
        <p class="text-sm sm:text-base md:text-lg text-text-secondary leading-relaxed">
          See how routine school screen time saturates each part of our children&rsquo;s day &mdash; then tap <strong class="text-text-primary">Screens Down &darr;</strong> to experience the focused analog balance.
        </p>
      </div>

      <!-- Unified Photographic Reality Card -->
      <article id="reality-stage" class="w-full bg-[#FAF7F2] rounded-3xl overflow-hidden border-2 border-[#E5D6C7] shadow-xl">

        <!-- Full-Bleed 16:9 Photographic Window -->
        <div class="relative w-full aspect-[16/9] overflow-hidden bg-stone-900 select-none">
          <img 
            id="stage-photo" 
            src="/images/digital-morning-desk.jpg" 
            alt="Current school screen reality" 
            class="w-full h-full object-cover block transition-opacity duration-300"
            fetchpriority="high"
            loading="eager"
          />
          <!-- Multi-stop gradient overlay for contrast, depth, and legibility -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-black/45 pointer-events-none"></div>

          <!-- Top Badges / Indicators Overlay -->
          <div class="absolute top-3 inset-x-3 sm:top-4 sm:inset-x-5 flex items-center justify-between pointer-events-none z-20">
            <!-- Mode Badge -->
            <div id="stage-mode-badge" class="pointer-events-auto bg-black/65 backdrop-blur-md border border-amber-500/40 px-3 py-1.5 rounded-full text-xs font-bold tracking-wide flex items-center gap-2 shadow-md text-amber-300">
              <span id="stage-mode-dot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <span id="stage-mode-text">Screen Reality</span>
            </div>

            <!-- Step Counter -->
            <div id="stage-step-counter" class="pointer-events-auto bg-black/65 backdrop-blur-md border border-white/20 px-3 py-1.5 rounded-full text-xs font-mono font-semibold text-white/85 shadow-md">
              1 of 4
            </div>
          </div>

          <!-- ============================================== -->
          <!-- FLOATING NOTIFICATION CHAOS LAYER (DIGITAL ONLY)-->
          <!-- ============================================== -->
          <div id="digital-chaos-layer" class="absolute inset-0 pointer-events-none z-10 p-3 sm:p-5 transition-opacity duration-300">
            
            <!-- Top Right Floating Distraction Toast -->
            <div id="chaos-toast-top" class="absolute top-12 sm:top-14 right-3 sm:right-6 max-w-[220px] sm:max-w-xs bg-slate-950/85 backdrop-blur-md border border-amber-500/35 rounded-xl p-2.5 sm:p-3 text-white shadow-2xl transition-all duration-300">
              <div class="flex items-center justify-between gap-2 mb-1">
                <div class="flex items-center gap-1.5 min-w-0">
                  <span id="chaos-dot-top" class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse flex-shrink-0"></span>
                  <span id="chaos-source-top" class="text-[10px] sm:text-[11px] font-bold text-amber-400 uppercase tracking-wider truncate">Educational Games</span>
                </div>
                <span id="chaos-time-top" class="text-[9px] sm:text-[10px] text-gray-400 font-mono flex-shrink-0">now</span>
              </div>
              <p id="chaos-msg-top" class="text-xs sm:text-sm text-gray-200 leading-snug m-0 font-sans">
                Daily math puzzle unlocked in background tab.
              </p>
            </div>

            <!-- Bottom Left Floating Distraction Toast -->
            <div id="chaos-toast-bottom" class="absolute bottom-16 sm:bottom-20 left-3 sm:left-6 max-w-[220px] sm:max-w-xs bg-slate-950/85 backdrop-blur-md border border-indigo-500/35 rounded-xl p-2.5 sm:p-3 text-white shadow-2xl transition-all duration-300 hidden sm:block">
              <div class="flex items-center justify-between gap-2 mb-1">
                <div class="flex items-center gap-1.5 min-w-0">
                  <span id="chaos-dot-bottom" class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse flex-shrink-0"></span>
                  <span id="chaos-source-bottom" class="text-[10px] sm:text-[11px] font-bold text-indigo-400 uppercase tracking-wider truncate">Discord · Web Client</span>
                </div>
                <span id="chaos-time-bottom" class="text-[9px] sm:text-[10px] text-gray-400 font-mono flex-shrink-0">1m ago</span>
              </div>
              <p id="chaos-msg-bottom" class="text-xs sm:text-sm text-gray-200 leading-snug m-0 font-sans">
                New message in #homework-chat: "Anyone finish #4?"
              </p>
            </div>

          </div>

          <!-- Embedded Time Navigation HUD -->
          <div class="absolute bottom-3 inset-x-3 sm:bottom-4 sm:inset-x-5 flex items-center justify-between gap-2 pointer-events-none z-20">
            <!-- Left: Prev Checkpoint -->
            <button 
              type="button" 
              id="stage-prev-btn"
              onclick="goToPrevStep()" 
              class="pointer-events-auto group bg-black/75 hover:bg-black/90 backdrop-blur-md text-white border border-white/25 hover:border-white/50 px-2.5 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-semibold transition-all shadow-lg active:scale-95 flex items-center gap-1 sm:gap-1.5 cursor-pointer flex-shrink-0"
              title="Previous Time Checkpoint"
            >
              <span class="text-white/70 group-hover:text-white transition-transform group-hover:-translate-x-0.5">&larr;</span>
              <span id="stage-prev-label">8:00 AM</span>
            </button>

            <!-- Center: Active Time Pill -->
            <div class="pointer-events-auto bg-black/80 backdrop-blur-md border border-white/30 text-white px-2.5 sm:px-5 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-bold tracking-wide shadow-lg flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
              <span id="stage-pill-dot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <span id="stage-pill-time" class="font-sans">
                <span id="stage-pill-time-short" class="inline sm:hidden">8:00 AM</span>
                <span id="stage-pill-time-full" class="hidden sm:inline">8:00 AM &middot; Morning Reading</span>
              </span>
            </div>

            <!-- Right: Next Checkpoint -->
            <button 
              type="button" 
              id="stage-next-btn"
              onclick="goToNextStep()" 
              class="pointer-events-auto group bg-black/75 hover:bg-black/90 backdrop-blur-md text-white border border-white/25 hover:border-white/50 px-2.5 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-semibold transition-all shadow-lg active:scale-95 flex items-center gap-1 sm:gap-1.5 cursor-pointer flex-shrink-0"
              title="Next Time Checkpoint"
            >
              <span id="stage-next-label">1:15 PM</span>
              <span class="text-white/70 group-hover:text-white transition-transform group-hover:translate-x-0.5">&rarr;</span>
            </button>
          </div>
        </div>

        <!-- Focused Reality Narrative Body -->
        <div class="p-6 sm:p-9 bg-[#FAF7F2]">

          <!-- Heading -->
          <h3 id="stage-heading" class="font-serif text-2xl sm:text-3xl font-bold text-text-primary mb-2.5 leading-snug">
            Chronic Tab-Switching &amp; Cognitive Fatigue
          </h3>

          <!-- Description -->
          <p id="stage-desc" class="text-base sm:text-lg text-text-primary leading-relaxed mb-5 font-normal">
            Students open school-issued screens for basic reading. Multi-tab browsing, passive notification checking, and digital eye strain fragment deep comprehension.
          </p>

          <!-- Problem / Milestone Callout Box -->
          <div id="stage-pill-box" class="w-full text-xs sm:text-sm font-medium px-4 py-3 rounded-xl mb-6 flex items-start gap-2.5 shadow-sm bg-[#231215] border border-[#7A2424]/75 text-rose-100 transition-all">
            <span id="stage-pill-text">Screen time unmeasured; physical reading displaced.</span>
          </div>

          <!-- Action / Mode Toggle Row -->
          <div class="pt-5 border-t border-[#E5D6C7] flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            
            <!-- Primary Toggle / Screens Down Button -->
            <button 
              type="button" 
              id="stage-toggle-btn"
              onclick="toggleRealityMode()" 
              class="bg-[#1F2533] hover:bg-[#2A3446] active:scale-[0.98] text-white text-sm sm:text-base font-bold py-3.5 px-6 rounded-xl border border-white/20 shadow-md flex items-center justify-center gap-2.5 cursor-pointer transition-all"
            >
              <span id="stage-toggle-icon">&darr;</span>
              <span id="stage-toggle-label">Screens Down (See Analog Alternative)</span>
            </button>

            <!-- Sign Petition on Google Forms Button -->
            <a 
              id="stage-sign-btn"
              href="https://docs.google.com/forms/d/e/1FAIpQLSesXReJQFHeyrAkUoZwhCmavNcOXENg-jN5mx21ZaFbsf_O2A/viewform" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-action bg-primary hover:bg-[#8A3E22] active:scale-[0.98] text-white text-sm sm:text-base font-bold py-3.5 px-6 rounded-xl shadow-md flex items-center justify-center gap-2 transition-all"
            >
              <span>Sign the Petition on Google Forms</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>

          </div>

        </div>

      </article>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- The Catalyst Statement: Superintendent's Vision -->
  <!-- ========================================== -->
  <section id="superintendent-vision" class="py-16 sm:py-24 border-b border-[#E5D6C7] bg-[#FAF7F2]">
    <div class="container mx-auto px-6 max-w-4xl">
      
      <div class="bg-white p-8 sm:p-14 rounded-3xl border border-[#E5D6C7] shadow-sm">

        <!-- Narrative Context & Background -->
        <div class="mb-8 space-y-3">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-text-primary tracking-tight">
            A Superintendent Calling for Focus. A Community Ready to Stand With Her.
          </h2>
          <p class="text-base sm:text-lg text-text-secondary leading-relaxed font-normal">
            On August 27, 2026, Superintendent Dr. Rosetta Treece addressed Hopewell Valley families with a clear, forward-looking perspective: our schools must prioritize human connection, handwriting, and independent critical thinking over passive digital consumption. Parents across our six schools wholeheartedly agree. This petition is our community&rsquo;s initiative to help turn her leadership into binding, measurable school board policy.
          </p>
        </div>

        <!-- Featured Quote Block -->
        <div class="relative pl-6 sm:pl-8 border-l-4 border-primary/80 my-8 py-1 bg-[#FAF7F2]/40 rounded-r-2xl pr-4">
          <blockquote class="font-serif italic text-xl sm:text-2xl lg:text-3xl text-primary leading-relaxed">
            &ldquo;...limiting student technology use in our primary grades, prioritizing face-to-face interaction, meaningful relationships, and active engagement in learning... not to have technology do the thinking and problem-solving for [students across all grade levels].&rdquo;
          </blockquote>
        </div>

        <!-- Speaker Attribution & Bridge to Milestones -->
        <div class="pt-6 border-t border-[#E5D6C7]/70 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="font-bold text-text-primary text-base sm:text-lg">Dr. Rosetta Treece</div>
            <div class="text-xs sm:text-sm text-text-secondary mt-0.5">Superintendent, Hopewell Valley Regional School District</div>
            <div class="text-xs text-text-secondary/80 font-mono mt-4 pt-2 border-t border-[#E5D6C7]/60">
              Welcome Back Address to Families &middot; August 27, 2026
            </div>
          </div>

          <a 
            href="#five-milestones" 
            class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-[#8A3E22] transition-colors group"
          >
            <span>See the 5 Action Milestones</span>
            <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- The 5 Action Milestones (Big & Bold)       -->
  <!-- ========================================== -->
  <section id="five-milestones" class="py-16 sm:py-24 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      
      <div class="mb-14">
        <h2 class="font-serif font-bold text-text-primary text-3xl sm:text-4xl mb-4">
          Five Actionable Milestones
        </h2>
        <p class="text-lg text-text-secondary leading-relaxed">
          Translating Dr. Treece&rsquo;s statement into concrete, measurable school district policy:
        </p>
      </div>

      <div class="space-y-12">
        
        <!-- Milestone 1 -->
        <article class="p-8 sm:p-10 rounded-3xl bg-[#FAF7F2] border border-[#EFE7DF] transition-all hover:border-[#E5D6C7]">
          <div class="flex items-baseline gap-4 mb-3">
            <span class="font-serif text-3xl sm:text-4xl font-bold text-primary">01</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-text-primary">
              Analog-First Learning by Default
            </h3>
          </div>
          <p class="text-lg text-text-primary font-medium mb-4">
            Physical books and handwriting first. Devices only when a lesson specifically requires digital tools.
          </p>
          <div class="text-sm text-text-secondary leading-relaxed space-y-2 border-t border-[#E5D6C7]/60 pt-4">
            <p>
              Reading physical books and writing by hand significantly increases comprehension, memory retention, and mental focus.
            </p>
          </div>
        </article>

        <!-- Milestone 2 -->
        <article class="p-8 sm:p-10 rounded-3xl bg-[#FAF7F2] border border-[#EFE7DF] transition-all hover:border-[#E5D6C7]">
          <div class="flex items-baseline gap-4 mb-3">
            <span class="font-serif text-3xl sm:text-4xl font-bold text-primary">02</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-text-primary">
              Transparent Device Screen Time Tracking
            </h3>
          </div>
          <p class="text-lg text-text-primary font-medium mb-4">
            Measure how much time students actually spend on school screens, and share the data with parents.
          </p>
          <div class="text-sm text-text-secondary leading-relaxed border-t border-[#E5D6C7]/60 pt-4">
            <p>
              Modeled after the Los Angeles Unified School District: we currently have no data on total daily device exposure in Hopewell classrooms.
            </p>
          </div>
        </article>

        <!-- Milestone 3 -->
        <article class="p-8 sm:p-10 rounded-3xl bg-[#FAF7F2] border border-[#EFE7DF] transition-all hover:border-[#E5D6C7]">
          <div class="flex items-baseline gap-4 mb-3">
            <span class="font-serif text-3xl sm:text-4xl font-bold text-primary">03</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-text-primary">
              Daily Grade-Level Screen Time Limits
            </h3>
          </div>
          <p class="text-lg text-text-primary font-medium mb-6">
            Establish healthy, enforceable daily limits across each grade tier:
          </p>
          
          <!-- Open Typographic Tier Matrix -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 py-4 border-t border-b border-[#E5D6C7]/60 mb-6">
            <div class="text-left sm:text-center">
              <div class="text-xs uppercase tracking-wider font-bold text-text-secondary mb-1">PreK &ndash; 2nd Grade</div>
              <div class="font-serif text-2xl font-bold text-primary mb-1">0 Minutes</div>
              <div class="text-xs text-text-secondary">Fully screen-free primary learning</div>
            </div>
            <div class="text-left sm:text-center sm:border-l sm:border-r sm:border-[#E5D6C7]/60 sm:px-4">
              <div class="text-xs uppercase tracking-wider font-bold text-text-secondary mb-1">3rd &ndash; 5th Grade</div>
              <div class="font-serif text-2xl font-bold text-primary mb-1">&le; 30 Min / Day</div>
              <div class="text-xs text-text-secondary">Occasional instructional use only</div>
            </div>
            <div class="text-left sm:text-center">
              <div class="text-xs uppercase tracking-wider font-bold text-text-secondary mb-1">6th &ndash; 12th Grade</div>
              <div class="font-serif text-2xl font-bold text-primary mb-1">&le; 45 Min / Day*</div>
              <div class="text-xs text-text-secondary">Balanced middle &amp; high school cap</div>
            </div>
          </div>

          <div class="text-xs text-text-secondary leading-relaxed">
            <strong class="text-primary">* Reasonable exemptions apply:</strong> Courses where technology is the core subject (Computer Science, Robotics, Keyboarding, Digital Art) are exempt. Case-by-case academic exceptions permitted.
          </div>
        </article>

        <!-- Milestone 4 -->
        <article class="p-8 sm:p-10 rounded-3xl bg-[#FAF7F2] border border-[#EFE7DF] transition-all hover:border-[#E5D6C7]">
          <div class="flex items-baseline gap-4 mb-3">
            <span class="font-serif text-3xl sm:text-4xl font-bold text-primary">04</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-text-primary">
              End Routine Take-Home Chromebooks
            </h3>
          </div>
          <p class="text-lg text-text-primary font-medium mb-4">
            Homework should be analog by default. Devices stay at school unless a family requests otherwise.
          </p>
          <div class="text-sm text-text-secondary leading-relaxed border-t border-[#E5D6C7]/60 pt-4">
            <blockquote class="italic text-text-primary mb-2">
              &ldquo;Mandatory take-home devices can function as an educational Trojan horse, bringing digital distraction into our homes under the mantle of required homework&mdash;undermining bedtime, outdoor play, and family dinners.&rdquo;
            </blockquote>
          </div>
        </article>

        <!-- Milestone 5 -->
        <article class="p-8 sm:p-10 rounded-3xl bg-[#FAF7F2] border border-[#EFE7DF] transition-all hover:border-[#E5D6C7]">
          <div class="flex items-baseline gap-4 mb-3">
            <span class="font-serif text-3xl sm:text-4xl font-bold text-primary">05</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-text-primary">
              Form a District Working Group Within 60 Days
            </h3>
          </div>
          <p class="text-lg text-text-primary font-medium mb-4">
            Convene parents, teachers, and administrators to translate these goals into formal HVRSD district policy.
          </p>
          <div class="text-sm text-text-secondary leading-relaxed border-t border-[#E5D6C7]/60 pt-4">
            <p>
              A structured, collaborative pathway ensures timely progress, practical support for teachers, and sustained community dialogue.
            </p>
          </div>
        </article>

      </div>

      <!-- Accommodations Notice -->
      <div class="mt-10 p-6 rounded-2xl bg-amber-50/80 border border-amber-200 text-sm text-text-primary leading-relaxed">
        <strong class="font-bold">Accommodations Guarantee:</strong> These limits and milestones do not apply to any student with an IEP or Section 504 Plan whose accommodations require assistive technology or specialized screen tools.
      </div>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- Grand Call to Action                       -->
  <!-- ========================================== -->
  <section class="bg-primary text-white py-20 sm:py-28 relative overflow-hidden">
    <div class="container mx-auto px-6 max-w-3xl text-center relative z-10">
      <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-6 leading-tight">
        Ready to make your voice heard?
      </h2>
      <p class="text-lg sm:text-xl text-white/90 leading-relaxed mb-10 max-w-2xl mx-auto font-normal">
        Add your name to the petition. It takes less than one minute and helps demonstrate broad community consensus to our school board.
      </p>

      <!-- Main Button -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="https://docs.google.com/forms/d/e/1FAIpQLSesXReJQFHeyrAkUoZwhCmavNcOXENg-jN5mx21ZaFbsf_O2A/viewform" 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-10 py-4 bg-white hover:bg-[#FFC099] text-primary hover:text-[#703119] rounded-full font-bold text-lg sm:text-xl transition-all shadow-xl hover:scale-105 flex items-center justify-center gap-2 min-h-[56px] w-full sm:w-auto"
        >
          <span>Sign the Petition on Google Forms</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

      <!-- Attribution -->
      <div class="mt-12 text-xs text-white/70 leading-relaxed max-w-xl mx-auto border-t border-white/20 pt-8">
        Sponsored by the <strong>Beyond Screens</strong> circle of ecoPTO &middot; Authored by Hopewell parents Gabe Dominguez &amp; Sonya Cotton &middot; Questions: <a href="mailto:ecoptohvrsd@gmail.com" class="underline hover:text-white">ecoptohvrsd@gmail.com</a>
      </div>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- Floating Mobile Action Bar                 -->
  <!-- ========================================== -->
  <div class="md:hidden fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-gray-200 px-5 py-3 flex items-center justify-between z-40 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
    <div class="text-xs font-bold text-text-primary leading-tight">
      <div>Parent Petition</div>
      <div class="text-primary font-normal">Intentional Tech @ HVRSD</div>
    </div>
    <a 
      href="https://docs.google.com/forms/d/e/1FAIpQLSesXReJQFHeyrAkUoZwhCmavNcOXENg-jN5mx21ZaFbsf_O2A/viewform" 
      target="_blank" 
      rel="noopener noreferrer"
      class="bg-primary hover:bg-[#8A3E22] text-white px-5 py-2.5 rounded-full text-xs font-bold shadow-md min-h-[44px] flex items-center gap-1"
    >
      <span>Sign Now</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </a>
  </div>
</Layout>

<style>
  .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    min-height: 48px;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, background-color 0.2s ease;
  }
  @media (min-width: 640px) {
    .btn-action {
      padding: 1rem 2.5rem;
      min-height: 52px;
    }
  }
  .btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(176, 91, 59, 0.3);
  }
  .btn-action:active {
    transform: translateY(0);
  }

  /* Smooth transitions for reality stage */
  #digital-chaos-layer {
    transition: opacity 0.3s ease;
  }
</style>

<script is:inline>
  const dayScenarios = [
    {
      time: '8:00 AM',
      period: 'Morning Reading',
      screen: {
        photo: '/images/digital-morning-desk.jpg',
        title: 'Chronic Tab-Switching & Cognitive Fatigue',
        desc: 'Students open school-issued screens for basic reading. Multi-tab browsing, passive notification checking, and digital eye strain fragment deep comprehension.',
        problem: 'Screen time unmeasured; physical reading displaced.',
        chaosTop: {
          source: 'Educational Games',
          time: 'now',
          msg: 'Daily math puzzle unlocked in background tab.'
        },
        chaosBottom: {
          source: 'Discord · Web Client',
          time: '1m ago',
          msg: 'New message in #homework-chat: "Anyone finish #4?"'
        }
      },
      analog: {
        photo: '/images/analog-morning-book.jpg',
        title: 'Classrooms Grounded in Physical Books',
        desc: 'Students begin their school morning opening printed paperbacks. No browser tabs, no device notifications, and zero digital eye strain—deep reading and focus set the tone for the day.',
        milestone: 'Milestone 1: Analog-first learning default across all K-12 classrooms.'
      }
    },
    {
      time: '1:15 PM',
      period: 'Afternoon Inquiry',
      screen: {
        photo: '/images/digital-classroom-room.jpg',
        title: 'AI Shortcuts Supplanting Critical Thinking',
        desc: 'Instead of struggling through problem-solving or engaging in classroom discussion, students prompt generative tools for instant answers, eroding cognitive stamina.',
        problem: 'Classroom relationships and independent reasoning displaced.',
        chaosTop: {
          source: 'AI Writing Assistant',
          time: 'just now',
          msg: 'Want me to draft this analysis section for you?'
        },
        chaosBottom: {
          source: 'YouTube (Filtered)',
          time: '3m ago',
          msg: 'Suggested: "10 Study Hacks You Need to Try"'
        }
      },
      analog: {
        photo: '/images/analog-afternoon-chalkboard.jpg',
        title: 'Classroom Inquiry: Eyes Up & Chalkboards',
        desc: 'Students look each other in the eye, debate ideas, and solve problems collaboratively on chalkboards and paper. Technology is never used to replace teacher-led relationship and discussion.',
        milestone: "Superintendent Treece's Stated Vision: Prioritizing face-to-face interaction, meaningful relationships, and active inquiry."
      }
    },
    {
      time: '6:00 PM',
      period: 'Family Dinner & Homework',
      screen: {
        photo: '/images/digital-dinner-table.jpg',
        title: 'The Educational Trojan Horse at Dinner',
        desc: 'Mandatory take-home Chromebooks enter family homes under the banner of "homework." Open-ended browsing and games invade the dining table and family living room.',
        problem: 'Displaces family conversation, outdoor play, and screen-free evenings.',
        chaosTop: {
          source: 'District Portal',
          time: '5m ago',
          msg: 'New digital assignment posted, due tomorrow at 8:00 AM.'
        },
        chaosBottom: {
          source: 'Chess.com · Daily Blitz',
          time: '12m ago',
          msg: 'Your turn! 24 hours remaining against schoolmate.'
        }
      },
      analog: {
        photo: '/images/analog-evening-dinner.jpg',
        title: 'Screen-Free Dinner: Devices Stay at School',
        desc: 'School-issued Chromebooks remain safely in classroom charging carts overnight. Homework returns to paper worksheets, protecting family dinner conversation and screen-free evenings.',
        milestone: 'Milestone 4: Routine take-home Chromebooks eliminated; family dinnertime and living room peace protected.'
      }
    },
    {
      time: '8:30 PM',
      period: 'Bedtime & Sleep',
      screen: {
        photo: '/images/digital-bedtime-night.jpg',
        title: 'Late Night Notifications & Fragmented Sleep',
        desc: 'School devices in bedrooms emit blue light and chime with late assignments. Melatonin production is suppressed, leaving students exhausted the next morning.',
        problem: 'Blue-light sleep disruption impairs deep rest and circadian rhythm.',
        chaosTop: {
          source: 'Canvas Alert',
          time: 'now',
          msg: 'Assignment deadline in 3 hours 29 minutes.'
        },
        chaosBottom: {
          source: 'Classroom Chat',
          time: '8m ago',
          msg: 'Ben: "Did anyone figure out the last question?"'
        }
      },
      analog: {
        photo: '/images/analog-bedtime-sleep.jpg',
        title: 'Screen-Free Bedrooms: Deep Restful Sleep',
        desc: "Zero school notifications or blue-light glare in children's bedrooms. Students wind down with paperback books under warm lamplight, protecting natural melatonin and waking up refreshed.",
        milestone: 'Milestones 3 & 5: 100% screen-free evenings by default; healthy circadian rhythms restored.'
      }
    }
  ];

  let currentStep = 0;
  let isAnalogMode = false;

  function renderStage() {
    const data = dayScenarios[currentStep];
    if (!data) return;

    const photoEl = document.getElementById('stage-photo');
    const badgeEl = document.getElementById('stage-mode-badge');
    const dotEl = document.getElementById('stage-mode-dot');
    const modeTextEl = document.getElementById('stage-mode-text');
    const stepCounterEl = document.getElementById('stage-step-counter');

    const chaosLayer = document.getElementById('digital-chaos-layer');
    const chaosToastTop = document.getElementById('chaos-toast-top');
    const chaosSourceTop = document.getElementById('chaos-source-top');
    const chaosTimeTop = document.getElementById('chaos-time-top');
    const chaosMsgTop = document.getElementById('chaos-msg-top');
    const chaosToastBottom = document.getElementById('chaos-toast-bottom');
    const chaosSourceBottom = document.getElementById('chaos-source-bottom');
    const chaosTimeBottom = document.getElementById('chaos-time-bottom');
    const chaosMsgBottom = document.getElementById('chaos-msg-bottom');

    const prevBtn = document.getElementById('stage-prev-btn');
    const prevLabel = document.getElementById('stage-prev-label');
    const pillDot = document.getElementById('stage-pill-dot');
    const pillTime = document.getElementById('stage-pill-time');
    const nextBtn = document.getElementById('stage-next-btn');
    const nextLabel = document.getElementById('stage-next-label');

    const headingEl = document.getElementById('stage-heading');
    const descEl = document.getElementById('stage-desc');
    const pillBox = document.getElementById('stage-pill-box');
    const pillText = document.getElementById('stage-pill-text');

    const toggleBtn = document.getElementById('stage-toggle-btn');
    const toggleIcon = document.getElementById('stage-toggle-icon');
    const toggleLabel = document.getElementById('stage-toggle-label');
    const signBtn = document.getElementById('stage-sign-btn');

    // 1. Step Counter
    if (stepCounterEl) {
      stepCounterEl.textContent = `${currentStep + 1} of ${dayScenarios.length}`;
    }

    // 2. Navigation HUD Labels & Visibility
    const isFirst = (currentStep === 0);
    const isLast = (currentStep === dayScenarios.length - 1);

    if (prevBtn) {
      if (isFirst) {
        prevBtn.style.visibility = 'hidden';
        prevBtn.setAttribute('aria-hidden', 'true');
      } else {
        prevBtn.style.visibility = 'visible';
        prevBtn.removeAttribute('aria-hidden');
        if (prevLabel) prevLabel.textContent = dayScenarios[currentStep - 1].time;
      }
    }

    if (nextBtn) {
      if (isLast) {
        nextBtn.style.visibility = 'hidden';
        nextBtn.setAttribute('aria-hidden', 'true');
      } else {
        nextBtn.style.visibility = 'visible';
        nextBtn.removeAttribute('aria-hidden');
        if (nextLabel) nextLabel.textContent = dayScenarios[currentStep + 1].time;
      }
    }

    const pillTimeShort = document.getElementById('stage-pill-time-short');
    const pillTimeFull = document.getElementById('stage-pill-time-full');
    if (pillTimeShort) pillTimeShort.textContent = data.time;
    if (pillTimeFull) pillTimeFull.textContent = `${data.time} · ${data.period}`;

    // 3. Mode Switch: Analog vs Screen Reality
    if (isAnalogMode) {
      // Photo
      if (photoEl) {
        photoEl.src = data.analog.photo;
        photoEl.alt = data.analog.title;
      }

      // Badge
      if (badgeEl) {
        badgeEl.className = 'pointer-events-auto bg-black/65 backdrop-blur-md border border-emerald-500/40 px-3 py-1.5 rounded-full text-xs font-bold tracking-wide flex items-center gap-2 shadow-md text-emerald-300';
      }
      if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
      if (modeTextEl) modeTextEl.textContent = 'Analog Alternative';
      if (pillDot) pillDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';

      // Hide chaos toasts
      if (chaosLayer) {
        chaosLayer.style.opacity = '0';
      }

      // Content
      if (headingEl) {
        headingEl.textContent = data.analog.title;
        headingEl.className = 'font-serif text-2xl sm:text-3xl font-bold text-primary mb-2.5 leading-snug';
      }
      if (descEl) descEl.textContent = data.analog.desc;

      // Milestone Callout
      if (pillBox) {
        pillBox.className = 'w-full text-xs sm:text-sm font-medium px-4 py-3 rounded-xl mb-6 flex items-start gap-2.5 shadow-sm bg-[#EAF3EB] border border-[#A6CDB0] text-[#1E4D2B] transition-all';
      }
      if (pillText) pillText.textContent = data.analog.milestone;

      // Toggle Button
      if (toggleBtn) {
        toggleBtn.className = 'bg-[#FAF7F2] hover:bg-[#F2ECE4] active:scale-[0.98] text-text-secondary hover:text-primary text-sm sm:text-base font-bold py-3.5 px-6 rounded-xl border border-[#E5D6C7] flex items-center justify-center gap-2.5 cursor-pointer transition-all';
      }
      if (toggleIcon) toggleIcon.innerHTML = '&larr;';
      if (toggleLabel) toggleLabel.textContent = 'Compare Screen Reality';

    } else {
      // Photo
      if (photoEl) {
        photoEl.src = data.screen.photo;
        photoEl.alt = data.screen.title;
      }

      // Badge
      if (badgeEl) {
        badgeEl.className = 'pointer-events-auto bg-black/65 backdrop-blur-md border border-amber-500/40 px-3 py-1.5 rounded-full text-xs font-bold tracking-wide flex items-center gap-2 shadow-md text-amber-300';
      }
      if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
      if (modeTextEl) modeTextEl.textContent = 'Screen Reality';
      if (pillDot) pillDot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';

      // Show chaos toasts & update copy
      if (chaosLayer) {
        chaosLayer.style.opacity = '1';
      }
      if (chaosToastTop) {
        if (chaosSourceTop) chaosSourceTop.textContent = data.screen.chaosTop.source;
        if (chaosTimeTop) chaosTimeTop.textContent = data.screen.chaosTop.time;
        if (chaosMsgTop) chaosMsgTop.textContent = data.screen.chaosTop.msg;
      }
      if (chaosToastBottom) {
        if (chaosSourceBottom) chaosSourceBottom.textContent = data.screen.chaosBottom.source;
        if (chaosTimeBottom) chaosTimeBottom.textContent = data.screen.chaosBottom.time;
        if (chaosMsgBottom) chaosMsgBottom.textContent = data.screen.chaosBottom.msg;
      }

      // Content
      if (headingEl) {
        headingEl.textContent = data.screen.title;
        headingEl.className = 'font-serif text-2xl sm:text-3xl font-bold text-text-primary mb-2.5 leading-snug';
      }
      if (descEl) descEl.textContent = data.screen.desc;

      // Problem Callout
      if (pillBox) {
        pillBox.className = 'w-full text-xs sm:text-sm font-medium px-4 py-3 rounded-xl mb-6 flex items-start gap-2.5 shadow-sm bg-[#231215] border border-[#7A2424]/75 text-rose-100 transition-all';
      }
      if (pillText) pillText.textContent = data.screen.problem;

      // Toggle Button
      if (toggleBtn) {
        toggleBtn.className = 'bg-[#1F2533] hover:bg-[#2A3446] active:scale-[0.98] text-white text-sm sm:text-base font-bold py-3.5 px-6 rounded-xl border border-white/20 shadow-md flex items-center justify-center gap-2.5 cursor-pointer transition-all';
      }
      if (toggleIcon) toggleIcon.innerHTML = '&darr;';
      if (toggleLabel) toggleLabel.textContent = 'Screens Down \u2193 (See Analog Alternative)';
    }
  }

  function selectTime(step) {
    if (step < 0) step = 0;
    if (step >= dayScenarios.length) step = dayScenarios.length - 1;
    currentStep = step;
    renderStage();
  }

  function goToPrevStep() {
    if (currentStep > 0) {
      selectTime(currentStep - 1);
    }
  }

  function goToNextStep() {
    if (currentStep < dayScenarios.length - 1) {
      selectTime(currentStep + 1);
    }
  }

  function toggleRealityMode() {
    isAnalogMode = !isAnalogMode;
    renderStage();
  }

  // Window exports for inline handlers
  window.selectTime = selectTime;
  window.goToPrevStep = goToPrevStep;
  window.goToNextStep = goToNextStep;
  window.toggleRealityMode = toggleRealityMode;

  function initRealityExperience() {
    const stage = document.getElementById('reality-stage');
    if (!stage) return;

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('step')) {
      const s = parseInt(urlParams.get('step'), 10);
      if (!isNaN(s) && s >= 0 && s < dayScenarios.length) {
        currentStep = s;
      }
    }
    if (urlParams.get('analog') === '1' || urlParams.get('shut') === '1') {
      isAnalogMode = true;
    }
    renderStage();
  }

  document.addEventListener('astro:page-load', initRealityExperience);
  if (document.readyState !== 'loading') {
    initRealityExperience();
  } else {
    document.addEventListener('DOMContentLoaded', initRealityExperience);
  }
</script>
