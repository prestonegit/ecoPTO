---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const events = await getCollection('events');
---

<Layout title="Events">
  <section class="relative py-16 sm:py-24 bg-bg-secondary text-center">
    <div class="container mx-auto px-6">
      <h1 class="text-5xl font-extrabold text-primary mb-4">Upcoming Events</h1>
      <p class="text-text-secondary text-lg max-w-3xl mx-auto">
        Join us for our exciting events throughout the year! From community gatherings to educational workshops, there's something for everyone.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {events.map(event => (
          <a href={event.data.externalUrl ? event.data.externalUrl : `/events/${event.slug}`} target={event.data.externalUrl ? '_blank' : '_self'} class="bg-bg-primary p-8 rounded-xl shadow-md text-center block">
            <h3 class="text-2xl font-bold text-primary">{event.data.title}</h3>
            <p class="text-lg text-text-secondary mb-4">{event.data.description}</p>
            <span class="font-bold text-primary">
              Learn More &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>