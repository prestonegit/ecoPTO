---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EventDate from '../../components/EventDate.astro';
import {
  isUpcomingEventDate,
  sortByEventDateAscending,
  sortByEventDateDescending,
} from '../../utils/events';

const allEvents = await getCollection('events');
const eventsAscending = [...allEvents].sort(sortByEventDateAscending);
const eventsDescending = [...allEvents].sort(sortByEventDateDescending);
const initialUpcomingEvents = eventsAscending.filter((event) => isUpcomingEventDate(event.data.eventDate));
const initialPastEvents = eventsDescending.filter((event) => !isUpcomingEventDate(event.data.eventDate));
const initialUpcomingSlugs = new Set(initialUpcomingEvents.map((event) => event.slug));
const initialPastSlugs = new Set(initialPastEvents.map((event) => event.slug));
---

<Layout title="Events">
  <div data-events-page-root>
    <section class="relative py-24 bg-bg-primary overflow-hidden">
      <!-- Subtle background accent -->
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-primary opacity-5 rounded-full blur-3xl pointer-events-none"></div>
      <div class="container mx-auto px-6 relative z-10 text-center max-w-4xl">
        <h1 class="text-5xl md:text-6xl font-extrabold text-primary mb-6 leading-tight">Gather & Grow</h1>
        <p class="text-text-secondary text-xl leading-relaxed mx-auto">
          Get your hands dirty, learn something new, and connect with other families. From school garden work days to educational workshops, here's where we come together.
        </p>
      </div>
    </section>

    <section class="py-12 sm:py-16 bg-secondary">
      <div class="container mx-auto px-6">
        <div class="mt-24">
          <h2 class="text-4xl font-bold text-primary mb-8 flex items-center gap-4">
            <span class="w-8 h-1 bg-primary rounded-full"></span>
            Upcoming Events
          </h2>
          <div data-upcoming-events-list class="grid lg:grid-cols-2 gap-10">
            {eventsAscending.map(event => (
              <a
                href={event.data.externalUrl ? event.data.externalUrl : `/events/${event.slug}`}
                target={event.data.externalUrl ? '_blank' : '_self'}
                rel={event.data.externalUrl ? 'noopener noreferrer' : undefined}
                data-upcoming-event-card
                data-event-date={event.data.eventDate.toISOString()}
                class:list={[
                  'flex flex-col bg-white rounded-[2rem] border border-gray-100 shadow-md overflow-hidden hover-spring group relative',
                  !initialUpcomingSlugs.has(event.slug) && 'hidden',
                ]}
              >
                <div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none"></div>
                <div class="md:flex flex-grow z-10">
                  <div class="md:w-1/2 flex flex-col justify-center p-8 lg:p-10">
                    <h3 class="text-2xl font-bold text-primary mb-3 leading-snug group-hover:text-green-700 transition-colors">{event.data.title}</h3>
                    <div class="font-medium text-sm text-bg-primary bg-primary px-3 py-1 rounded-full inline-block w-max mb-4">
                      <EventDate date={event.data.eventDate} dateOverride={event.data.dateOverride} />
                    </div>
                    <p class="text-text-secondary leading-relaxed line-clamp-3 mb-6">{event.data.cardDescription}</p>
                    <span class="mt-auto inline-flex items-center font-bold text-primary gap-2">
                      Get the details <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </span>
                  </div>
                  {event.data.image && (
                    <div class="md:w-1/2 overflow-hidden bg-gray-50 flex items-center justify-center p-6 border-l border-gray-50">
                      <img
                        src={event.data.image}
                        alt={event.data.title}
                        class="w-full h-full object-cover rounded-2xl shadow-sm transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                  )}
                </div>
              </a>
            ))}
            <div
              data-upcoming-empty
              class:list={[
                'col-span-full bg-bg-primary rounded-2xl p-12 text-center border border-dashed border-gray-300',
                initialUpcomingEvents.length > 0 && 'hidden',
              ]}
            >
              <p class="text-xl text-text-secondary font-medium">We're planting seeds for future events. Check back soon!</p>
            </div>
          </div>
        </div>

        <div class="mt-32">
          <h2 class="text-3xl font-bold text-text-secondary mb-8 flex items-center gap-4 opacity-80">
            <span class="w-8 h-1 bg-gray-300 rounded-full"></span>
            Past Events
          </h2>
          <div data-past-events-list class="grid lg:grid-cols-2 gap-8 lg:gap-10 opacity-80 mix-blend-multiply">
            {eventsDescending.map(event => (
              <a
                href={event.data.externalUrl ? event.data.externalUrl : `/events/${event.slug}`}
                target={event.data.externalUrl ? '_blank' : '_self'}
                rel={event.data.externalUrl ? 'noopener noreferrer' : undefined}
                data-past-event-card
                data-event-date={event.data.eventDate.toISOString()}
                class:list={[
                  'flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden hover:shadow-md transition-shadow group',
                  !initialPastSlugs.has(event.slug) && 'hidden',
                ]}
              >
                <div class="md:flex flex-grow grayscale group-hover:grayscale-0 transition-all duration-500">
                  <div class="md:w-1/2 flex flex-col justify-center p-6 lg:p-8">
                    <h3 class="text-xl font-bold text-slate-700 mb-2">{event.data.title}</h3>
                    <div class="text-sm font-medium text-gray-500 mb-3">
                      <EventDate date={event.data.eventDate} dateOverride={event.data.dateOverride} />
                    </div>
                    <span class="mt-auto inline-flex items-center text-sm font-bold text-gray-500 gap-1 group-hover:text-primary transition-colors">
                      View details <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </span>
                  </div>
                </div>
              </a>
            ))}
            <p
              data-past-empty
              class:list={[
                'text-text-secondary col-span-full',
                initialPastEvents.length > 0 && 'hidden',
              ]}
            >
              No past events to show.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { isUpcomingEventDate } from '../../utils/events';

  function syncEventsPageSections() {
    const root = document.querySelector('[data-events-page-root]');

    if (!(root instanceof HTMLElement)) {
      return;
    }

    const upcomingCards = Array.from(root.querySelectorAll('[data-upcoming-event-card]'));
    const pastCards = Array.from(root.querySelectorAll('[data-past-event-card]'));
    const upcomingEmpty = root.querySelector('[data-upcoming-empty]');
    const pastEmpty = root.querySelector('[data-past-empty]');
    let visibleUpcomingCount = 0;
    let visiblePastCount = 0;

    upcomingCards.forEach((card) => {
      if (!(card instanceof HTMLElement)) {
        return;
      }

      const eventDate = card.dataset.eventDate;
      const shouldShow = Boolean(eventDate) && isUpcomingEventDate(eventDate);

      card.classList.toggle('hidden', !shouldShow);
      card.setAttribute('aria-hidden', String(!shouldShow));

      if (shouldShow) {
        visibleUpcomingCount += 1;
      }
    });

    pastCards.forEach((card) => {
      if (!(card instanceof HTMLElement)) {
        return;
      }

      const eventDate = card.dataset.eventDate;
      const shouldShow = Boolean(eventDate) && !isUpcomingEventDate(eventDate);

      card.classList.toggle('hidden', !shouldShow);
      card.setAttribute('aria-hidden', String(!shouldShow));

      if (shouldShow) {
        visiblePastCount += 1;
      }
    });

    if (upcomingEmpty instanceof HTMLElement) {
      upcomingEmpty.classList.toggle('hidden', visibleUpcomingCount > 0);
    }

    if (pastEmpty instanceof HTMLElement) {
      pastEmpty.classList.toggle('hidden', visiblePastCount > 0);
    }
  }

  syncEventsPageSections();
  document.addEventListener('astro:page-load', syncEventsPageSections);
</script>
