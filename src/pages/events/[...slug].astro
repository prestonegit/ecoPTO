---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import EventDate from '../../components/EventDate.astro';
import { buildGoogleCalendarUrl } from '../../utils/events';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

// Redirect to externalUrl if it exists
if (event.data.externalUrl) {
  return Astro.redirect(event.data.externalUrl);
}

const { Content } = await event.render();
const descriptionHTML = event.data.description ? marked.parse(event.data.description) : null;
const cardDescriptionHTML = event.data.cardDescription ? marked.parse(event.data.cardDescription) : null;
const calendarUrl = buildGoogleCalendarUrl({
  title: event.data.title,
  startDate: event.data.eventDate,
  description: event.data.description,
  location: event.data.location,
});
---

<Layout title={event.data.title}>
  <section class="py-16 sm:py-24 bg-bg-secondary">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="flex flex-col lg:flex-row gap-12 items-start">
        {event.data.image && (
          <a
            href={event.data.image}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open the full-size image for ${event.data.title}`}
            class="block w-full lg:w-1/2 rounded-lg overflow-hidden shadow-lg shrink-0 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30"
          >
            <img
              src={event.data.image}
              alt={event.data.title}
              class="block w-full h-auto"
            />
          </a>
        )}
        <div class={`w-full ${event.data.image ? 'lg:w-1/2' : ''} text-left`}>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-primary mb-6">{event.data.title}</h1>
          <div class="mb-4">
            <EventDate date={event.data.eventDate} dateOverride={event.data.dateOverride} />
          </div>
          {event.data.location && (
            <p class="text-text-secondary text-lg mb-8">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 inline-block mr-2 shrink-0 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {event.data.location}
            </p>
          )}
          
          <div class="prose prose-lg mb-8 max-w-none">
            {descriptionHTML && <div set:html={descriptionHTML} />}
            {(!descriptionHTML && !event.body?.trim()) && cardDescriptionHTML && <div set:html={cardDescriptionHTML} />}
            <Content />
          </div>

          <div class="mt-8">
            <a
              href={calendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-standard btn-secondary-color rounded-md"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 inline-block mr-2 shrink-0 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2zM12 11v6m-3-3h6" />
              </svg>
              Add to Calendar
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container mx-auto px-6 mt-8 mb-12 text-center">
    <a href="/events" class="btn-standard btn-primary-color rounded-md">
      &larr; BACK TO ALL EVENTS
    </a>
  </div>
</Layout>
