---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import EventDate from '../../components/EventDate.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

// Redirect to externalUrl if it exists
if (event.data.externalUrl) {
  return Astro.redirect(event.data.externalUrl);
}

const { Content } = await event.render();
const descriptionHTML = event.data.description ? marked.parse(event.data.description) : null;
const cardDescriptionHTML = event.data.cardDescription ? marked.parse(event.data.cardDescription) : null;
---

<Layout title={event.data.title}>
  <section class="relative py-16 sm:py-24 bg-bg-secondary text-center">
    <div class="container mx-auto px-6 text-center">
      {event.data.image && (
        <div class="mb-8 max-w-3xl mx-auto">
          <img
            src={event.data.image}
            alt={event.data.title}
            class="rounded-lg shadow-lg w-full h-auto object-cover"
          />
        </div>
      )}
      <h1 class="text-5xl font-extrabold text-primary mb-4">{event.data.title}</h1>
      <EventDate date={event.data.eventDate} dateOverride={event.data.dateOverride} />
      <p class="text-text-secondary text-lg mb-4">
        <i class="fas fa-map-marker-alt mr-2"></i>{event.data.location}
      </p>
      <div class="mt-6">
        <a
          href={`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.data.title)}&dates=${new Date(event.data.eventDate).toISOString().slice(0,10).replace(/-/g,"")}/${new Date(new Date(event.data.eventDate).setDate(new Date(event.data.eventDate).getDate() + 1)).toISOString().slice(0,10).replace(/-/g,"")}&details=${encodeURIComponent(event.data.description)}&location=${encodeURIComponent(event.data.location)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-accent hover:bg-primary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent"
        >
          <i class="fas fa-calendar-plus mr-2"></i> Add to Calendar
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container mx-auto px-6 max-w-3xl prose prose-lg mx-auto">
      {descriptionHTML && <div set:html={descriptionHTML} />}
      {(!descriptionHTML && !event.body?.trim()) && cardDescriptionHTML && <div set:html={cardDescriptionHTML} />}
      <Content />
    </div>
  </section>

  <div class="container mx-auto px-6 mt-8 mb-12 text-center">
    <a href="/events" class="btn-standard btn-primary-color rounded-md">
      &larr; BACK TO ALL EVENTS
    </a>
  </div>
</Layout>