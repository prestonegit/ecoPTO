---
import globalSettings from '../content/settings/global.json';
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Vision Mockup | ecoPTO</title>
	
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-green: #15803d; /* Tailwind green-700 */
            --brand-light: #f0fdf4; /* Tailwind green-50 */
            --brand-orange: #ea580c; /* Tailwind orange-600 */
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }
        .hero-pattern {
            background-color: #f0fdf4;
            background-image: radial-gradient(#22c55e 0.5px, transparent 0.5px), radial-gradient(#22c55e 0.5px, #f0fdf4 0.5px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
            position: relative;
        }
        .hero-pattern::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(180deg, rgba(240, 253, 244, 0) 0%, rgba(248, 250, 252, 1) 100%);
            z-index: 0;
        }
        .blob {
            position: absolute;
            filter: blur(80px);
            z-index: 0;
            opacity: 0.4;
            border-radius: 50%;
        }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- Decorative Background Blobs -->
    <div class="blob bg-green-300 w-96 h-96 top-[-10%] left-[-10%]"></div>
    <div class="blob bg-orange-200 w-96 h-96 top-[20%] right-[-10%]"></div>

	<!-- Navigation -->
	<header class="glass-nav fixed top-0 w-full z-50 transition-all duration-300">
		<nav class="container mx-auto px-6 py-4 flex flex-wrap justify-between items-center">
			<a href="#" class="flex items-center gap-2 relative z-10 group">
                <div class="w-10 h-10 bg-green-600 text-white rounded-xl flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-300 shadow-md">
                    <i class="fa-solid fa-leaf text-xl shadow-sm"></i>
                </div>
				<span class="text-2xl font-extrabold font-heading tracking-tight text-slate-800">eco<span class="text-green-600">PTO</span></span>
			</a>
			
            <!-- Desktop Menu -->
			<div class="hidden md:flex items-center gap-8 relative z-10">
                <a href="/impact" class="text-slate-600 font-medium hover:text-green-600 transition-colors">Impact</a>
                <a href="/research" class="text-slate-600 font-medium hover:text-green-600 transition-colors">Research</a>
                <a href="/events" class="text-slate-600 font-medium hover:text-green-600 transition-colors">Events</a>
				<a href="/about" class="text-slate-600 font-medium hover:text-green-600 transition-colors">About Us</a>
			</div>

            <div class="hidden md:flex items-center gap-4 relative z-10">
                <a href="#help-request" class="text-orange-600 font-semibold hover:text-orange-700 transition-colors">Help Request Form</a>
                <button class="bg-green-600 text-white font-semibold py-2.5 px-6 rounded-full hover:bg-green-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
                    Get Involved
                </button>
            </div>
		</nav>
	</header>

	<main class="flex-grow pt-24 relative z-10">
		
        <!-- Hero Section -->
        <section class="relative pt-20 pb-32 px-6 overflow-hidden hero-pattern">
            <div class="container mx-auto max-w-5xl text-center relative z-10">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-100/80 text-green-800 font-medium text-sm mb-6 shadow-sm border border-green-200 backdrop-blur-sm">
                    <span class="flex h-2 w-2 rounded-full bg-green-500"></span>
                    Supporting Hopewell Valley Regional School District
                </div>
                
                <h1 class="text-5xl md:text-7xl font-extrabold text-slate-900 mb-6 leading-tight drop-shadow-sm">
                    Cultivating a <br class="hidden md:block"/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-600 to-emerald-400">Sustainable Future</span>
                </h1>
                
                <p class="text-lg md:text-xl text-slate-600 mb-10 max-w-2xl mx-auto leading-relaxed">
                    We empower students, families, and staff to build an eco-conscious community. Together, we're bringing hands-on environmental education to life in our schools.
                </p>
                
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <button class="w-full sm:w-auto bg-green-600 text-white font-bold py-4 px-8 rounded-full shadow-xl shadow-green-600/20 hover:bg-green-700 hover:shadow-green-600/40 hover:-translate-y-1 transition-all duration-300">
                        Join Our Mission
                    </button>
                    <a href="#help-request" class="w-full sm:w-auto bg-white text-slate-700 font-bold py-4 px-8 rounded-full shadow-md border border-slate-100 hover:bg-slate-50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                        Help Request Form
                    </a>
                </div>
            </div>
        </section>

        <!-- Mission Highlights (Consolidated) -->
        <section class="py-20 bg-white relative">
            <div class="container mx-auto px-6">
                <!-- Three Pillars -->
                <div class="grid md:grid-cols-3 gap-8 -mt-32 relative z-20">
                    
                    <div class="bg-white rounded-3xl p-8 shadow-xl shadow-slate-200/50 border border-slate-100 hover:-translate-y-2 transition-transform duration-300">
                        <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center text-2xl mb-6">
                            <i class="fa-solid fa-seedling"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800 mb-3">Green Initiatives</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            From school gardens to composting programs, we fund and support projects that bring sustainability to the forefront of student life.
                        </p>
                        <a href="/impact" class="text-emerald-600 font-semibold hover:text-emerald-800 flex items-center gap-2 group">
                            Explore our Impact 
                            <i class="fa-solid fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>

                    <div class="bg-white rounded-3xl p-8 shadow-xl shadow-slate-200/50 border border-slate-100 hover:-translate-y-2 transition-transform duration-300">
                        <div class="w-14 h-14 bg-orange-100 text-orange-600 rounded-2xl flex items-center justify-center text-2xl mb-6">
                            <i class="fa-solid fa-book-open"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800 mb-3">Eco-Education</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Providing curated literature, resources, and hands-on learning opportunities to educate the next generation of environmental stewards.
                        </p>
                        <a href="/research" class="text-orange-600 font-semibold hover:text-orange-800 flex items-center gap-2 group">
                            Read the Research 
                            <i class="fa-solid fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>

                    <div class="bg-white rounded-3xl p-8 shadow-xl shadow-slate-200/50 border border-slate-100 hover:-translate-y-2 transition-transform duration-300">
                        <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center text-2xl mb-6">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800 mb-3">Community Events</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Join us for community hikes, cleanups, and green fairs. There's always a way to get outside and make a difference together.
                        </p>
                        <a href="/events" class="text-blue-600 font-semibold hover:text-blue-800 flex items-center gap-2 group">
                            View Upcoming Events
                            <i class="fa-solid fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>

                </div>
            </div>
        </section>

        <!-- Help Request Section -->
        <section id="help-request" class="py-24 bg-slate-50 relative overflow-hidden">
            <!-- Decorative Elements -->
            <div class="absolute top-0 right-0 w-64 h-64 bg-green-200/30 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-0 w-80 h-80 bg-orange-200/20 rounded-full blur-3xl"></div>
            
            <div class="container mx-auto px-6 relative z-10">
                <div class="flex flex-col lg:flex-row bg-white rounded-[2.5rem] shadow-2xl overflow-hidden border border-slate-100/50">
                    
                    <!-- Form Info Side -->
                    <div class="lg:w-2/5 bg-green-700 text-white p-12 lg:p-16 relative overflow-hidden flex flex-col justify-center">
                        <div class="absolute top-0 right-0 p-8 opacity-10">
                            <i class="fa-solid fa-chalkboard-user text-9xl"></i>
                        </div>
                        <span class="text-green-200 font-semibold tracking-wider uppercase text-sm mb-4 block">PTO Community Support</span>
                        <h2 class="text-4xl md:text-5xl font-bold font-heading mb-6 leading-tight">Need a Helping Hand?</h2>
                        <p class="text-green-100 text-lg mb-8 leading-relaxed">
                            Whether you need volunteers to chaperone a nature hike, materials for a classroom garden, or help organizing an eco-project, the ecoPTO community is here to support you.
                        </p>
                        <ul class="space-y-4 text-green-50">
                            <li class="flex items-start gap-4">
                                <i class="fa-solid fa-check-circle mt-1 text-green-300"></i>
                                <span>Fast response from our volunteer network</span>
                            </li>
                            <li class="flex items-start gap-4">
                                <i class="fa-solid fa-check-circle mt-1 text-green-300"></i>
                                <span>Access to project funding & resources</span>
                            </li>
                            <li class="flex items-start gap-4">
                                <i class="fa-solid fa-check-circle mt-1 text-green-300"></i>
                                <span>Dedicated parent coordinators for your event</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Form Input Side -->
                    <div class="lg:w-3/5 p-12 lg:p-16">
                        <h3 class="text-2xl font-bold text-slate-800 mb-8 font-heading">Submit a Support Request</h3>
                        
                        <form class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-700 ml-1">Your Name</label>
                                    <input type="text" placeholder="e.g. Jane Doe" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-base rounded-xl focus:ring-4 focus:ring-green-500/20 focus:border-green-500 block p-4 transition-all outline-none" required>
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-700 ml-1">Contact Email</label>
                                    <input type="email" placeholder="jane.doe@hvrsd.org" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-base rounded-xl focus:ring-4 focus:ring-green-500/20 focus:border-green-500 block p-4 transition-all outline-none" required>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-700 ml-1">School</label>
                                    <select class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-base rounded-xl focus:ring-4 focus:ring-green-500/20 focus:border-green-500 block p-4 transition-all outline-none appearance-none" required>
                                        <option value="" disabled selected>Select your school</option>
                                        <option>Hopewell Elementary</option>
                                        <option>Bear Tavern Elementary</option>
                                        <option>Toll Gate Grammar</option>
                                        <option>Stony Brook Elementary</option>
                                        <option>Timberlane Middle School</option>
                                        <option>Central High School</option>
                                    </select>
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-700 ml-1">When do you need help?</label>
                                    <input type="date" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-base rounded-xl focus:ring-4 focus:ring-green-500/20 focus:border-green-500 block p-4 transition-all outline-none" required>
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label class="text-sm font-semibold text-slate-700 ml-1">How can we help?</label>
                                <textarea rows="4" placeholder="Describe your project, event, or the type of volunteers you need (e.g., 'Need 4 parents to chaperone a hike to the local stream next Friday at 1PM.')" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-base rounded-xl focus:ring-4 focus:ring-green-500/20 focus:border-green-500 block p-4 transition-all outline-none resize-none" required></textarea>
                            </div>

                            <button type="submit" class="w-full sm:w-auto bg-orange-600 hover:bg-orange-700 text-white font-bold py-4 px-10 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3">
                                <span>Send Request</span>
                                <i class="fa-solid fa-paper-plane"></i>
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </section>

	</main>

	<!-- Minimal Footer -->
	<footer class="bg-slate-900 text-slate-300 py-12 border-t border-slate-800">
		<div class="container mx-auto px-6 grid md:grid-cols-4 gap-8">
            <div class="md:col-span-2">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-8 h-8 bg-green-600 text-white rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-leaf text-sm"></i>
                    </div>
                    <span class="text-xl font-bold font-heading text-white">ecoPTO</span>
                </div>
                <p class="text-slate-400 max-w-sm">
                    Empowering the Hopewell Valley Regional School District community to learn, grow, and thrive sustainably.
                </p>
            </div>
            
            <div>
                <h4 class="text-white font-bold mb-4">Quick Links</h4>
                <ul class="space-y-2">
                    <li><a href="/impact" class="hover:text-green-400 transition-colors">Impact</a></li>
                    <li><a href="/research" class="hover:text-green-400 transition-colors">Research</a></li>
                    <li><a href="/events" class="hover:text-green-400 transition-colors">Events</a></li>
                    <li><a href="/about" class="hover:text-green-400 transition-colors">About Us</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-white font-bold mb-4">Connect</h4>
                <a href="mailto:info@ecopto-hv.org" class="hover:text-green-400 transition-colors flex items-center gap-2 mb-4">
                    <i class="fa-solid fa-envelope"></i>
                    info@ecopto-hv.org
                </a>
                <div class="flex gap-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-green-600 hover:text-white transition-all text-xl"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-green-600 hover:text-white transition-all text-xl"><i class="fa-brands fa-instagram"></i></a>
                </div>
            </div>
		</div>
        <div class="container mx-auto px-6 mt-12 pt-8 border-t border-slate-800/50 text-sm text-center text-slate-500">
            &copy; {new Date().getFullYear()} Hopewell Valley ecoPTO. All rights reserved.
        </div>
	</footer>

</body>
</html>
