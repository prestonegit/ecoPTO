---
const { achievement, index } = Astro.props;
const { title, description, image, link_text, link_url, link_file } = achievement;
const isEven = index % 2 === 0;
const link = link_file || link_url;
const buttonText = link_text || "Learn More";
---

<div class="relative mb-8 flex items-center w-full">
  {isEven ? (
    <>
      <div class="w-full md:w-1/2 md:pr-8">
        <div class="bg-white p-8 lg:p-10 rounded-2xl shadow-sm border border-gray-100 hover-spring overflow-hidden group">
          {image && <img src={image} alt={title} class="w-full h-48 md:h-auto md:aspect-video object-cover rounded-xl shadow-sm mb-6" />}
          <h3 class="text-2xl font-bold text-primary mb-3 group-hover:text-green-700 transition-colors">{title}</h3>
          <p class="text-text-secondary leading-relaxed mb-6">{description}</p>
          {link && (
            <a 
              href={link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-block bg-accent text-white font-bold py-2.5 px-6 rounded-full hover-spring shadow-sm text-sm"
            >
              {buttonText}
            </a>
          )}
        </div>
      </div>
      <div class="w-full md:w-1/2 md:pl-8"></div> {/* Empty div for right column */} 
    </>
  ) : (
    <>
      <div class="w-full md:w-1/2 md:pr-8"></div> {/* Empty div for left column */} 
      <div class="w-full md:w-1/2 md:pl-8">
        <div class="bg-white p-8 lg:p-10 rounded-2xl shadow-sm border border-gray-100 hover-spring overflow-hidden group">
          {image && <img src={image} alt={title} class="w-full h-48 md:h-auto md:aspect-video object-cover rounded-xl shadow-sm mb-6" />}
          <h3 class="text-2xl font-bold text-primary mb-3 group-hover:text-green-700 transition-colors">{title}</h3>
          <p class="text-text-secondary leading-relaxed mb-6">{description}</p>
          {link && (
            <a 
              href={link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-block bg-accent text-white font-bold py-2.5 px-6 rounded-full hover-spring shadow-sm text-sm"
            >
              {buttonText}
            </a>
          )}
        </div>
      </div>
    </>
  )}
</div>