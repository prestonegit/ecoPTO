---
import { getCollection } from 'astro:content';

import EventDate from './EventDate.astro';
import { isUpcomingEventDate, sortByEventDateAscending } from '../utils/events';

const { content } = Astro.props;
const allEvents = await getCollection('events');
const sortedEvents = [...allEvents].sort(sortByEventDateAscending);
const initialVisibleEvents = sortedEvents
  .filter((event) => isUpcomingEventDate(event.data.eventDate))
  .slice(0, 4);
const initialVisibleSlugs = new Set(initialVisibleEvents.map((event) => event.slug));
---
<section id="events" data-upcoming-events-root class="py-24 bg-secondary overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl animate-on-scroll">
      <h2 class="text-5xl font-medium text-primary mb-6">{content.events_title}</h2>
      <p class="text-xl text-text-secondary leading-relaxed mb-16">
        {content.events_subtitle}
      </p>
    </div>
    <div class="mt-16 animate-on-scroll stagger-1">
      <div data-upcoming-events-list class="grid md:grid-cols-2 gap-8 lg:gap-12">
        {sortedEvents.map(event => (
          <a
            href={event.data.externalUrl ? event.data.externalUrl : `/events/${event.slug}`}
            target={event.data.externalUrl ? '_blank' : '_self'}
            data-event-card
            data-event-date={event.data.eventDate.toISOString()}
            class:list={[
              'flex flex-col rounded-xl shadow-sm overflow-hidden group bg-bg-primary',
              !initialVisibleSlugs.has(event.slug) && 'hidden',
            ]}
          >
            <div class="md:flex flex-grow">
              <div class="md:w-1/2 flex flex-col justify-center">
                <div class="p-6">
                  <h3 class="text-2xl font-bold text-primary">{event.data.title}</h3>
                  <EventDate date={event.data.eventDate} dateOverride={event.data.dateOverride} />
                  <p class="mt-2 text-text-secondary line-clamp-3">{event.data.cardDescription}</p>
                  <span class="mt-4 inline-block font-bold text-primary group-hover:underline">Learn More &rarr;</span>
                </div>
              </div>
              {event.data.image && (
                <div class="md:w-1/2 overflow-hidden aspect-[4/3] md:aspect-auto md:min-h-[250px]">
                  <img
                    src={event.data.image}
                    alt={event.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 ease-out hover:scale-105"
                  />
                </div>
              )}
            </div>
          </a>
        ))}
        <div
          data-upcoming-events-empty
          class:list={[
            'col-span-full text-center py-12 bg-bg-primary rounded-xl shadow-sm border-2 border-dashed border-secondary/30',
            initialVisibleEvents.length > 0 && 'hidden',
          ]}
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-secondary mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-xl text-primary font-semibold mb-2">No upcoming events scheduled at the moment.</p>
          <p class="text-text-secondary mb-6 max-w-md mx-auto">We are always planning new initiatives! Interested in sponsoring an event or have a collaboration idea?</p>
          <a href="#contact" class="btn-standard btn-secondary-color inline-flex items-center gap-2">
            <span>Sponsor or Collaborate</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
      <div class="mt-12 text-center">
        <a href="/events" class="btn-standard btn-primary-color">
          View all events
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { isUpcomingEventDate } from '../utils/events';

  function syncUpcomingEvents() {
    const root = document.querySelector('[data-upcoming-events-root]');

    if (!(root instanceof HTMLElement)) {
      return;
    }

    const cards = Array.from(root.querySelectorAll('[data-event-card]'));
    const emptyState = root.querySelector('[data-upcoming-events-empty]');
    let visibleCount = 0;

    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) {
        return;
      }

      const eventDate = card.dataset.eventDate;
      const shouldShow = Boolean(eventDate) && isUpcomingEventDate(eventDate) && visibleCount < 4;

      card.classList.toggle('hidden', !shouldShow);
      card.setAttribute('aria-hidden', String(!shouldShow));

      if (shouldShow) {
        visibleCount += 1;
      }
    });

    if (emptyState instanceof HTMLElement) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
  }

  syncUpcomingEvents();
  document.addEventListener('astro:page-load', syncUpcomingEvents);
</script>
