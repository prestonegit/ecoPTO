---
// src/components/UpcomingEvents.astro
import { getCollection } from 'astro:content';

// Fetch all events and sort them by date
const allEvents = await getCollection('events');
const sortedEvents = allEvents.sort((a, b) => new Date(a.data.eventDate) - new Date(b.data.eventDate));
---
<section id="events" class="py-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-green-900 text-center">Upcoming Events</h2>
    <p class="mt-4 text-lg text-gray-600 text-center">
      Join us for workshops, community actions, and family-friendly events.
    </p>
    <div class="mt-12 grid md:grid-cols-2 gap-8">
      {sortedEvents.map(event => (
        <a href={`/events/${event.slug}`} class="block bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow overflow-hidden">
          <img src={event.data.image} alt={event.data.title} class="w-full h-56 object-cover" />
          <div class="p-6">
            <p class="text-gray-500">{new Date(event.data.eventDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
            <h3 class="mt-2 text-2xl font-bold text-green-900">{event.data.title}</h3>
            <p class="mt-4 text-gray-700">{event.data.description}</p>
            <span class="mt-6 inline-block font-bold text-green-600 hover:text-green-800">Learn More →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>