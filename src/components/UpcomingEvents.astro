---
import { getCollection } from 'astro:content';
import EventCard from './EventCard.astro'; // Import EventCard
import VolunteerOpportunityCard from './VolunteerOpportunityCard.astro'; // Import VolunteerOpportunityCard

// Fetch all events
const allEvents = await getCollection('events');

// Fetch volunteer opportunities
const volunteerOpportunities = await getCollection('volunteerOpportunities');

// Filter for upcoming events and sort them by date
const today = new Date();
today.setHours(0, 0, 0, 0); // Set to start of today for comparison

const upcomingEvents = allEvents
  .filter(event => new Date(event.data.eventDate) >= today)
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime());

// Take only the next 2 upcoming events
const eventsToShow = upcomingEvents.slice(0, 2);
---
<section id="events" class="py-20 bg-secondary">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-primary text-center">Make an Impact</h2>
    <p class="mt-4 text-lg text-text-secondary text-center max-w-3xl mx-auto">
      Join us for workshops, community actions, and family-friendly events.
    </p>
    <div class="mt-12">
      <h3 class="text-3xl font-bold text-primary mb-8">Attend an Event</h3>
      <div class="grid md:grid-cols-2 gap-8">
        {eventsToShow.length > 0 ? (
          eventsToShow.map(event => <EventCard event={event} />)
        ) : (
          <p class="text-center text-text-secondary col-span-full">No upcoming events at the moment. Check back soon!</p>
        )}
      </div>
      <div class="mt-12 text-center">
        <a href="/events" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary hover:shadow-lg hover:scale-105 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
          View All Events
        </a>
      </div>
    </div>

    {/* Volunteer Opportunities Section */}
    <div class="mt-20">
      <h3 class="text-3xl font-bold text-primary mb-8">Volunteer Opportunities</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {volunteerOpportunities.length > 0 ? (
          volunteerOpportunities.map(opportunity => (
            <VolunteerOpportunityCard opportunity={opportunity} />
          ))
        ) : (
          <p class="text-text-secondary">No volunteer opportunities available at the moment. Check back soon!</p>
        )}
      </div>
      <div class="mt-12 text-center">
        <a href="/impact" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary hover:shadow-lg hover:scale-105 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
          View Past Impact
        </a>
      </div>
    </div>
  </div>
</section>