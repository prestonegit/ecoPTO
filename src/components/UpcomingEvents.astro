---
import { getCollection } from 'astro:content';
import GetInvolvedCard from './GetInvolvedCard.astro'; // Import VolunteerOpportunityCard
import EventDate from './EventDate.astro';

// Fetch all events
const allEvents = await getCollection('events');

// Fetch volunteer opportunities
const getInvolved = await getCollection('get-involved');

// Filter for upcoming events and sort them by date
const today = new Date();
today.setHours(0, 0, 0, 0); // Set to start of today for comparison

const upcomingEvents = allEvents
  .filter(event => new Date(event.data.eventDate) >= today)
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime());

// Take only the next 2 upcoming events
const eventsToShow = upcomingEvents.slice(0, 2);

const { content } = Astro.props;
---
<section id="events" class="py-20 bg-secondary">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-primary text-center">{content.events_title}</h2>
    <p class="mt-4 text-lg text-text-secondary text-center max-w-3xl mx-auto">
      {content.events_subtitle}
    </p>
    <div class="mt-12">
      <h3 class="text-3xl font-bold text-primary mb-8">{content.events_section_title}</h3>
      <div class="grid md:grid-cols-2 gap-8">
        {eventsToShow.length > 0 ? (
          eventsToShow.map(event => (
            <a href={event.data.externalUrl ? event.data.externalUrl : `/events/${event.slug}`} target={event.data.externalUrl ? '_blank' : '_self'} class="flex flex-col rounded-xl shadow-sm overflow-hidden group bg-bg-primary">
              <div class="md:flex flex-grow">
                <div class="md:w-1/2 flex flex-col justify-center">
                  <div class="p-6">
                    <h3 class="text-2xl font-bold text-primary">{event.data.title}</h3>
                    <EventDate date={event.data.eventDate} dateOverride={event.data.dateOverride} />
                    <p class="mt-2 text-text-secondary line-clamp-3">{event.data.cardDescription}</p>
                    <span class="mt-4 inline-block font-bold text-primary group-hover:underline">Learn More &rarr;</span>
                  </div>
                </div>
                {event.data.image && (
                  <div class="md:w-1/2 overflow-hidden">
                    <img
                      src={event.data.image}
                      alt={event.data.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
              </div>
            </a>
          ))
        ) : (
          <div class="col-span-full text-center py-12 bg-bg-primary rounded-xl shadow-sm border-2 border-dashed border-secondary/30">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-secondary mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-xl text-primary font-semibold mb-2">No upcoming events scheduled at the moment.</p>
            <p class="text-text-secondary mb-6 max-w-md mx-auto">We are always planning new initiatives! Interested in sponsoring an event or have a collaboration idea?</p>
            <a href="#contact" class="btn-standard btn-secondary-color inline-flex items-center gap-2">
              <span>Sponsor or Collaborate</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        )}
      </div>
      <div class="mt-12 text-center">
        <a href="/events" class="btn-standard btn-primary-color">
          View all events
        </a>
      </div>

    {/* Community Impact Section */}
    <div class="mt-20">
      <h3 class="text-3xl font-bold text-primary mb-8">See Our Community Impact</h3>
      <div class="py-12 bg-bg-secondary rounded-xl">
        <div class="text-center">
          <p class="text-lg text-text-secondary mb-8 max-w-2xl mx-auto">
            Discover the projects that have made a difference in our schools and community.
          </p>
          <a href="/impact" class="btn-standard btn-primary-color">
            View Past Projects
          </a>
        </div>
      </div>
    </div>

    {/* Volunteer Opportunities Section */}
    <div class="mt-20">
      <h3 class="text-3xl font-bold text-primary mb-8">{content.volunteer_section_title}</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {getInvolved.length > 0 ? (
          getInvolved.map(opportunity => (
            <GetInvolvedCard opportunity={opportunity} />
          ))
        ) : (
          <p class="text-text-secondary">No ways to get involved available at the moment. Check back soon!</p>
        )}
      </div>
      <div class="mt-12 text-center">
        <button id="signup-button-events-section" class="btn-standard btn-primary-color">
          Sign up here
        </button>
      </div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const signupButton = document.getElementById('signup-button-events-section');
    const signupModal = document.getElementById('signup-modal');

    if (signupButton && signupModal) {
      signupButton.addEventListener('click', () => {
        signupModal.classList.add('modal-open');
      });
    }
  });
</script>
    </div>
  </div>
</section>