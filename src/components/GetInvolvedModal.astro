---
import { getEntry } from 'astro:content';

const signupContent = await getEntry('signup', 'signup');
---
<dialog id="get-involved-modal" class="modal">
  <div class="modal-box bg-white text-text-primary p-8 rounded-lg shadow-lg max-w-xl w-full relative">
    <button class="btn-close-modal absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl font-bold" aria-label="Close modal">&times;</button>
    
    <!-- Tabs -->
    <div id="modal-tabs" class="flex border-b border-gray-200 mb-6">
      <button id="tab-join" class="tab-btn flex-1 py-2 text-center text-primary font-bold border-b-2 border-primary transition-colors" data-target="form-join">Join Us</button>
      <button id="tab-staff" class="tab-btn flex-1 py-2 text-center text-text-secondary font-bold border-b-2 border-transparent hover:text-primary transition-colors" data-target="form-staff">Staff Support</button>
    </div>
    
    <!-- Impeccable Delight: Success Feedback -->
    <div id="form-success-feedback" class="hidden flex-col items-center justify-center text-center py-8">
      <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mb-6 text-primary hover-sway">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="font-bold text-3xl text-primary mb-3">Thanks for planting a seed!</h3>
      <p class="text-text-secondary text-lg">Your message has taken root. A member of our community team will reach out to you soon.</p>
      <button class="btn-close-modal-alt btn-standard btn-bg-primary-color mt-8 px-8 py-3 rounded-full hover-spring text-sm">CLOSE WINDOW</button>
    </div>

    <!-- Join Us Form -->
    <div id="form-join" class="form-container block">
      <h3 class="font-bold text-2xl text-primary mb-2">{signupContent.data.signupFormTitle}</h3>
      <p class="py-2 text-text-secondary mb-4">{signupContent.data.signupFormSubtitle}</p>
      
      <form method="post" action="/api/forms" data-resend-form="signup" data-success-message="You're in! Check your inbox for a welcome email." class="space-y-4 bg-white flex-grow">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="first-name" class="text-sm font-bold text-text-secondary">{signupContent.data.signup_first_name_label || "First Name"}</label>
            <input type="text" id="first-name" name="first-name" placeholder={signupContent.data.signup_first_name_placeholder || "First Name"} class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" required autocomplete="given-name" />
          </div>
          <div>
            <label for="last-name" class="text-sm font-bold text-text-secondary">{signupContent.data.signup_last_name_label || "Last Name"}</label>
            <input type="text" id="last-name" name="last-name" placeholder={signupContent.data.signup_last_name_placeholder || "Last Name"} class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" required autocomplete="family-name" />
          </div>
        </div>
        <div>
          <label for="email" class="text-sm font-bold text-text-secondary">{signupContent.data.signup_email_label}</label>
          <input type="email" id="email" name="email" placeholder={signupContent.data.signupFormPlaceholder} class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" required />
        </div>
        <div>
          <label class="text-sm font-bold text-text-secondary">{signupContent.data.signup_school_affiliation_label}</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
            <div class="w-full"><label class="flex items-start"><input type="checkbox" name="school" value="Central High" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 flex-none">Central High</label></div>
            <div class="w-full"><label class="flex items-start"><input type="checkbox" name="school" value="Timberlane Middle" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 flex-none">Timberlane Middle</label></div>
            <div class="w-full"><label class="flex items-start"><input type="checkbox" name="school" value="Bear Tavern Elementary" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 flex-none">Bear Tavern Elementary</label></div>
            <div class="w-full"><label class="flex items-start"><input type="checkbox" name="school" value="Hopewell Elementary" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 flex-none">Hopewell Elementary</label></div>
            <div class="w-full"><label class="flex items-start"><input type="checkbox" name="school" value="Stony Brook" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 flex-none">Stony Brook</label></div>
            <div class="w-full"><label class="flex items-start"><input type="checkbox" name="school" value="Toll Gate Grammar" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 flex-none">Toll Gate Grammar</label></div>
            <div class="w-full"><label class="flex items-start"><input type="checkbox" id="school-other-checkbox" name="school" value="Other" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 flex-none">Other</label></div>
          </div>
          <input type="text" id="school-other-detail" name="school-other" placeholder={signupContent.data.signup_other_school_placeholder || "Please specify your affiliation"} class="w-full p-3 mt-2 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent hidden" />
        </div>
        <!-- Strengths / Expertise Section -->
        <div id="strengths-section">
          <label class="text-sm font-bold text-text-secondary block">
            {signupContent.data.signup_strengths_label || "Your Strengths & How You Can Help"}
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2.5 mt-2 text-sm">
            <!-- 1. Gardening & Outdoor Projects -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="strength-gardening" name="strengths" value="Gardening & Outdoor Projects" class="strength-checkbox h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <div class="inline leading-snug">
                <label for="strength-gardening" class="cursor-pointer select-none font-medium">Gardening & Outdoor Projects</label><span class="inline-flex items-center align-baseline ml-1 relative info-bubble-wrapper"><button type="button" class="info-bubble-trigger text-stone-400 hover:text-primary focus:text-primary focus:outline-none p-0.5 -m-0.5 rounded-full transition-colors cursor-pointer inline-flex items-center" aria-label="Details for Gardening & Outdoor Projects" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg></button><div role="tooltip" class="info-bubble-popover absolute bottom-full mb-2 w-52 sm:w-56 p-2.5 bg-stone-900 text-stone-100 text-xs rounded-lg shadow-xl z-50 leading-relaxed border border-stone-800 left-1/2 -translate-x-1/2">Gardening, landscaping, building raised beds, carpentry<div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-stone-900" aria-hidden="true"></div></div></span>
              </div>
            </div>

            <!-- 2. Education & Youth Programs -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="strength-education" name="strengths" value="Education & Youth Programs" class="strength-checkbox h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <div class="inline leading-snug">
                <label for="strength-education" class="cursor-pointer select-none font-medium">Education & Youth Programs</label><span class="inline-flex items-center align-baseline ml-1 relative info-bubble-wrapper"><button type="button" class="info-bubble-trigger text-stone-400 hover:text-primary focus:text-primary focus:outline-none p-0.5 -m-0.5 rounded-full transition-colors cursor-pointer inline-flex items-center" aria-label="Details for Education & Youth Programs" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg></button><div role="tooltip" class="info-bubble-popover absolute bottom-full mb-2 w-52 sm:w-56 p-2.5 bg-stone-900 text-stone-100 text-xs rounded-lg shadow-xl z-50 leading-relaxed border border-stone-800 left-1/2 -translate-x-1/2 sm:left-auto sm:right-0 sm:translate-x-0">Educators, curriculum, student workshops, green clubs<div class="absolute top-full left-1/2 -translate-x-1/2 sm:left-auto sm:right-1.5 sm:translate-x-0 -mt-1 border-4 border-transparent border-t-stone-900" aria-hidden="true"></div></div></span>
              </div>
            </div>

            <!-- 3. Events & Community Gatherings -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="strength-events" name="strengths" value="Events & Community Gatherings" class="strength-checkbox h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <div class="inline leading-snug">
                <label for="strength-events" class="cursor-pointer select-none font-medium">Events & Community Gatherings</label><span class="inline-flex items-center align-baseline ml-1 relative info-bubble-wrapper"><button type="button" class="info-bubble-trigger text-stone-400 hover:text-primary focus:text-primary focus:outline-none p-0.5 -m-0.5 rounded-full transition-colors cursor-pointer inline-flex items-center" aria-label="Details for Events & Community Gatherings" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg></button><div role="tooltip" class="info-bubble-popover absolute bottom-full mb-2 w-52 sm:w-56 p-2.5 bg-stone-900 text-stone-100 text-xs rounded-lg shadow-xl z-50 leading-relaxed border border-stone-800 left-1/2 -translate-x-1/2">Event planning, logistics, hikes, cleanups, hospitality<div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-stone-900" aria-hidden="true"></div></div></span>
              </div>
            </div>

            <!-- 4. Communications, Design & Tech -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="strength-communications" name="strengths" value="Communications, Design & Tech" class="strength-checkbox h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <div class="inline leading-snug">
                <label for="strength-communications" class="cursor-pointer select-none font-medium">Communications, Design & Tech</label><span class="inline-flex items-center align-baseline ml-1 relative info-bubble-wrapper"><button type="button" class="info-bubble-trigger text-stone-400 hover:text-primary focus:text-primary focus:outline-none p-0.5 -m-0.5 rounded-full transition-colors cursor-pointer inline-flex items-center" aria-label="Details for Communications, Design & Tech" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg></button><div role="tooltip" class="info-bubble-popover absolute bottom-full mb-2 w-52 sm:w-56 p-2.5 bg-stone-900 text-stone-100 text-xs rounded-lg shadow-xl z-50 leading-relaxed border border-stone-800 left-1/2 -translate-x-1/2 sm:left-auto sm:right-0 sm:translate-x-0">Writing/PR, newsletter, photography, website & software<div class="absolute top-full left-1/2 -translate-x-1/2 sm:left-auto sm:right-1.5 sm:translate-x-0 -mt-1 border-4 border-transparent border-t-stone-900" aria-hidden="true"></div></div></span>
              </div>
            </div>

            <!-- 5. Policy, Advocacy & School Board -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="strength-policy" name="strengths" value="Policy, Advocacy & School Board" class="strength-checkbox h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <div class="inline leading-snug">
                <label for="strength-policy" class="cursor-pointer select-none font-medium">Policy, Advocacy & School Board</label><span class="inline-flex items-center align-baseline ml-1 relative info-bubble-wrapper"><button type="button" class="info-bubble-trigger text-stone-400 hover:text-primary focus:text-primary focus:outline-none p-0.5 -m-0.5 rounded-full transition-colors cursor-pointer inline-flex items-center" aria-label="Details for Policy, Advocacy & School Board" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg></button><div role="tooltip" class="info-bubble-popover absolute bottom-full mb-2 w-52 sm:w-56 p-2.5 bg-stone-900 text-stone-100 text-xs rounded-lg shadow-xl z-50 leading-relaxed border border-stone-800 left-1/2 -translate-x-1/2">District policy, environmental initiatives, local politics<div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-stone-900" aria-hidden="true"></div></div></span>
              </div>
            </div>

            <!-- 6. Fundraising, Finance & Legal -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="strength-fundraising" name="strengths" value="Fundraising, Finance & Legal" class="strength-checkbox h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <div class="inline leading-snug">
                <label for="strength-fundraising" class="cursor-pointer select-none font-medium">Fundraising, Finance & Legal</label><span class="inline-flex items-center align-baseline ml-1 relative info-bubble-wrapper"><button type="button" class="info-bubble-trigger text-stone-400 hover:text-primary focus:text-primary focus:outline-none p-0.5 -m-0.5 rounded-full transition-colors cursor-pointer inline-flex items-center" aria-label="Details for Fundraising, Finance & Legal" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg></button><div role="tooltip" class="info-bubble-popover absolute bottom-full mb-2 w-52 sm:w-56 p-2.5 bg-stone-900 text-stone-100 text-xs rounded-lg shadow-xl z-50 leading-relaxed border border-stone-800 left-1/2 -translate-x-1/2 sm:left-auto sm:right-0 sm:translate-x-0">Grant writing, fundraising, bookkeeping, non-profit law<div class="absolute top-full left-1/2 -translate-x-1/2 sm:left-auto sm:right-1.5 sm:translate-x-0 -mt-1 border-4 border-transparent border-t-stone-900" aria-hidden="true"></div></div></span>
              </div>
            </div>

            <!-- Other expertise -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="strengths-other-checkbox" name="strengths" value="Other" class="strength-checkbox h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <label for="strengths-other-checkbox" class="cursor-pointer select-none font-medium leading-snug">Other expertise</label>
            </div>

            <!-- Updates only -->
            <div class="strength-item flex items-start text-xs sm:text-[13px] md:text-sm text-text-primary leading-snug py-0.5">
              <input type="checkbox" id="updates-only-checkbox" name="strengths" value="Updates only" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary checked:bg-primary checked:border-primary mr-2 mt-0.5 flex-none" />
              <label for="updates-only-checkbox" class="cursor-pointer select-none font-medium leading-snug">{signupContent.data.signup_updates_only_label || "I only want updates"}</label>
            </div>
          </div>
          <input type="text" id="strengths-other-detail" name="strengths-other" placeholder={signupContent.data.signup_strengths_other_placeholder || "Please specify your skill or background"} class="w-full p-3 mt-2 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent hidden" />
          <p id="strengths-error" class="text-xs text-red-600 font-bold mt-2 hidden" role="alert">Please select at least one skill or choose 'I only want updates'.</p>
        </div>

        <div>
          <label for="impact-focus" class="text-sm font-bold text-text-secondary">{signupContent.data.signup_impact_focus_label}</label>
          <textarea id="impact-focus" name="impact-focus" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" placeholder={signupContent.data.signup_impact_focus_placeholder}></textarea>
        </div>

        <input type="hidden" name="receive-updates" value="true" />

        <div class="modal-action mt-6 flex justify-center gap-4">
          <button type="submit" class="btn-standard btn-bg-primary-color px-8 py-3 rounded-full">{signupContent.data.signup_button_text || "Join ecoPTO"}</button>
        </div>
      </form>
    </div>

    <!-- Staff Request Form -->
    <div id="form-staff" class="form-container hidden">
      <h3 class="font-bold text-2xl text-primary mb-2">Staff Support</h3>
      <p class="py-2 text-text-secondary mb-4">We are here to help!</p>
      
      <form method="post" action="/api/forms" data-resend-form="staff-support" data-success-message="Request sent — we'll be in touch soon." class="space-y-4 bg-white flex-grow">
        
        <!-- form fields from staffsupport.astro -->
        <div>
          <label for="staff-name" class="text-sm font-bold text-text-secondary">Full Name</label>
          <input type="text" id="staff-name" name="staff-name" placeholder="E.g., Jane Smith" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" required />
        </div>
        
        <div>
          <label for="staff-email" class="text-sm font-bold text-text-secondary">Email</label>
          <input type="email" id="staff-email" name="staff-email" placeholder="name@example.com" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" required />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="staff-phone" class="text-sm font-bold text-text-secondary">Phone Number (Optional)</label>
            <input type="tel" id="staff-phone" name="staff-phone" placeholder="555-0123" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" />
          </div>
          <div>
            <label for="staff-date" class="text-sm font-bold text-text-secondary">Date Needed (Optional)</label>
            <input type="date" id="staff-date" name="staff-date" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" />
          </div>
          <div>
            <label for="staff-time" class="text-sm font-bold text-text-secondary">Time Needed (Optional)</label>
            <input type="time" id="staff-time" name="staff-time" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" />
          </div>
        </div>
        
        <div>
          <label for="staff-school" class="text-sm font-bold text-text-secondary">School / Affiliation</label>
          <select id="staff-school" name="staff-school" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent appearance-none" required>
              <option value="" disabled selected>Select your school or affiliation...</option>
              <option value="Hopewell Elementary">Hopewell Elementary</option>
              <option value="Bear Tavern Elementary">Bear Tavern Elementary</option>
              <option value="Toll Gate Grammar">Toll Gate Grammar</option>
              <option value="Stony Brook Elementary">Stony Brook Elementary</option>
              <option value="Timberlane Middle School">Timberlane Middle School</option>
              <option value="Central High School">Central High School</option>
              <option value="Other">Other</option>
          </select>
          <input type="text" id="staff-other-school" name="staff-other-school" placeholder="Please specify your location or affiliation" class="w-full p-3 mt-2 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent hidden" />
        </div>

        <div>
          <label for="staff-help" class="text-sm font-bold text-text-secondary">How can we support you?</label>
          <textarea id="staff-help" name="staff-help" rows="4" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent resize-vertical" placeholder="Describe your project, field trip, or how volunteers can assist..." required></textarea>
        </div>

        <div class="modal-action mt-6 flex justify-center gap-4">
          <button type="submit" class="btn-standard btn-bg-primary-color px-8 py-3 rounded-full">SEND REQUEST</button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<style>
  .modal {
    display: none; /* Hide by default */
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    min-height: 100vh;
    overflow-y: auto;
    background-color: rgba(0,0,0,0.5);
    justify-content: center;
    align-items: flex-start;
    padding: 5vh 1rem 8vh;
  }

  .modal-box {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    max-height: 90vh;
    flex-shrink: 1; /* Ensure it can shrink */
    flex-basis: auto; /* Default flex basis */
    overscroll-behavior-y: contain; /* Added for scroll chaining */
  }

  .modal.modal-open {
    display: flex;
  }

  body.modal-open {
    overflow: hidden;
  }

  .strength-item {
    position: relative;
  }

  .strength-item:hover,
  .strength-item:focus-within,
  .strength-item:has(.is-open) {
    z-index: 30;
  }

  .info-bubble-wrapper:hover,
  .info-bubble-wrapper:focus-within,
  .info-bubble-wrapper.is-open {
    z-index: 40;
  }

  .info-bubble-popover {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 0.15s ease-out, transform 0.15s ease-out, visibility 0.15s;
  }

  .info-bubble-wrapper:hover .info-bubble-popover,
  .info-bubble-wrapper:focus-within .info-bubble-popover,
  .info-bubble-wrapper.is-open .info-bubble-popover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<script>
  import { wireForms } from '../lib/forms.js';

  document.addEventListener('astro:page-load', () => {
    wireForms();
    const modal = document.getElementById('get-involved-modal');
    const body = document.body;

    if (modal) {
      const closeButton = modal.querySelector('.btn-close-modal');
      const triggerBtns = document.querySelectorAll('.get-involved-trigger');
      
      const tabBtns = modal.querySelectorAll('.tab-btn');
      const formContainers = modal.querySelectorAll('.form-container');
      const forms = Array.from(modal.querySelectorAll('form'));
      const successFeedback = document.getElementById('form-success-feedback');
      const modalTabs = document.getElementById('modal-tabs');

      const joinForm = modal.querySelector('form[data-resend-form="signup"]');
      const strengthsSection = document.getElementById('strengths-section');
      const strengthCheckboxes = Array.from(modal.querySelectorAll('.strength-checkbox'));
      const updatesOnlyCheckbox = document.getElementById('updates-only-checkbox');
      const strengthsOtherCheckbox = document.getElementById('strengths-other-checkbox');
      const strengthsOtherDetail = document.getElementById('strengths-other-detail');
      const strengthsError = document.getElementById('strengths-error');
      const infoWrappers = Array.from(modal.querySelectorAll('.info-bubble-wrapper'));
      const schoolOtherCheckbox = document.getElementById('school-other-checkbox');
      const schoolOtherDetail = document.getElementById('school-other-detail');
      const staffSchoolSelect = document.getElementById('staff-school');
      const staffOtherSchoolInput = document.getElementById('staff-other-school');

      const getSubmitButton = (form) => {
        const submitButton = form.querySelector('button[type="submit"]');
        return submitButton instanceof HTMLButtonElement ? submitButton : null;
      };

      const resetSubmitButton = (form) => {
        const submitBtn = getSubmitButton(form);

        if (!submitBtn) {
          return;
        }

        const originalText = submitBtn.dataset.originalText || submitBtn.textContent || 'Submit';
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      };

      forms.forEach((form) => {
        const submitBtn = getSubmitButton(form);

        if (submitBtn && !submitBtn.dataset.originalText) {
          submitBtn.dataset.originalText = submitBtn.textContent?.trim() || 'Submit';
        }
      });

      const switchTab = (targetId) => {
        // Update tab buttons
        tabBtns.forEach(btn => {
          if (btn.dataset.target === targetId) {
            btn.classList.add('text-primary', 'border-primary');
            btn.classList.remove('text-text-secondary', 'border-transparent');
          } else {
            btn.classList.remove('text-primary', 'border-primary');
            btn.classList.add('text-text-secondary', 'border-transparent');
          }
        });

        // Update forms
        formContainers.forEach(container => {
          if (container.id === targetId) {
            container.classList.remove('hidden');
            container.classList.add('block');
          } else {
            container.classList.add('hidden');
            container.classList.remove('block');
          }
        });
      };

      const resetModalState = (targetTab = 'form-join') => {
        forms.forEach((form) => {
          if (form instanceof HTMLFormElement) {
            form.reset();
          }

          resetSubmitButton(form);
        });

        if (modalTabs instanceof HTMLElement) {
          modalTabs.classList.remove('hidden');
        }

        if (successFeedback instanceof HTMLElement) {
          successFeedback.classList.add('hidden');
          successFeedback.classList.remove('flex');
        }

        if (strengthsOtherDetail instanceof HTMLInputElement) {
          strengthsOtherDetail.classList.add('hidden');
          strengthsOtherDetail.required = false;
          strengthsOtherDetail.value = '';
        }

        if (strengthsError instanceof HTMLElement) {
          strengthsError.classList.add('hidden');
        }

        infoWrappers.forEach((w) => {
          w.classList.remove('is-open');
          const t = w.querySelector('.info-bubble-trigger');
          if (t) t.setAttribute('aria-expanded', 'false');
        });

        if (staffOtherSchoolInput instanceof HTMLInputElement) {
          staffOtherSchoolInput.classList.add('hidden');
          staffOtherSchoolInput.required = false;
        }

        if (schoolOtherDetail instanceof HTMLInputElement) {
          schoolOtherDetail.classList.add('hidden');
          schoolOtherDetail.required = false;
          schoolOtherDetail.value = '';
        }

        switchTab(targetTab);
      };


      // Tab clicks
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          switchTab(btn.dataset.target);
        });
      });

      // Open Modal Triggers
      triggerBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTab = btn.dataset.targetTab || 'form-join';
          resetModalState(targetTab);
          modal.classList.add('modal-open');
          body.classList.add('modal-open');
        });
      });

      // Close Modal Function
      const closeModal = () => {
        modal.classList.remove('modal-open');
        body.classList.remove('modal-open');
        resetModalState();
      };

      closeButton.addEventListener('click', closeModal);
      
      const altCloseButton = modal.querySelector('.btn-close-modal-alt');
      if (altCloseButton) {
        altCloseButton.addEventListener('click', closeModal);
      }

      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });
      
      // Submission is handled by src/lib/forms.js (wireForms above), which POSTs JSON
      // to /api/forms. The old Netlify Forms handler that used to live here POSTed a
      // second time to '/' and alerted "something went wrong" on every successful
      // submission; it was removed when Netlify Forms was retired.
      forms.forEach(form => {
        form.addEventListener('resend-form:success', () => {
          resetSubmitButton(form);
          formContainers.forEach(c => {
            c.classList.remove('block');
            c.classList.add('hidden');
          });
          if (modalTabs instanceof HTMLElement) {
            modalTabs.classList.add('hidden');
          }
          if (successFeedback instanceof HTMLElement) {
            successFeedback.classList.remove('hidden');
            successFeedback.classList.add('flex');
          }
        });
      });

      // Handle strengths / updates-only mutual exclusivity and validation
      const allStrengthInputs = [...strengthCheckboxes, updatesOnlyCheckbox].filter(Boolean);
      const isAnyStrengthChecked = () => allStrengthInputs.some(cb => cb instanceof HTMLInputElement && cb.checked);

      allStrengthInputs.forEach(cb => {
        cb?.addEventListener('change', () => {
          if (isAnyStrengthChecked() && strengthsError) {
            strengthsError.classList.add('hidden');
          }
        });
      });

      if (updatesOnlyCheckbox instanceof HTMLInputElement) {
        updatesOnlyCheckbox.addEventListener('change', () => {
          if (updatesOnlyCheckbox.checked) {
            strengthCheckboxes.forEach(cb => {
              if (cb instanceof HTMLInputElement) cb.checked = false;
            });
            if (strengthsOtherDetail instanceof HTMLInputElement) {
              strengthsOtherDetail.classList.add('hidden');
              strengthsOtherDetail.required = false;
              strengthsOtherDetail.value = '';
            }
          }
        });
      }

      strengthCheckboxes.forEach(cb => {
        cb?.addEventListener('change', () => {
          if (cb instanceof HTMLInputElement && cb.checked && updatesOnlyCheckbox instanceof HTMLInputElement) {
            updatesOnlyCheckbox.checked = false;
          }
        });
      });

      // Handle "Other" strengths option
      if (strengthsOtherCheckbox && strengthsOtherDetail) {
        strengthsOtherCheckbox.addEventListener('change', () => {
          if (strengthsOtherCheckbox instanceof HTMLInputElement && strengthsOtherCheckbox.checked) {
            strengthsOtherDetail.classList.remove('hidden');
            strengthsOtherDetail.required = true;
            if (strengthsOtherDetail instanceof HTMLInputElement) {
              strengthsOtherDetail.focus();
            }
          } else if (strengthsOtherDetail instanceof HTMLInputElement) {
            strengthsOtherDetail.classList.add('hidden');
            strengthsOtherDetail.required = false;
            strengthsOtherDetail.value = '';
          }
        });
      }

      // Validate that at least one strength or "updates only" is checked on submit
      if (joinForm) {
        joinForm.addEventListener('submit', (e) => {
          if (!isAnyStrengthChecked()) {
            e.preventDefault();
            e.stopImmediatePropagation();
            if (strengthsError) {
              strengthsError.classList.remove('hidden');
            }
            if (strengthsSection) {
              strengthsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            const firstCheckbox = strengthCheckboxes[0] || updatesOnlyCheckbox;
            if (firstCheckbox instanceof HTMLInputElement) {
              firstCheckbox.focus();
            }
            return false;
          }
        }, true);
      }

      // Handle "Other" school option for Join Us form
      if (schoolOtherCheckbox && schoolOtherDetail) {
        schoolOtherCheckbox.addEventListener('change', () => {
          if (schoolOtherCheckbox instanceof HTMLInputElement && schoolOtherCheckbox.checked) {
            schoolOtherDetail.classList.remove('hidden');
            schoolOtherDetail.required = true;
            if (schoolOtherDetail instanceof HTMLInputElement) {
              schoolOtherDetail.focus();
            }
          } else if (schoolOtherDetail instanceof HTMLInputElement) {
            schoolOtherDetail.classList.add('hidden');
            schoolOtherDetail.required = false;
            schoolOtherDetail.value = '';
          }
        });
      }

      // Handle "Other" school option
      if (staffSchoolSelect && staffOtherSchoolInput) {
        staffSchoolSelect.addEventListener('change', (e) => {
          if (e.target.value === 'Other') {
            staffOtherSchoolInput.classList.remove('hidden');
            staffOtherSchoolInput.required = true;
          } else {
            staffOtherSchoolInput.classList.add('hidden');
            staffOtherSchoolInput.required = false;
          }
        });
      }

      // Info bubble interaction (handles tap on mobile/touch, keyboard interaction, and light-dismiss)
      infoWrappers.forEach((wrapper) => {
        const trigger = wrapper.querySelector('.info-bubble-trigger');
        if (trigger instanceof HTMLButtonElement) {
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const wasOpen = wrapper.classList.contains('is-open');

            // Close all open bubbles
            infoWrappers.forEach((w) => {
              w.classList.remove('is-open');
              const t = w.querySelector('.info-bubble-trigger');
              if (t) t.setAttribute('aria-expanded', 'false');
            });

            if (!wasOpen) {
              wrapper.classList.add('is-open');
              trigger.setAttribute('aria-expanded', 'true');
            }
          });
        }
      });

      // Close open bubbles on outside click or Escape
      document.addEventListener('click', (e) => {
        if (!e.target || !(e.target instanceof Element) || !e.target.closest('.info-bubble-wrapper')) {
          infoWrappers.forEach((w) => {
            w.classList.remove('is-open');
            const t = w.querySelector('.info-bubble-trigger');
            if (t) t.setAttribute('aria-expanded', 'false');
          });
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          infoWrappers.forEach((w) => {
            w.classList.remove('is-open');
            const t = w.querySelector('.info-bubble-trigger');
            if (t) t.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
  });
</script>
