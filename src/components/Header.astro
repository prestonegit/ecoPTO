---
import globalSettings from '../content/settings/global.json';
---
<header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-200">
  <nav class="container mx-auto px-6 py-3 flex justify-between items-center">
    <a href="/" class="text-2xl font-bold text-green-900">
      eco<span class="text-green-600">PTO</span>
    </a>
    <div class="hidden md:flex items-center space-x-6">
      <a href="/#mission" class="text-gray-700 hover:text-green-600">Our Mission</a>
      <a href="/#events" class="text-gray-700 hover:text-green-600">Events</a>
      <a href="/impact" class="text-gray-700 hover:text-green-600">Community Impact</a> <a href="/#contact" class="text-gray-700 hover:text-green-600">Contact</a>
      <a href="/about" class="text-gray-700 hover:text-green-600">About Us</a>
    </div>
    <button id="join-us-header-btn" class="bg-green-800 text-white px-5 py-2 rounded-full hover:bg-green-700 transition-colors">
      Join Us
    </button>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const joinUsBtn = document.getElementById('join-us-header-btn');
    const signupModal = document.getElementById('signup-modal');

    if (joinUsBtn && signupModal) {
      joinUsBtn.addEventListener('click', () => {
        signupModal.classList.add('modal-open');
      });
    }
  });
</script>