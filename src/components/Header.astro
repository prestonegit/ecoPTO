---
import globalSettings from '../content/settings/global.json';
---
<header class="bg-bg-primary backdrop-blur-md sticky top-0 z-50 border-b border-bg-secondary">
  <nav class="container mx-auto px-6 py-3 flex justify-between items-center">
    
    <a href="/" class="flex items-center gap-2 text-xl sm:text-2xl font-bold text-primary mr-8 z-50">
      <img src="/logo-icon.svg" alt="ecoPTO Logo" class="h-8 sm:h-10 w-auto inline-block">
      <div>eco<span class="text-secondary">PTO</span></div>
    </a>
    
    <div class="hidden md:flex flex-grow justify-center gap-8 items-center z-50">
      <a href="/about" class="text-sm font-bold text-text-primary hover:text-primary transition-colors">Leadership</a>
      <a href="/events" class="text-sm font-bold text-text-primary hover:text-primary transition-colors">Events</a>
      <a href="/impact" class="text-sm font-bold text-text-primary hover:text-primary transition-colors">Impact</a>
      <a href="/research" class="text-sm font-bold text-text-primary hover:text-primary transition-colors">Literature</a>
      <a href="/donate" class="text-sm font-bold bg-green-700 text-white hover:bg-green-800 px-5 py-2 mt-[-0.25rem] rounded-full transition-colors">Donate</a>
    </div>
    
    <!-- Mobile Hamburger and single Join Us button -->
    <div class="flex md:hidden items-center gap-3 z-50 ml-auto">
      <button class="get-involved-trigger bg-primary text-white hover:bg-secondary hover:text-primary px-5 py-1.5 flex items-center justify-center rounded-full text-sm font-bold transition-colors" data-target-tab="form-join">
        Join Us
      </button>
      <button id="mobile-menu-btn" class="text-primary hover:text-secondary focus:outline-none p-1 ml-1">
        <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
          <path id="mobile-menu-icon" fill-rule="evenodd" d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"/>
        </svg>
      </button>
    </div>

    <!-- Desktop Buttons -->
    <div class="hidden md:flex items-center gap-6 ml-auto z-50 border-l border-gray-200 pl-6">
      <button class="get-involved-trigger text-sm font-bold text-text-primary hover:text-primary transition-colors flex items-center" data-target-tab="form-staff">
        Staff Support
      </button>
      <button class="get-involved-trigger text-sm font-bold bg-primary text-white hover:bg-secondary hover:text-primary px-6 py-2 rounded-full transition-colors shadow-sm" data-target-tab="form-join">
        Join Us
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-bg-primary border-b border-bg-secondary shadow-lg z-40">
    <div class="flex flex-col px-6 py-4 space-y-4">
      <a href="/about" class="text-base font-bold text-text-primary hover:text-primary transition-colors">Leadership</a>
      <a href="/events" class="text-base font-bold text-text-primary hover:text-primary transition-colors">Events</a>
      <a href="/impact" class="text-base font-bold text-text-primary hover:text-primary transition-colors">Impact</a>
      <a href="/research" class="text-base font-bold text-text-primary hover:text-primary transition-colors">Literature</a>
      <a href="/donate" class="text-base font-bold text-center bg-green-700 text-white hover:bg-green-800 py-2 mt-2 rounded-full transition-colors">Donate</a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuIcon = document.getElementById('mobile-menu-icon');

    if (mobileMenuBtn && mobileMenu) {
      const toggleMenu = () => {
        mobileMenu.classList.toggle('hidden');
        if (mobileMenu.classList.contains('hidden')) {
          mobileMenuIcon.setAttribute('d', 'M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z'); // Hamburger
        } else {
          mobileMenuIcon.setAttribute('d', 'M18.278 16.864a1 1 0 0 1-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 0 1-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 0 1 1.414-1.414l4.829 4.828 4.828-4.828a1 1 0 1 1 1.414 1.414l-4.828 4.829 4.828 4.828z'); // Close icon
        }
      };

      mobileMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      // Close menu when clicking outside
      document.addEventListener('click', (event) => {
        if (!mobileMenu.classList.contains('hidden')) {
          const isClickInsideMenu = mobileMenu.contains(event.target);
          const isClickOnToggle = mobileMenuBtn.contains(event.target);
          
          if (!isClickInsideMenu && !isClickOnToggle) {
            toggleMenu();
          }
        }
      });
    }
  });
</script>