---
const { news } = Astro.props;
---
<div class="bg-bg-primary p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
  <h3 class="text-xl font-bold mb-2">{news.data.title}</h3>
  <p class="mb-4">by {news.data.author} on {news.data.pubDate.toDateString()}</p>
  <a href={`/news/${news.slug}/`}>Read More</a>
</div>
