    <p>&copy; {year} HVRSD ecoPTO</p>

    <div class="mt-4 text-xs opacity-70">
      <p class="mb-2">Icon Attributions:</p>
      <div class="flex justify-center items-center space-x-4">
        <a href="https://www.flaticon.com/free-icons/mindfulness" title="mindfulness icons" class="hover:underline">Mindfulness icons created by Flat-icons-com - Flaticon</a>
        <a href="https://www.flaticon.com/free-icons/kids-yoga" title="kids yoga icons" class="hover:underline">Kids yoga icons created by Paul J. - Flaticon</a>
        <a href="https://www.flaticon.com/free-icons/acroyoga" title="acroyoga icons" class="hover:underline">Acroyoga icons created by Flat-icons-com - Flaticon</a>
      </div>
    </div>
    
  </div>
