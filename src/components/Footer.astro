---
// src/components/Footer.astro
import { getEntry } from 'astro:content';

const year = new Date().getFullYear();
const globalSettings = await getEntry('settings', 'global');
---
<footer class="bg-[rgba(0,0,0,0.15)] text-white py-12 md:py-16 border-t-4 border-secondary relative mix-blend-multiply">
  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- Brand & Mission -->
      <div>
        <a href="/" class="flex items-center gap-3 mb-6 group">
          <img src="/logo-icon.svg" alt="ecoPTO Logo" class="w-16 h-16 object-contain opacity-90 group-hover:opacity-100 transition-opacity">
          <div class="text-3xl font-bold text-white font-sans tracking-tight">
            eco<span class="text-secondary">PTO</span>
          </div>
        </a>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-bold text-secondary mb-6 font-serif">Quick Navigation</h4>
        <ul class="space-y-3">
          <li><a href="/" class="text-white hover:text-secondary font-medium transition-colors">Home</a></li>
          <li><a href="/about" class="text-white hover:text-secondary font-medium transition-colors">Leadership</a></li>
          <li><a href="/events" class="text-white hover:text-secondary font-medium transition-colors">Events</a></li>
          <li><a href="/impact" class="text-white hover:text-secondary font-medium transition-colors">Impact</a></li>
          <li><a href="/research" class="text-white hover:text-secondary font-medium transition-colors">Literature</a></li>
        </ul>
      </div>
      
      <!-- Contact -->
      <div>
        <h4 class="text-lg font-bold text-secondary mb-6 font-serif">Contact Us</h4>
        <ul class="space-y-3">
          <li>
            <a href="mailto:ecoptohvrsd@gmail.com" class="text-white hover:text-secondary font-medium transition-colors flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              ecoptohvrsd@gmail.com
            </a>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom Footer (Copyright & Attribution) -->
    <div class="pt-8 border-t border-white/10 text-center flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-white/50">
      <p>&copy; {year} Hopewell Valley ecoPTO. All rights reserved.</p>

      {globalSettings.data.attributions && globalSettings.data.attributions.length > 0 && (
        <div class="flex flex-wrap text-xs justify-center items-center gap-x-2 gap-y-1">
          <span>Design attributions:</span>
          {globalSettings.data.attributions.map((attr, index) => (
            <>
              <a href={attr.url} title={attr.text} class="text-white hover:text-secondary underline transition-colors" target="_blank" rel="noopener noreferrer">{attr.text}</a>
              {index < globalSettings.data.attributions.length - 1 && <span class="opacity-50 text-white">|</span>}
            </>
          ))}
        </div>
      )}
    </div>
  </div>
</footer>