---
const { content } = Astro.props;
---
<section id="contact" class="py-24 bg-primary text-bg-primary overflow-hidden">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 lg:gap-16">
    <div class="animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-medium text-bg-primary mt-6">{content.contact_title}</h2>
      <p class="mt-4 text-xl text-bg-primary/90 leading-relaxed" set:html={content.contact_subtitle}></p>
      <div class="mt-10 space-y-4">
        <p class="text-lg"><strong>Email Us:</strong> <a href={`mailto:${content.contact_email}`} class="text-secondary hover:text-white underline">{content.contact_email}</a></p>
      </div>
    </div>
    <div class="animate-on-scroll stagger-1">
      <form name="contact" method="POST" data-netlify="true" class="mt-6 space-y-4">
        <input type="hidden" name="form-name" value="contact" />
        <div>
          <label for="contact-name" class="block text-sm font-bold text-white mb-2 ml-1">Name</label>
          <input type="text" id="contact-name" name="name" placeholder="E.g., Jane Smith" class="w-full p-4 rounded-xl bg-white/10 border border-white/30 focus:outline-none focus:border-secondary focus:bg-white/20 placeholder-white/60 text-white font-medium transition-colors" />
        </div>
        <div>
          <label for="contact-email" class="block text-sm font-bold text-white mb-2 ml-1">Email Address</label>
          <input type="email" id="contact-email" name="email" placeholder="name@example.com" class="w-full p-4 rounded-xl bg-white/10 border border-white/30 focus:outline-none focus:border-secondary focus:bg-white/20 placeholder-white/60 text-white font-medium transition-colors" />
        </div>
        <div>
          <label for="contact-message" class="block text-sm font-bold text-white mb-2 ml-1">Message</label>
          <textarea id="contact-message" name="message" rows="5" placeholder="How can we help?" class="w-full p-4 rounded-xl bg-white/10 border border-white/30 focus:outline-none focus:border-secondary focus:bg-white/20 placeholder-white/60 text-white font-medium transition-colors resize-y"></textarea>
        </div>
        <button type="submit" class="btn-standard btn-secondary-color w-full">
          Send message
        </button>
      </form>
    </div>
  </div>
</section>