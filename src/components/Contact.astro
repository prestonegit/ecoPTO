---
// src/components/Contact.astro
---
<section id="contact" class="py-20 bg-primary text-bg-primary">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12">
    <div class="">
      <h2 class="text-4xl font-bold text-bg-primary mt-6">Get In Touch</h2>
      <p class="mt-4 text-lg text-bg-primary">
        Have questions about ecoPTO? We'd love to hear from you. Send us a note and one of our members will be in touch shortly.<br><br> If you'd like to join, please use our sign up form <button id="contact-join-us-btn" class="text-secondary underline focus:outline-none">here</button>
      </p>
      <div class="mt-8 space-y-4">
        <p><strong>Email Us:</strong> info@ecopto-hv.org</p>
      </div>
    </div>
    <div>
      <form name="contact" method="POST" data-netlify="true" class="mt-6 space-y-4">
        <input type="hidden" name="form-name" value="contact" />
        <input type="text" name="name" placeholder="Name" class="w-full p-3 rounded-md bg-white/10 border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" />
        <input type="email" name="email" placeholder="Email Address" class="w-full p-3 rounded-md bg-white/10 border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" />
        <textarea name="message" rows="5" placeholder="Message" class="w-full p-3 rounded-md bg-white/10 border border-secondary focus:outline-none focus:ring-2 focus:ring-accent"></textarea>
        <button type="submit" class="w-full bg-primary text-bg-primary font-bold px-8 py-3 rounded-full hover:bg-secondary transition-colors border-2 border-secondary">
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const contactJoinUsBtn = document.getElementById('contact-join-us-btn');
    const signupModal = document.getElementById('signup-modal');

    if (contactJoinUsBtn && signupModal) {
      contactJoinUsBtn.addEventListener('click', () => {
        signupModal.classList.add('modal-open');
      });
    }
  });
</script>