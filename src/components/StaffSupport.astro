---
// src/components/StaffSupport.astro
---
<dialog id="staff-support-modal" class="modal">
  <div class="modal-box bg-white text-text-primary p-8 rounded-lg shadow-lg max-w-lg w-full relative">
    <button class="btn-close-staff absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl font-bold">&times;</button>
    <h3 class="font-bold text-2xl text-primary mb-2">HVRSD Staff Support Request</h3>
    <p class="py-2 text-text-secondary mb-4">Whether you need volunteers, materials, or event planning help, the PTO community is here for you.</p>
    
    <form name="staff-support" method="POST" data-netlify="true" data-netlify-submission-title="staff-name" class="space-y-4 bg-white flex-grow">
      <input type="hidden" name="form-name" value="staff-support" />
      
      <div>
        <label for="staff-name" class="text-sm font-bold text-text-secondary">Full Name</label>
        <input type="text" id="staff-name" name="staff-name" placeholder="E.g., Jane Smith" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" required />
      </div>
      
      <div>
        <label for="staff-email" class="text-sm font-bold text-text-secondary">HVRSD Email</label>
        <input type="email" id="staff-email" name="staff-email" placeholder="name@hvrsd.org" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" required />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="staff-phone" class="text-sm font-bold text-text-secondary">Phone Number (Optional)</label>
          <input type="tel" id="staff-phone" name="staff-phone" placeholder="555-0123" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" />
        </div>
        <div>
          <label for="staff-date" class="text-sm font-bold text-text-secondary">Date Needed (Optional)</label>
          <input type="date" id="staff-date" name="staff-date" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent" />
        </div>
      </div>
      
      <div>
        <label for="staff-school" class="text-sm font-bold text-text-secondary">School</label>
        <select id="staff-school" name="staff-school" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent appearance-none" required>
            <option value="" disabled selected>Select your school...</option>
            <option value="Hopewell Elementary">Hopewell Elementary</option>
            <option value="Bear Tavern Elementary">Bear Tavern Elementary</option>
            <option value="Toll Gate Grammar">Toll Gate Grammar</option>
            <option value="Stony Brook Elementary">Stony Brook Elementary</option>
            <option value="Timberlane Middle School">Timberlane Middle School</option>
            <option value="Central High School">Central High School</option>
        </select>
      </div>

      <div>
        <label for="staff-help" class="text-sm font-bold text-text-secondary">How can we support you?</label>
        <textarea id="staff-help" name="staff-help" rows="4" class="w-full p-3 mt-1 rounded-md bg-bg-secondary border border-secondary focus:outline-none focus:ring-2 focus:ring-accent resize-vertical" placeholder="Describe your project, field trip, or how volunteers can assist..." required></textarea>
      </div>

      <div class="modal-action mt-6 flex justify-center gap-4">
        <button type="submit" class="btn-standard btn-bg-primary-color px-8 py-3 rounded-full">SEND REQUEST</button>
      </div>
    </form>
  </div>
<style>
  .modal {
    display: none; /* Hide by default */
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    min-height: 100vh;
    overflow-y: auto;
    background-color: rgba(0,0,0,0.5);
    justify-content: center;
    align-items: flex-start;
    padding: 5vh 1rem 8vh;
  }

  .modal-box {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    max-height: 90vh;
    flex-shrink: 1; /* Ensure it can shrink */
    flex-basis: auto; /* Default flex basis */
    overscroll-behavior-y: contain; /* Added for scroll chaining */
  }

  .modal.modal-open {
    display: flex;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('staff-support-modal');
    const body = document.body;

    if (modal) {
      const closeButton = modal.querySelector('.btn-close-staff');
      const heroStaffBtn = document.getElementById('staff-support-hero-btn');

      if (heroStaffBtn) {
        heroStaffBtn.addEventListener('click', () => {
          modal.classList.add('modal-open');
          body.classList.add('modal-open');
        });
      }

      closeButton.addEventListener('click', () => {
        modal.classList.remove('modal-open');
        body.classList.remove('modal-open');
      });

      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          modal.classList.remove('modal-open');
          body.classList.remove('modal-open');
        }
      });
    }
  });
</script>
