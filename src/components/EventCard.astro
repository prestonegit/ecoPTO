--- 
// src/components/EventCard.astro
const { event } = Astro.props;
---
<div class="flex flex-col bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow duration-300 p-6">
  
  <p class="text-sm text-gray-500">{new Date(event.data.eventDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
  <h3 class="mt-2 text-xl font-bold text-primary">{event.data.title}</h3> 
  <p class="mt-2 text-gray-600 line-clamp-3 flex-grow">{event.data.description}</p>
  <div class="mt-4">
    <a href={event.data.externalUrl || `/events/${event.slug}`} 
       target={event.data.externalUrl ? "_blank" : "_self"} 
       class="font-bold text-primary">
      Learn More &rarr;
    </a>
  </div>
</div>