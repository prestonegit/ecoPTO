---
const { event } = Astro.props;
import { Image } from "astro:assets";
---
<a href={`/events/${event.slug}/`} class="block bg-bg-primary rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden h-full flex flex-col">
  {event.data.image && (
    <div class="relative h-48 w-full overflow-hidden">
      <Image
        src={event.data.image}
        alt={event.data.title}
        class="object-cover w-full h-full"
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6 flex-grow flex flex-col">
    <h3 class="text-2xl font-bold text-primary mb-2">{event.data.title}</h3>
    <p class="text-text-secondary text-sm mb-1">
      <i class="fas fa-calendar-alt mr-2"></i>{new Date(event.data.eventDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    <p class="text-text-secondary text-sm mb-4">
      <i class="fas fa-map-marker-alt mr-2"></i>{event.data.location}
    </p>
    <p class="text-text-secondary text-base mb-4 flex-grow">{event.data.description}</p>
    <span class="text-primary font-semibold hover:underline mt-auto">Read More &rarr;</span>
  </div>
</a>
