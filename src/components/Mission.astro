---
const { content } = Astro.props;

const earthConnectionIcon = content.earth_connection_icon || "/assets/icons/placeholder.svg";
const communityEngagementIcon = content.community_engagement_icon || "/assets/icons/placeholder.svg";
const youthWellbeingIcon = content.youth_wellbeing_icon || "/assets/icons/placeholder.svg";
---
<section id="mission" class="py-20 bg-bg-secondary">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-primary mb-4">{content.mission_title}</h2>
    <p class="text-lg text-text-secondary mb-12">
      {content.mission_subtitle}
    </p>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-bg-primary p-8 rounded-xl shadow-sm flex flex-col items-center">
        <div class="w-24 h-24 bg-secondary rounded-full flex items-center justify-center mb-6">
          <img src={earthConnectionIcon} alt="Earth Connection Icon" class="w-16 h-16" />
        </div>
        <h3 class="text-2xl font-bold text-primary">{content.mission_item_1_title}</h3>
        <p class="mt-4 text-text-secondary">
          {content.mission_item_1_text}
        </p>
      </div>
      <div class="bg-bg-primary p-8 rounded-xl shadow-sm flex flex-col items-center">
        <div class="w-24 h-24 bg-secondary rounded-full flex items-center justify-center mb-6">
          <img src={communityEngagementIcon} alt="Community Engagement Icon" class="w-16 h-16" />
        </div>
        <h3 class="text-2xl font-bold text-primary">{content.mission_item_2_title}</h3>
        <p class="mt-4 text-text-secondary">
          {content.mission_item_2_text}
        </p>
      </div>
      <div class="bg-bg-primary p-8 rounded-xl shadow-sm flex flex-col items-center">
        <div class="w-24 h-24 bg-secondary rounded-full flex items-center justify-center mb-6">
          <img src={youthWellbeingIcon} alt="Youth Wellbeing Icon" class="w-16 h-16" />
        </div>
        <h3 class="text-2xl font-bold text-primary">{content.mission_item_3_title}</h3>
        <p class="mt-4 text-text-secondary">
          {content.mission_item_3_text}
        </p>
      </div>
    </div>
  </div>
</section>