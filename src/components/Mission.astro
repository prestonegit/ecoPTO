---
const { content } = Astro.props;
---
<section id="mission" class="py-20 bg-bg-secondary">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-primary mb-4">{content.mission_title}</h2>
    <p class="text-lg text-text-secondary mb-12">
      {content.mission_subtitle}
    </p>
    <div class="grid md:grid-cols-3 gap-8">
        {content.mission_items.map((item) => (
          <div class="bg-bg-primary p-8 rounded-xl shadow-sm flex flex-col items-center">
            <div class="w-24 h-24 bg-secondary rounded-full flex items-center justify-center mb-6">
              <img src={item.icon} alt={item.title + " Icon"} class="w-16 h-16" />
            </div>
            <h3 class="text-2xl font-bold text-primary text-center">{item.title}</h3>
            <p class="mt-4 text-text-secondary">
              {item.text}
            </p>
          </div>
        ))}
    </div>
  </div>
</section>