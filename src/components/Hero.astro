---
const { content } = Astro.props;
---

<section id="home" class="bg-primary text-text-primary">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center text-center md:text-left" style="padding-top: 2rem !important; padding-bottom: 2rem !important;">
    <div class="md:order-1">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight text-secondary">
        {content.hero_title}
      </h1>
      <div class="my-8 flex justify-center md:justify-start md:hidden">
        <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-48 h-auto">
      </div>
      <p class="mt-6 text-lg text-bg-primary">
        {content.hero_subtitle}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center md:justify-start gap-4">
        <button id="join-us-hero-btn" class="get-involved-trigger btn-standard btn-secondary-color" data-target-tab="form-join">
          {content.hero_button_text}
        </button>
        <button id="staff-support-hero-btn" class="get-involved-trigger btn-standard !border-2 !border-bg-primary text-bg-primary hover:bg-bg-primary hover:text-primary transition-colors" data-target-tab="form-staff">
          Help Request Form
        </button>
      </div>
    </div>
    <div class="hidden md:flex md:order-2 items-center justify-center">
      <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-full h-auto">
    </div>
  </div>
</section>