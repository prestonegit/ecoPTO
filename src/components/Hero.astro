---
const { content } = Astro.props;
---

<section id="home" class="bg-primary text-text-primary">
  <div class="container mx-auto px-6 py-24 grid md:grid-cols-2 gap-12 items-center text-center md:text-left">
    <div class="md:order-1">
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold leading-tight text-secondary">
        {content.hero_title}
      </h1>
      <div class="my-8 flex justify-center md:justify-start">
        <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-48 h-auto">
      </div>
      <p class="mt-6 text-lg text-bg-primary">
        {content.hero_subtitle}
      </p>
      <div class="mt-8 flex justify-center md:justify-start">
        <button id="join-us-hero-btn" class="bg-secondary text-black font-bold px-10 py-4 rounded-full hover:bg-secondary transition-colors border-2 border-accent">
          {content.hero_button_text}
        </button>
      </div>
    </div>
    <div class="hidden md:flex md:order-2 items-center justify-center">
      <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-full h-auto">
    </div>
  </div>
</section>