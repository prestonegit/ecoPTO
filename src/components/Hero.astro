---
const { content } = Astro.props;
---

<section id="home" class="bg-primary text-text-primary">
  <div class="container mx-auto px-6 py-16 sm:py-20 md:py-24 grid md:grid-cols-2 gap-12 items-center text-center md:text-left">
    <div class="md:order-1">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight text-secondary">
        {content.hero_title}
      </h1>
      <div class="my-8 flex justify-center md:justify-start md:hidden">
        <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-48 h-auto">
      </div>
      <p class="mt-6 text-lg text-bg-primary">
        {content.hero_subtitle}
      </p>
      <div class="mt-8 flex justify-center md:justify-start">
        <button id="join-us-hero-btn" class="btn-standard btn-secondary-color">
          {content.hero_button_text}
        </button>
      </div>
    </div>
    <div class="hidden md:flex md:order-2 items-center justify-center">
      <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-full h-auto">
    </div>
  </div>
</section>