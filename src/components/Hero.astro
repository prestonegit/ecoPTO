---
// src/components/Hero.astro
---
<section id="home" class="bg-primary text-bg-primary">
  <div class="container mx-auto px-6 py-24 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="text-6xl md:text-7xl font-extrabold leading-tight">
        Building a <span class="text-secondary">Sustainable Future</span> Together
      </h1>
      <p class="mt-6 text-lg text-bg-primary">
        ecoPTO brings together families, educators, and community members in the Hopewell Valley School District to nurture youth wellbeing through deeper connections with community and earth.
      </p>
      <div class="mt-8 flex gap-4">
        <button id="join-us-hero-btn" class="bg-primary text-bg-primary font-bold px-8 py-3 rounded-full hover:bg-secondary transition-colors border-2 border-secondary">
          Join Our Community
        </button>
        <a href="/#events" class="border-2 border-secondary text-bg-primary font-bold px-8 py-3 rounded-full hover:bg-secondary hover:text-primary transition-colors">
          Upcoming Events
        </a>
      </div>
    </div>
    <div class="bg-black/20 p-8 rounded-xl">
      <h3 class="text-2xl font-bold text-secondary">Our Vision</h3>
      <p class="mt-4 text-bg-primary">
        A thriving community where every child grows up understanding their deep connection to the earth, equipped with the knowledge and passion to care for both their own wellbeing and the wellbeing of our planet.
      </p>
      <div class="mt-6 flex gap-8 text-center">
        <div>
          <p class="text-4xl font-bold text-secondary">0+</p>
          <p class="text-bg-primary">Community Members</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-secondary">2+</p>
          <p class="text-bg-primary">Annual Events</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const joinUsHeroBtn = document.getElementById('join-us-hero-btn');
    const signupModal = document.getElementById('signup-modal');

    if (joinUsHeroBtn && signupModal) {
      joinUsHeroBtn.addEventListener('click', () => {
        signupModal.classList.add('modal-open');
      });
    }
  });
</script>