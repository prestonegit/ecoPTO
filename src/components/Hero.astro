---
const { content } = Astro.props;
---

<section id="home" class="bg-primary text-text-primary relative overflow-hidden">
  <!-- Subtle bold noise overlay to reduce blandness -->
  <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
  
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-8 lg:gap-12 items-center text-center md:text-left py-6 md:py-8 relative z-10">
    <div class="md:order-1 animate-on-scroll flex flex-col items-center md:items-start">
      <h1 class="text-4xl sm:text-5xl md:text-5xl lg:text-[3.25rem] xl:text-[3.75rem] font-medium leading-[1.05] text-secondary tracking-tight drop-shadow-sm lg:whitespace-nowrap">
        {content.hero_title}
      </h1>
      {content.hero_subtitle && content.hero_subtitle.trim() !== '' && (
        <p class="mt-4 text-xl md:text-2xl text-bg-primary leading-relaxed opacity-95 max-w-3xl font-medium">
          {content.hero_subtitle}
        </p>
      )}
      <div class="mt-8 hidden md:flex justify-center md:justify-start w-full">
        <button class="get-involved-trigger btn-standard btn-secondary-color px-8 py-3.5 shadow-md font-semibold text-lg transition-transform hover:scale-105" data-target-tab="form-join">
          {content.hero_button_text}
        </button>
      </div>
    </div>
    <div class="md:order-2 mt-6 md:mt-0 flex flex-col justify-center items-center animate-on-scroll stagger-1">
      <button class="get-involved-trigger bg-transparent border-none p-0 m-0 cursor-pointer appearance-none outline-none focus:ring-4 focus:ring-secondary/30 rounded-full transition-transform hover:scale-[1.02]" data-target-tab="form-join" aria-label="Open sign up form">
        <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-56 md:w-72 lg:w-80 h-auto opacity-100 hover-sway drop-shadow-md">
      </button>
      <div class="mt-8 flex md:hidden justify-center w-full">
        <button class="get-involved-trigger btn-standard btn-secondary-color px-8 py-3.5 shadow-md font-semibold text-lg transition-transform hover:scale-105" data-target-tab="form-join">
          {content.hero_button_text}
        </button>
      </div>
    </div>
  </div>
</section>