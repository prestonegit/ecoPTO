---
const { content } = Astro.props;
---

<section id="home" class="bg-primary text-text-primary">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center text-center md:text-left" style="padding-top: 2rem !important; padding-bottom: 2rem !important;">
    <div class="md:order-1 animate-on-scroll">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-medium leading-[1.1] text-secondary">
        {content.hero_title}
      </h1>
      <div class="my-8 flex justify-center md:justify-start md:hidden">
        <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-40 h-auto opacity-90">
      </div>
      <p class="mt-6 text-xl text-bg-primary leading-relaxed opacity-95">
        {content.hero_subtitle}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center md:items-start md:justify-start gap-6">
        <button id="join-us-hero-btn" class="get-involved-trigger btn-standard btn-secondary-color text-lg px-10 py-4 shadow-lg" data-target-tab="form-join">
          {content.hero_button_text}
        </button>
        <button id="staff-support-hero-btn" class="get-involved-trigger text-bg-primary/80 hover:text-bg-primary underline underline-offset-4 transition-colors font-medium self-center mt-2 sm:mt-0" data-target-tab="form-staff">
          Help Request Form
        </button>
      </div>
    </div>
    <div class="hidden md:flex md:order-2 items-center justify-center animate-on-scroll stagger-2">
      <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-full max-w-md h-auto opacity-95">
    </div>
  </div>
</section>