---
const { content } = Astro.props;
---

<section id="home" class="bg-primary text-text-primary">
  <div class="container mx-auto px-6 flex flex-col items-center justify-center text-center py-12 md:py-20">
    <div class="animate-on-scroll flex flex-col items-center">
      <h1 class="text-4xl sm:text-5xl md:text-[3.25rem] lg:text-[4rem] xl:text-[4.5rem] font-medium leading-[1.1] text-secondary tracking-tight">
        {content.hero_title}
      </h1>
      <div class="my-10 flex justify-center">
        <img src="/logo-full.svg" alt="ecoPTO Full Logo" class="w-48 md:w-64 lg:w-72 h-auto opacity-95 hover-sway">
      </div>
      {content.hero_subtitle && content.hero_subtitle.trim() !== '' && (
        <p class="mt-6 text-xl text-bg-primary leading-relaxed opacity-95 max-w-3xl mx-auto">
          {content.hero_subtitle}
        </p>
      )}
    </div>
  </div>
</section>